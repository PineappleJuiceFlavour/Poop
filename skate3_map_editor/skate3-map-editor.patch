+// Extraction
+
+/// What an import found.
+#[derive(Clone, Debug, Default)]
+pub struct DiscReport {
+    pub disc: String,
+    pub format: String,
+    pub files: usize,
+    /// Asset paths of the models written, relative to the assets folder.
+    pub models: Vec<String>,
+    /// Extension -> count, for the files no model came out of.
+    pub other: BTreeMap<String, usize>,
+}
+
+/// Shared between the import thread and the editor UI.
+#[derive(Default)]
+pub struct DiscProgress {
+    pub status: String,
+    pub finished: Option<Result<DiscReport, String>>,
+}
+
+/// Starts importing `image` into `<assets_root>/imported/<disc name>/` on a background thread.
+pub fn spawn_import(image: PathBuf, assets_root: PathBuf) -> Arc<Mutex<DiscProgress>> {
+    let progress = Arc::new(Mutex::new(DiscProgress { status: "Reading disc...".into(), finished: None }));
+    let shared = progress.clone();
+    std::thread::spawn(move || {
+        let result = import(&image, &assets_root, &|status| {
+            if let Ok(mut p) = shared.lock() {
+                p.status = status;
+            }
+        });
+        if let Ok(mut p) = shared.lock() {
+            p.finished = Some(result);
+        }
+    });
+    progress
+}
+
+pub fn import(image_path: &Path, assets_root: &Path, report_status: &dyn Fn(String)) -> Result<DiscReport, String> {
+    let mut image = File::open(image_path).map_err(|e| format!("can't open {}: {e}", image_path.display()))?;
+    let disc = read_disc(&mut image)?;
+    let name = safe_name(&image_path.file_stem().unwrap_or_default().to_string_lossy());
+    let folder = format!("imported/{name}");
+    let out_dir = assets_root.join(&folder);
+    std::fs::create_dir_all(&out_dir).map_err(|e| e.to_string())?;
+    let mut report = DiscReport { disc: name.clone(), format: disc.format.into(), files: disc.files.len(), ..Default::default() };
+    let total: u64 = disc.files.iter().map(|f| f.size).sum::<u64>().max(1);
+    let mut done = 0u64;
+
+    for file in &disc.files {
+        done += file.size;
+        report_status(format!(
+            "Searching {name} ({:.0}%): {}  [{} models found]",
+            done as f64 * 100.0 / total as f64,
+            file.path,
+            report.models.len()
+        ));
+        let extension = file.path.rsplit_once('.').map(|(_, e)| e.to_ascii_lowercase()).unwrap_or_default();
+        let target = out_dir.join(safe_path(&file.path));
+        let asset = |path: &Path| path.strip_prefix(assets_root).unwrap_or(path).to_string_lossy().replace('\\', "/");
+        let found = match extension.as_str() {
+            "glb" => {
+                let bytes = read_file(&mut image, file)?;
+                is_glb(&bytes) && write(&target, &bytes).is_ok() && {
+                    report.models.push(asset(&target));
+                    true
+                }
+            }
+            "gltf" => {
+                let bytes = read_file(&mut image, file)?;
+                write(&target, &bytes)?;
+                // Its buffers and textures sit next to it.
+                let dir = file.path.rsplit_once('/').map(|(d, _)| format!("{d}/")).unwrap_or_default();
+                for sibling in disc.files.iter().filter(|f| {
+                    f.path.starts_with(&dir)
+                        && !f.path[dir.len()..].contains('/')
+                        && f.path.rsplit_once('.').is_some_and(|(_, e)| {
+                            matches!(e.to_ascii_lowercase().as_str(), "bin" | "png" | "jpg" | "jpeg" | "ktx2" | "webp")
+                        })
+                }) {
+                    let bytes = read_file(&mut image, sibling)?;
+                    let _ = write(&out_dir.join(safe_path(&sibling.path)), &bytes);
+                }
+                report.models.push(asset(&target));
+                true
+            }
+            "obj" => {
+                let bytes = read_file(&mut image, file)?;
+                match obj_to_glb(&String::from_utf8_lossy(&bytes)) {
+                    Some(glb) => {
+                        let target = target.with_extension("glb");
+                        write(&target, &glb)?;
+                        report.models.push(asset(&target));
+                        true
+                    }
+                    None => false,
+                }
+            }
+            _ => {
+                // Archives the game didn't compress can hold whole models.
+                let embedded = find_embedded_glbs(&mut image, file)?;
+                for (i, glb) in embedded.iter().enumerate() {
+                    let target = out_dir.join(format!("{}.{i}.glb", safe_path(&file.path).to_string_lossy()));
+                    write(&target, glb)?;
+                    report.models.push(asset(&target));
+                }
+                !embedded.is_empty()
+            }
+        };
+        if !found {
+            *report.other.entry(if extension.is_empty() { "(none)".into() } else { extension }).or_default() += 1;
+        }
+    }
+
+    let mut text = format!(
+        "{} ({}): {} files, {} models extracted.\n\nFiles in formats the editor can't use (the game's own formats):\n",
+        report.disc, report.format, report.files, report.models.len()
+    );
+    let mut other: Vec<_> = report.other.iter().collect();
+    other.sort_by(|a, b| b.1.cmp(a.1));
+    for (extension, count) in other {
+        text.push_str(&format!("  .{extension}: {count}\n"));
+    }
+    let _ = std::fs::write(out_dir.join("_disc_report.txt"), text);
+    Ok(report)
+}
+
+fn read_file(image: &mut File, file: &DiscFile) -> Result<Vec<u8>, String> {
+    if file.size > 2 << 30 {
+        return Err(format!("{} is too large to read", file.path));
+    }
+    read_at(image, file.offset, file.size as usize)
+}
+
+fn write(path: &Path, bytes: &[u8]) -> Result<(), String> {
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir).map_err(|e| e.to_string())?;
+    }
+    std::fs::write(path, bytes).map_err(|e| e.to_string())
+}
+
+fn safe_name(name: &str) -> String {
+    let clean: String = name.chars().map(|c| if c.is_ascii_alphanumeric() || c == '-' || c == '_' { c } else { '_' }).collect();
+    if clean.trim_matches('_').is_empty() { "disc".into() } else { clean }
+}
+
+/// A disc path as a relative path that can't escape the output folder.
+fn safe_path(path: &str) -> PathBuf {
+    path.split(['/', '\\'])
+        .filter(|part| !part.is_empty() && *part != "." && *part != "..")
+        .map(|part| part.chars().map(|c| if c.is_control() || r#":*?"<>|"#.contains(c) { '_' } else { c }).collect::<String>())
+        .collect()
+}
+
+fn is_glb(bytes: &[u8]) -> bool {
+    bytes.len() >= 20 && &bytes[0..4] == b"glTF" && u32le(bytes, 4) == 2 && &bytes[16..20] == b"JSON"
+}
+
+/// Scans a file for whole `.glb` models stored inside it.
+fn find_embedded_glbs(image: &mut File, file: &DiscFile) -> Result<Vec<Vec<u8>>, String> {
+    const CHUNK: u64 = 8 << 20;
+    let mut found = Vec::new();
+    let mut at = 0u64;
+    while at < file.size {
+        let len = CHUNK.min(file.size - at);
+        // Overlap chunks so a header split across two is still seen.
+        let read = (len + 20).min(file.size - at);
+        let chunk = read_at(image, file.offset + at, read as usize)?;
+        let mut i = 0;
+        while let Some(pos) = memfind(&chunk[i..], b"glTF") {
+            let start = i + pos;
+            i = start + 4;
+            if start as u64 >= len || start + 20 > chunk.len() || !is_glb(&chunk[start..]) {
+                continue;
+            }
+            let total = u32le(&chunk, start + 8) as u64;
+            if !(20..=(512 << 20)).contains(&total) || at + start as u64 + total > file.size {
+                continue;
+            }
+            let glb = read_at(image, file.offset + at + start as u64, total as usize)?;
+            if is_glb(&glb) {
+                found.push(glb);
+            }
+        }
+        at += len;
+    }
+    Ok(found)
+}
+
+fn memfind(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    haystack.windows(needle.len()).position(|w| w == needle)
+}
+
+/// Converts a Wavefront OBJ (positions, optional UVs and normals, any polygons) to a GLB.
+pub fn obj_to_glb(text: &str) -> Option<Vec<u8>> {
+    let (mut v, mut vt, mut vn) = (Vec::<[f32; 3]>::new(), Vec::<[f32; 2]>::new(), Vec::<[f32; 3]>::new());
+    let mut corners: Vec<[i64; 3]> = Vec::new();
+    let mut polygons: Vec<std::ops::Range<usize>> = Vec::new();
+    let number = |s: Option<&str>| s.and_then(|s| s.parse::<f32>().ok());
+    for line in text.lines() {
+        let mut parts = line.split_whitespace();
+        match parts.next() {
+            Some("v") => v.push([number(parts.next())?, number(parts.next())?, number(parts.next())?]),
+            Some("vt") => vt.push([number(parts.next())?, number(parts.next()).unwrap_or(0.)]),
+            Some("vn") => vn.push([number(parts.next())?, number(parts.next())?, number(parts.next())?]),
+            Some("f") => {
+                let start = corners.len();
+                for corner in parts {
+                    let mut ids = corner.split('/');
+                    let parse = |s: Option<&str>| s.filter(|s| !s.is_empty()).and_then(|s| s.parse::<i64>().ok()).unwrap_or(0);
+                    corners.push([parse(ids.next()), parse(ids.next()), parse(ids.next())]);
+                }
+                if corners.len() - start >= 3 {
+                    polygons.push(start..corners.len());
+                } else {
+                    corners.truncate(start);
+                }
+            }
+            _ => {}
+        }
+    }
+    if v.is_empty() || polygons.is_empty() {
+        return None;
+    }
+    // OBJ indices are 1-based; negative ones count back from the end.
+    let resolve = |i: i64, len: usize| -> Option<usize> {
+        match i {
+            0 => None,
+            i if i > 0 => Some(i as usize - 1).filter(|&i| i < len),
+            i => len.checked_sub((-i) as usize),
+        }
+    };
+    let has_uv = !vt.is_empty();
+    let mut unique: std::collections::HashMap<(usize, Option<usize>, Option<usize>), u32> = Default::default();
+    let (mut positions, mut normals, mut uvs, mut indices) = (Vec::new(), Vec::new(), Vec::new(), Vec::<u32>::new());
+    let mut missing_normals = false;
+    for polygon in polygons {
+        let ids: Option<Vec<u32>> = corners[polygon]
+            .iter()
+            .map(|c| {
+                let p = resolve(c[0], v.len())?;
+                let t = resolve(c[1], vt.len());
+                let n = resolve(c[2], vn.len());
+                missing_normals |= n.is_none();
+                Some(*unique.entry((p, t, n)).or_insert_with(|| {
+                    positions.push(v[p]);
+                    normals.push(n.map_or([0.; 3], |n| vn[n]));
+                    uvs.push(t.map_or([0.; 2], |t| [vt[t][0], 1. - vt[t][1]]));
+                    positions.len() as u32 - 1
+                }))
+            })
+            .collect();
+        let ids = ids?;
+        for k in 1..ids.len() - 1 {
+            indices.extend([ids[0], ids[k], ids[k + 1]]);
+        }
+    }
+    if missing_normals {
+        // Smooth normals from the faces.
+        let mut sums = vec![[0f32; 3]; positions.len()];
+        for t in indices.chunks_exact(3) {
+            let [a, b, c] = [t[0], t[1], t[2]].map(|i| positions[i as usize]);
+            let (e1, e2) = ([b[0] - a[0], b[1] - a[1], b[2] - a[2]], [c[0] - a[0], c[1] - a[1], c[2] - a[2]]);
+            let n = [e1[1] * e2[2] - e1[2] * e2[1], e1[2] * e2[0] - e1[0] * e2[2], e1[0] * e2[1] - e1[1] * e2[0]];
+            for &i in t {
+                for k in 0..3 {
+                    sums[i as usize][k] += n[k];
+                }
+            }
+        }
+        for (normal, sum) in normals.iter_mut().zip(sums) {
+            let len = (sum[0] * sum[0] + sum[1] * sum[1] + sum[2] * sum[2]).sqrt();
+            if *normal == [0.; 3] {
+                *normal = if len > 0. { sum.map(|s| s / len) } else { [0., 1., 0.] };
+            }
+        }
+    }
+    Some(write_glb(&positions, &normals, has_uv.then_some(uvs.as_slice()), &indices))
+}
+
+/// A single-mesh GLB.
+fn write_glb(positions: &[[f32; 3]], normals: &[[f32; 3]], uvs: Option<&[[f32; 2]]>, indices: &[u32]) -> Vec<u8> {
+    let mut bin = Vec::new();
+    let mut views = Vec::new();
+    let mut push = |bytes: Vec<u8>, target: u32| {
+        while bin.len() % 4 != 0 {
+            bin.push(0);
+        }
+        views.push(format!(r#"{{"buffer":0,"byteOffset":{},"byteLength":{},"target":{target}}}"#, bin.len(), bytes.len()));
+        bin.extend(bytes);
+    };
+    let floats = |values: &mut dyn Iterator<Item = f32>| values.flat_map(f32::to_le_bytes).collect::<Vec<u8>>();
+    push(floats(&mut positions.iter().flatten().copied()), 34962);
+    push(floats(&mut normals.iter().flatten().copied()), 34962);
+    if let Some(uvs) = uvs {
+        push(floats(&mut uvs.iter().flatten().copied()), 34962);
+    }
+    push(indices.iter().flat_map(|i| i.to_le_bytes()).collect(), 34963);
+    let (mut min, mut max) = ([f32::MAX; 3], [f32::MIN; 3]);
+    for p in positions {
+        for k in 0..3 {
+            min[k] = min[k].min(p[k]);
+            max[k] = max[k].max(p[k]);
+        }
+    }
+    let count = positions.len();
+    let mut accessors = vec![
+        format!(r#"{{"bufferView":0,"componentType":5126,"count":{count},"type":"VEC3","min":{min:?},"max":{max:?}}}"#),
+        format!(r#"{{"bufferView":1,"componentType":5126,"count":{count},"type":"VEC3"}}"#),
+    ];
+    let mut attributes = r#""POSITION":0,"NORMAL":1"#.to_string();
+    if uvs.is_some() {
+        accessors.push(format!(r#"{{"bufferView":2,"componentType":5126,"count":{count},"type":"VEC2"}}"#));
+        attributes.push_str(r#","TEXCOORD_0":2"#);
+    }
+    let index_view = views.len() - 1;
+    let index_accessor = accessors.len();
+    accessors.push(format!(r#"{{"bufferView":{index_view},"componentType":5125,"count":{},"type":"SCALAR"}}"#, indices.len()));
+    let json = format!(
+        r#"{{"asset":{{"version":"2.0","generator":"map editor disc import"}},"scene":0,"scenes":[{{"nodes":[0]}}],"nodes":[{{"mesh":0}}],"meshes":[{{"primitives":[{{"attributes":{{{attributes}}},"indices":{index_accessor},"material":0}}]}}],"materials":[{{"pbrMetallicRoughness":{{"baseColorFactor":[0.8,0.8,0.8,1],"metallicFactor":0,"roughnessFactor":0.8}}}}],"buffers":[{{"byteLength":{}}}],"bufferViews":[{}],"accessors":[{}]}}"#,
+        bin.len(),
+        views.join(","),
+        accessors.join(",")
+    );
+    let mut json = json.into_bytes();
+    while json.len() % 4 != 0 {
+        json.push(b' ');
+    }
+    while bin.len() % 4 != 0 {
+        bin.push(0);
+    }
+    let total = 12 + 8 + json.len() + 8 + bin.len();
+    let mut out = Vec::with_capacity(total);
+    out.extend(b"glTF");
+    out.extend(2u32.to_le_bytes());
+    out.extend((total as u32).to_le_bytes());
+    out.extend((json.len() as u32).to_le_bytes());
+    out.extend(b"JSON");
+    out.extend(json);
+    out.extend((bin.len() as u32).to_le_bytes());
+    out.extend(b"BIN\0");
+    out.extend(bin);
+    out
+}
+
+#[cfg(test)]
+mod tests {
