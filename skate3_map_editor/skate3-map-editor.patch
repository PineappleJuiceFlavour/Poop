+        // LBP3-era bone set (0x021803F9, compressed integers, branch fields).
+        let anim = std::fs::read(format!("{RESOURCES}template.anim")).unwrap();
+        let res = read_resource(&anim).unwrap();
+        assert_eq!((&res.magic, res.head), (b"ANM", 0x132));
+        assert_eq!(res.data.len(), 0x1174);
+        let bones = std::fs::read(format!("{RESOURCES}characters.boneset")).unwrap();
+        let res = read_resource(&bones).unwrap();
+        assert_eq!((&res.magic, res.version(), res.compression), (b"BST", 0x3F9, 7));
+        assert_eq!(res.data.len(), 0x8000 + 0x6231);
