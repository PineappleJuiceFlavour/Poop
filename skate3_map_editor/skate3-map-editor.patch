+//! The Skate 3 Rust Engine render path, with the editor in it: the game's 3D camera draws into
+//! an offscreen image at a lower internal resolution, and a 2D camera puts that image on screen.
+//!
+//!     cargo run -p skate-map-editor --example render_path -- <screenshot dir>
+//!
+//! Opens the editor the way the game does (the editor camera copies the game camera's target),
+//! places props, checks a cursor ray lands where the cursor is, and takes screenshots.
+
+use bevy::camera::RenderTarget;
+use bevy::image::ImageSampler;
+use bevy::prelude::*;
+use bevy::render::render_resource::TextureFormat;
+use bevy::render::view::screenshot::{Screenshot, save_to_disk};
+use bevy::window::PrimaryWindow;
+use skate_map_editor::*;
+
+fn main() {
+    App::new()
+        .add_plugins(DefaultPlugins.set(WindowPlugin {
+            primary_window: Some(Window { resolution: (1280, 720).into(), ..default() }),
+            ..default()
+        }))
+        .add_plugins(MapEditorPlugin::default())
+        .add_systems(Startup, setup)
+        .add_systems(PostStartup, copy_game_target)
+        .add_systems(Update, script)
+        .run();
+}
+
+#[derive(Component)]
+struct GameCam;
+
+fn setup(
+    mut commands: Commands,
+    mut images: ResMut<Assets<Image>>,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut materials: ResMut<Assets<StandardMaterial>>,
+) {
+    // Half the window's resolution, like a low internal-resolution setting.
+    let mut image = Image::new_target_texture(640, 360, TextureFormat::Rgba8UnormSrgb, None);
+    image.sampler = ImageSampler::linear();
+    let target = images.add(image);
+    commands.spawn((
+        GameCam,
+        Camera3d::default(),
+        Camera { order: -1, ..default() },
+        RenderTarget::Image(target.clone().into()),
+        Msaa::Off,
+        Transform::from_xyz(0.0, 6.0, 12.0).looking_at(Vec3::ZERO, Vec3::Y),
+    ));
+    let output = commands.spawn((Camera2d, Msaa::Off, IsDefaultUiCamera)).id();
+    commands.spawn((
+        Node { width: percent(100), height: percent(100), position_type: PositionType::Absolute, ..default() },
+        ImageNode::new(target),
+        UiTargetCamera(output),
+    ));
+    commands.spawn((
+        DirectionalLight { illuminance: 9000.0, ..default() },
+        Transform::from_xyz(20.0, 40.0, 10.0).looking_at(Vec3::ZERO, Vec3::Y),
+    ));
+    commands.spawn((
+        Mesh3d(meshes.add(Cuboid::new(60.0, 1.0, 60.0))),
+        MeshMaterial3d(materials.add(Color::srgb(0.32, 0.45, 0.3))),
+        Transform::from_xyz(0.0, -0.5, 0.0),
+    ));
+}
+
+/// What `map_editor::render_like_gameplay_camera` does in the game.
+fn copy_game_target(
+    mut commands: Commands,
+    game: Single<(&Camera, &RenderTarget, &Msaa), With<GameCam>>,
+    editor: Single<Entity, With<EditorCamera>>,
+) {
+    let (camera, target, msaa) = *game;
+    commands
+        .entity(*editor)
+        .insert((Camera { order: camera.order, is_active: false, ..default() }, target.clone(), *msaa));
+}
+
+fn check(ok: bool, what: &str, fails: &mut u32) {
+    println!("[{}] {what}", if ok { "PASS" } else { "FAIL" });
+    if !ok {
+        *fails += 1;
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn script(
+    mut frame: Local<u32>,
+    mut fails: Local<u32>,
+    mut commands: Commands,
+    mut next: ResMut<NextState<EditorMode>>,
+    mut actions: MessageWriter<EditorAction>,
+    cams: Query<(&Camera, Has<GameCam>, Has<EditorCamera>, Has<EditorUiCamera>, Has<Camera2d>)>,
+    editor_view: Single<(&Camera, &GlobalTransform), With<EditorCamera>>,
+    mut window: Single<&mut Window, With<PrimaryWindow>>,
+    props: Query<&Prop>,
+    state: Res<EditorState>,
+    mut exit: MessageWriter<AppExit>,
+) {
+    *frame += 1;
+    let dir = std::env::args().nth(1).unwrap_or_else(|| ".".into());
+    let fails = &mut *fails;
+    match *frame {
+        30 => next.set(EditorMode::Editing),
+        40 => {
+            for (camera, game, editor, ui, is_2d) in &cams {
+                if game {
+                    check(!camera.is_active, "game 3D camera off", fails);
+                } else if editor {
+                    check(camera.is_active, "editor view on, drawing into the game's image", fails);
+                } else if ui {
+                    check(camera.is_active, "editor UI camera on", fails);
+                } else if is_2d {
+                    check(camera.is_active, "game's screen output camera stays on", fails);
+                }
+            }
+            let (camera, _) = *editor_view;
+            check(
+                camera.logical_viewport_size() == Some(Vec2::new(640.0, 360.0)),
+                &format!("editor view renders at the internal resolution ({:?})", camera.logical_viewport_size()),
+                fails,
+            );
+            for (primitive, x) in [(Primitive::Ramp, -3.0), (Primitive::Stairs, 0.0), (Primitive::Cube, 3.0)] {
+                let mut data = PropData::new(PropSource::Primitive(primitive));
+                data.translation = [x, 0.5, 0.0];
+                actions.write(EditorAction::Spawn(data));
+            }
+        }
+        60 => {
+            check(props.iter().count() == 3, "props placed", fails);
+            // Put the mouse over the cube: where it is in the half-size image, doubled for the window.
+            let (camera, transform) = *editor_view;
+            let in_view = camera.world_to_viewport(transform, Vec3::new(3.0, 0.5, 0.0)).unwrap();
+            let size = window.size();
+            window.set_cursor_position(Some(in_view * size / Vec2::new(640.0, 360.0)));
+        }
+        66 => {
+            let cube = props.iter().position(|p| p.source == PropSource::Primitive(Primitive::Cube));
+            let hovered = state.hovered.and_then(|e| props.get(e).ok()).map(|p| p.name.clone());
+            check(
+                cube.is_some() && hovered.as_deref() == Some("Cube"),
+                &format!("mouse over the cube hovers the cube at 2x render scale (hovered {hovered:?}, cursor {:?})", window.cursor_position()),
+                fails,
+            );
+            commands.spawn(Screenshot::primary_window()).observe(save_to_disk(format!("{dir}/render_path_editor.png")));
+        }
+        80 => next.set(EditorMode::Playing),
+        90 => {
+            for (camera, game, editor, ui, _) in &cams {
+                if game {
+                    check(camera.is_active, "game camera back", fails);
+                } else if editor || ui {
+                    check(!camera.is_active, "editor cameras off", fails);
+                }
+            }
+            commands.spawn(Screenshot::primary_window()).observe(save_to_disk(format!("{dir}/render_path_game.png")));
+        }
+        110 => {
+            println!("RENDER PATH DONE: {} failure(s)", *fails);
+            exit.write(AppExit::Success);
+        }
+        _ => {}
+    }
+}
diff --git a/crates/skate-map-editor/src/camera.rs b/crates/skate-map-editor/src/camera.rs
new file mode 100644
index 0000000..77975cc
--- /dev/null
+++ b/crates/skate-map-editor/src/camera.rs
@@ -0,0 +1,294 @@
+//! Editor free camera, and handing control between it and the game's own camera.
+
+use bevy::input::mouse::{AccumulatedMouseMotion, AccumulatedMouseScroll, MouseScrollUnit};
+use bevy::camera::RenderTarget;
+use bevy::prelude::*;
+use bevy::window::{CursorGrabMode, CursorOptions, PrimaryWindow};
+use bevy_egui::EguiMultipassSchedule;
+
+use crate::editor::EditorState;
+use crate::{EditorMode, MapEditorSettings, MapEditorUiPass, StartupConfig, editor_open};
+
+/// The editor's free camera. It only renders while the editor is open.
+#[derive(Component, Default)]
+pub struct EditorCamera {
+    pub yaw: f32,
+    pub pitch: f32,
+}
+
+/// Draws the editor UI over the window. Kept apart from [`EditorCamera`] so the 3D view can
+/// render wherever the game's own camera does (an offscreen target scaled to the window, say).
+#[derive(Component, Default)]
+pub struct EditorUiCamera;
+
+/// What the game looked like before the editor opened, so it can be put back exactly.
+#[derive(Resource, Default)]
+struct Handoff {
+    game_cameras: Vec<Entity>,
+    cursor: Option<(bool, CursorGrabMode)>,
+    time_was_paused: bool,
+}
+
+pub(crate) struct EditorCameraPlugin;
+
+impl Plugin for EditorCameraPlugin {
+    fn build(&self, app: &mut App) {
+        app.init_resource::<Handoff>()
+            .add_systems(Startup, (spawn_editor_camera, start_in_editor))
+            .add_systems(Update, toggle_editor)
+            .add_systems(OnEnter(EditorMode::Editing), enter_editor)
+            .add_systems(OnExit(EditorMode::Editing), exit_editor)
+            .add_systems(Update, fly_camera.run_if(editor_open));
+    }
+}
+
+fn spawn_editor_camera(mut commands: Commands) {
+    commands.spawn((
+        Name::new("Map Editor Camera"),
+        EditorCamera::default(),
+        Camera3d::default(),
+        Camera {
+            // Only renders while the editor is open, in place of the game's 3D cameras.
+            order: 1000,
+            is_active: false,
+            ..default()
+        },
+        Transform::from_xyz(0.0, 8.0, 12.0).looking_at(Vec3::ZERO, Vec3::Y),
+    ));
+    commands.spawn((
+        Name::new("Map Editor UI Camera"),
+        EditorUiCamera,
+        Camera2d,
+        // Cameras drawing to the same window must agree on MSAA; set on open to match the game's.
+        Msaa::Off,
+        Camera {
+            order: 10_000,
+            is_active: false,
+            clear_color: ClearColorConfig::None,
+            ..default()
+        },
+        // The editor UI lives in its own egui context on this camera, so it never clashes
+        // with any egui UI the game already has.
+        EguiMultipassSchedule::new(MapEditorUiPass),
+    ));
+}
+
+fn start_in_editor(config: Res<StartupConfig>, mut next: ResMut<NextState<EditorMode>>) {
+    if config.start_in_editor {
+        next.set(EditorMode::Editing);
+    }
+}
+
+fn toggle_editor(
+    keys: Res<ButtonInput<KeyCode>>,
+    settings: Res<MapEditorSettings>,
+    state: Res<EditorState>,
+    mode: Res<State<EditorMode>>,
+    mut next: ResMut<NextState<EditorMode>>,
+) {
+    if !keys.just_pressed(settings.toggle_key) || state.wants_keyboard {
+        return;
+    }
+    next.set(match mode.get() {
+        EditorMode::Playing => EditorMode::Editing,
+        EditorMode::Editing => EditorMode::Playing,
+    });
+}
+
+#[allow(clippy::type_complexity)]
+fn enter_editor(
+    mut handoff: ResMut<Handoff>,
+    mut game_cams: Query<
+        (
+            Entity,
+            &mut Camera,
+            &GlobalTransform,
+            &Transform,
+            Option<&Projection>,
+            Has<Camera3d>,
+            (Option<&RenderTarget>, Option<&Msaa>),
+        ),
+        (Without<EditorCamera>, Without<EditorUiCamera>),
+    >,
+    editor_cam: Single<
+        (&mut Camera, &mut Transform, &mut Projection, &mut EditorCamera),
+        With<EditorCamera>,
+    >,
+    ui_cam: Single<(&mut Camera, &mut Msaa), (With<EditorUiCamera>, Without<EditorCamera>)>,
+    mut cursor: Query<&mut CursorOptions, With<PrimaryWindow>>,
+    mut time: ResMut<Time<Virtual>>,
+    settings: Res<MapEditorSettings>,
+) {
+    let (mut ui_camera, mut ui_msaa) = ui_cam.into_inner();
+    let (mut ed_camera, mut ed_transform, mut ed_projection, mut ed) = editor_cam.into_inner();
+
+    // Start the free camera exactly where the game's main 3D camera is.
+    let source = game_cams
+        .iter()
+        .filter(|(_, cam, _, _, _, is_3d, _)| cam.is_active && *is_3d)
+        .max_by_key(|(_, cam, ..)| cam.order)
+        .map(|(_, _, global, local, projection, ..)| {
+            let transform = if *global == GlobalTransform::IDENTITY {
+                *local
+            } else {
+                global.compute_transform()
+            };
+            (transform, projection.cloned())
+        });
+    if let Some((transform, projection)) = source {
+        ed_transform.translation = transform.translation;
+        ed_transform.rotation = transform.rotation;
+        ed_transform.scale = Vec3::ONE;
+        if let Some(projection) = projection {
+            *ed_projection = projection;
+        }
+    }
+    let (yaw, pitch, _) = ed_transform.rotation.to_euler(EulerRot::YXZ);
+    ed.yaw = yaw;
+    ed.pitch = pitch;
+
+    // Switch the game's 3D cameras off and remember which ones were on. 2D cameras stay:
+    // they may be what puts the game's (now the editor's) picture on the screen.
+    handoff.game_cameras.clear();
+    for (entity, mut cam, .., is_3d, _) in &mut game_cams {
+        if cam.is_active && is_3d {
+            cam.is_active = false;
+            handoff.game_cameras.push(entity);
+        }
+    }
+    ed_camera.is_active = true;
+    ui_camera.is_active = true;
+    // The UI camera shares the window with whatever game camera still draws there.
+    *ui_msaa = game_cams
+        .iter()
+        .filter(|(_, cam, .., (target, _))| {
+            cam.is_active && matches!(target, None | Some(RenderTarget::Window(_)))
+        })
+        .max_by_key(|(_, cam, ..)| cam.order)
+        .map(|(.., (_, msaa))| msaa.copied().unwrap_or_default())
+        .unwrap_or(Msaa::Off);
+
+    if let Ok(mut cursor) = cursor.single_mut() {
+        handoff.cursor = Some((cursor.visible, cursor.grab_mode));
+        cursor.visible = true;
+        cursor.grab_mode = CursorGrabMode::None;
+    }
+
+    handoff.time_was_paused = time.is_paused();
+    if settings.pause_game {
+        time.pause();
+    }
+}
+
+fn exit_editor(
+    mut handoff: ResMut<Handoff>,
+    mut game_cams: Query<&mut Camera, (Without<EditorCamera>, Without<EditorUiCamera>)>,
+    mut editor_cam: Single<&mut Camera, With<EditorCamera>>,
+    mut ui_cam: Single<&mut Camera, (With<EditorUiCamera>, Without<EditorCamera>)>,
+    mut cursor: Query<&mut CursorOptions, With<PrimaryWindow>>,
+    mut time: ResMut<Time<Virtual>>,
+    mut state: ResMut<EditorState>,
+) {
+    editor_cam.is_active = false;
+    ui_cam.is_active = false;
+    for entity in handoff.game_cameras.drain(..) {
+        if let Ok(mut cam) = game_cams.get_mut(entity) {
+            cam.is_active = true;
+        }
+    }
+    if let (Ok(mut cursor), Some((visible, grab))) = (cursor.single_mut(), handoff.cursor.take()) {
+        cursor.visible = visible;
+        cursor.grab_mode = grab;
+    }
+    if !handoff.time_was_paused {
+        time.unpause();
+    }
+    state.looking = false;
+}
+
+#[allow(clippy::too_many_arguments)]
+fn fly_camera(
+    keys: Res<ButtonInput<KeyCode>>,
+    buttons: Res<ButtonInput<MouseButton>>,
+    motion: Res<AccumulatedMouseMotion>,
+    scroll: Res<AccumulatedMouseScroll>,
+    time: Res<Time<Real>>,
+    mut settings: ResMut<MapEditorSettings>,
+    mut state: ResMut<EditorState>,
+    camera: Single<(&mut Transform, &mut EditorCamera)>,
+    mut cursor: Query<&mut CursorOptions, With<PrimaryWindow>>,
+) {
+    let (mut transform, mut cam) = camera.into_inner();
+    let dt = time.delta_secs();
+
+    // Hold right mouse to look around and fly (WASD + Q/E), like most 3D editors.
+    if buttons.just_pressed(MouseButton::Right) && !state.pointer_over_ui {
+        state.looking = true;
+    }
+    if !buttons.pressed(MouseButton::Right) {
+        state.looking = false;
+    }
+    if let Ok(mut cursor) = cursor.single_mut() {
+        let (visible, grab) = if state.looking {
+            (false, CursorGrabMode::Confined)
+        } else {
+            (true, CursorGrabMode::None)
+        };
+        if cursor.visible != visible {
+            cursor.visible = visible;
+        }
+        if cursor.grab_mode != grab {
+            cursor.grab_mode = grab;
+        }
+    }
+
+    let scroll_lines = match scroll.unit {
+        MouseScrollUnit::Line => scroll.delta.y,
+        MouseScrollUnit::Pixel => scroll.delta.y / 40.0,
+    };
+
+    if state.looking {
+        cam.yaw -= motion.delta.x * settings.look_sensitivity;
+        cam.pitch = (cam.pitch - motion.delta.y * settings.look_sensitivity).clamp(-1.54, 1.54);
+        transform.rotation = Quat::from_euler(EulerRot::YXZ, cam.yaw, cam.pitch, 0.0);
+
+        let mut dir = Vec3::ZERO;
+        if keys.pressed(KeyCode::KeyW) {
+            dir += *transform.forward();
+        }
+        if keys.pressed(KeyCode::KeyS) {
+            dir -= *transform.forward();
+        }
+        if keys.pressed(KeyCode::KeyD) {
+            dir += *transform.right();
+        }
+        if keys.pressed(KeyCode::KeyA) {
+            dir -= *transform.right();
+        }
+        if keys.pressed(KeyCode::KeyE) || keys.pressed(KeyCode::Space) {
+            dir += Vec3::Y;
+        }
+        if keys.pressed(KeyCode::KeyQ) || keys.pressed(KeyCode::ControlLeft) {
+            dir -= Vec3::Y;
+        }
+        let boost = if keys.pressed(KeyCode::ShiftLeft) { 4.0 } else { 1.0 };
+        transform.translation += dir.normalize_or_zero() * settings.camera_speed * boost * dt;
+
+        // Scroll while flying changes fly speed.
+        if scroll_lines != 0.0 {
+            settings.camera_speed = (settings.camera_speed * 1.15f32.powf(scroll_lines)).clamp(0.5, 500.0);
+        }
+    } else if !state.pointer_over_ui {
+        // Scroll to dolly, middle mouse to pan.
+        if scroll_lines != 0.0 {
+            let forward = *transform.forward();
+            transform.translation += forward * scroll_lines * settings.camera_speed * 0.15;
+        }
+        if buttons.pressed(MouseButton::Middle) {
+            let right = *transform.right();
+            let up = *transform.up();
+            let k = settings.camera_speed * 0.004;
+            transform.translation += (-right * motion.delta.x + up * motion.delta.y) * k;
+        }
+    }
+}
diff --git a/crates/skate-map-editor/src/convert.rs b/crates/skate-map-editor/src/convert.rs
new file mode 100644
index 0000000..fe13735
--- /dev/null
+++ b/crates/skate-map-editor/src/convert.rs
@@ -0,0 +1,746 @@
+//! Where extracted and converted files go, plus converters for formats many games share:
+//! models (`.glb`, `.gltf`, `.obj`), images (DDS, TGA, BMP, PS1 TIM, PS2 TIM2) and PS2 ADPCM
+//! sound (`.vag`).
+
+use crate::glb::Model;
+use crate::texture::{self, Rgba};
+use std::collections::{BTreeMap, HashSet};
+use std::path::{Path, PathBuf};
+
+/// What an import found.
+#[derive(Clone, Debug, Default)]
+pub struct DiscReport {
+    pub disc: String,
+    pub format: String,
+    /// Files on the disc (or in the dropped folder).
+    pub files: usize,
+    /// Files written to the extraction folder: disc files plus archive contents.
+    pub extracted: usize,
+    /// Archives opened.
+    pub archives: usize,
+    /// Asset paths of the models written, relative to the assets folder.
+    pub models: Vec<String>,
+    pub textures: usize,
+    pub sounds: usize,
+    /// Files converted to something else (models, images, sounds, videos).
+    pub converted: usize,
+    /// Extension -> count of files nothing was converted from.
+    pub other: BTreeMap<String, usize>,
+    pub notes: Vec<String>,
+    /// The extraction folder.
+    pub folder: PathBuf,
+}
+
+/// Writes extracted files and conversions, and keeps the report.
+pub struct Output {
+    /// `<game>/extracted/<name>`: every disc file, archive contents and converted images/sounds.
+    pub dir: PathBuf,
+    assets_root: PathBuf,
+    /// `imported/<name>`, relative to the assets folder: converted models.
+    models: String,
+    pub report: DiscReport,
+    status: Box<dyn Fn(String)>,
+    model_names: HashSet<String>,
+}
+
+impl Output {
+    pub fn new(dir: &Path, assets_root: &Path, name: &str, status: Box<dyn Fn(String)>) -> Self {
+        let _ = std::fs::create_dir_all(dir);
+        Output {
+            dir: dir.to_path_buf(),
+            assets_root: assets_root.to_path_buf(),
+            models: format!("imported/{name}"),
+            report: DiscReport { disc: name.into(), folder: dir.to_path_buf(), ..Default::default() },
+            status,
+            model_names: HashSet::new(),
+        }
+    }
+
+    pub fn status(&self, text: String) {
+        (self.status)(text);
+    }
+
+    /// Writes a file copied out of the disc or an archive.
+    pub fn write_extracted(&mut self, rel: &Path, bytes: &[u8]) -> bool {
+        let ok = write(&self.dir.join(rel), bytes).is_ok();
+        self.report.extracted += ok as usize;
+        ok
+    }
+
+    /// Writes a converted file (image, sound, listing) into the extraction folder.
+    pub fn write_converted(&mut self, rel: &Path, bytes: &[u8]) -> bool {
+        write(&self.dir.join(rel), bytes).is_ok()
+    }
+
+    /// Writes a converted image next to its source as `<source>.png`.
+    pub fn add_image(&mut self, source_rel: &str, image: &Rgba) -> bool {
+        let Some(png) = image.png() else { return false };
+        let ok = self.write_converted(&with_suffix(source_rel, ".png"), &png);
+        self.report.textures += ok as usize;
+        self.report.converted += ok as usize;
+        ok
+    }
+
+    /// Writes a converted sound next to its source as `<source>.wav`.
+    pub fn add_sound(&mut self, source_rel: &str, wav: &[u8]) -> bool {
+        let ok = self.write_converted(&with_suffix(source_rel, ".wav"), wav);
+        self.report.sounds += ok as usize;
+        self.report.converted += ok as usize;
+        ok
+    }
+
+    /// Writes a model to `imported/<name>/<rel>.glb` (numbered if the name is taken) and returns
+    /// its asset path.
+    pub fn add_model(&mut self, rel: &str, glb: &[u8]) -> Option<String> {
+        let base = safe_path(rel).to_string_lossy().replace('\\', "/");
+        let base = base.strip_suffix(".glb").unwrap_or(&base).to_string();
+        let mut asset = format!("{}/{base}.glb", self.models);
+        let mut n = 1;
+        while !self.model_names.insert(asset.to_ascii_lowercase()) {
+            n += 1;
+            asset = format!("{}/{base}.{n}.glb", self.models);
+        }
+        write(&self.assets_root.join(&asset), glb).ok()?;
+        self.report.models.push(asset.clone());
+        Some(asset)
+    }
+
+    /// Writes a `.gltf` (and the files it points to) as a model.
+    pub fn add_gltf(&mut self, rel: &str, gltf: &[u8], siblings: &[(String, Vec<u8>)]) -> Option<String> {
+        let base = safe_path(rel).to_string_lossy().replace('\\', "/");
+        let asset = format!("{}/{base}", self.models);
+        let folder = asset.rsplit_once('/').map(|(d, _)| d.to_string()).unwrap_or_default();
+        write(&self.assets_root.join(&asset), gltf).ok()?;
+        for (name, bytes) in siblings {
+            let _ = write(&self.assets_root.join(&folder).join(safe_path(name)), bytes);
+        }
+        self.model_names.insert(asset.to_ascii_lowercase());
+        self.report.models.push(asset.clone());
+        Some(asset)
+    }
+
+    pub fn add_note(&mut self, note: String) {
+        if !self.report.notes.contains(&note) {
+            self.report.notes.push(note);
+        }
+    }
+}
+
+/// `a/b.tm2` + `.png` = `a/b.tm2.png`, as a safe relative path.
+pub fn with_suffix(rel: &str, suffix: &str) -> PathBuf {
+    safe_path(&format!("{rel}{suffix}"))
+}
+
+pub fn write(path: &Path, bytes: &[u8]) -> std::io::Result<()> {
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    std::fs::write(path, bytes)
+}
+
+pub fn safe_name(name: &str) -> String {
+    let clean: String = name.chars().map(|c| if c.is_ascii_alphanumeric() || c == '-' || c == '_' { c } else { '_' }).collect();
+    if clean.trim_matches('_').is_empty() { "disc".into() } else { clean }
+}
+
+/// A path from a disc or archive as a relative path that can't escape the output folder.
+pub fn safe_path(path: &str) -> PathBuf {
+    path.split(['/', '\\'])
+        .filter(|part| !part.is_empty() && *part != "." && *part != "..")
+        .map(|part| part.chars().map(|c| if c.is_control() || r#":*?"<>|"#.contains(c) { '_' } else { c }).collect::<String>())
+        .collect()
+}
+
+pub fn extension(rel: &str) -> String {
+    let name = rel.rsplit(['/', '\\']).next().unwrap_or_default();
+    name.rsplit_once('.').map(|(_, e)| e.to_ascii_lowercase()).unwrap_or_default()
+}
+
+pub fn is_glb(bytes: &[u8]) -> bool {
+    bytes.len() >= 20 && &bytes[0..4] == b"glTF" && u32::from_le_bytes(bytes[4..8].try_into().unwrap()) == 2 && &bytes[16..20] == b"JSON"
+}
+
+/// Whole `.glb` models stored inside a file (uncompressed archives).
+pub fn find_embedded_glbs(bytes: &[u8]) -> Vec<&[u8]> {
+    let mut found = Vec::new();
+    let mut i = 0;
+    while let Some(pos) = memfind(&bytes[i..], b"glTF") {
+        let start = i + pos;
+        i = start + 4;
+        if !is_glb(&bytes[start..]) {
+            continue;
+        }
+        let total = u32::from_le_bytes(bytes[start + 8..start + 12].try_into().unwrap()) as usize;
+        if total >= 20 && start + total <= bytes.len() {
+            found.push(&bytes[start..start + total]);
+            i = start + total;
+        }
+    }
+    found
+}
+
+pub fn memfind(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    haystack.windows(needle.len()).position(|w| w == needle)
+}
+
+// ---------------------------------------------------------------------------------------------
+// Models
+
+/// Converts a Wavefront OBJ (positions, optional UVs and normals, any polygons) to a GLB.
+pub fn obj_to_glb(text: &str) -> Option<Vec<u8>> {
+    let (mut v, mut vt, mut vn) = (Vec::<[f32; 3]>::new(), Vec::<[f32; 2]>::new(), Vec::<[f32; 3]>::new());
+    let mut corners: Vec<[i64; 3]> = Vec::new();
+    let mut polygons: Vec<std::ops::Range<usize>> = Vec::new();
+    let number = |s: Option<&str>| s.and_then(|s| s.parse::<f32>().ok());
+    for line in text.lines() {
+        let mut parts = line.split_whitespace();
+        match parts.next() {
+            Some("v") => v.push([number(parts.next())?, number(parts.next())?, number(parts.next())?]),
+            Some("vt") => vt.push([number(parts.next())?, number(parts.next()).unwrap_or(0.)]),
+            Some("vn") => vn.push([number(parts.next())?, number(parts.next())?, number(parts.next())?]),
+            Some("f") => {
+                let start = corners.len();
+                for corner in parts {
+                    let mut ids = corner.split('/');
+                    let parse = |s: Option<&str>| s.filter(|s| !s.is_empty()).and_then(|s| s.parse::<i64>().ok()).unwrap_or(0);
+                    corners.push([parse(ids.next()), parse(ids.next()), parse(ids.next())]);
+                }
+                if corners.len() - start >= 3 {
+                    polygons.push(start..corners.len());
+                } else {
+                    corners.truncate(start);
+                }
+            }
+            _ => {}
+        }
+    }
+    if v.is_empty() || polygons.is_empty() {
+        return None;
+    }
+    // OBJ indices are 1-based; negative ones count back from the end.
+    let resolve = |i: i64, len: usize| -> Option<usize> {
+        match i {
+            0 => None,
+            i if i > 0 => Some(i as usize - 1).filter(|&i| i < len),
+            i => len.checked_sub((-i) as usize),
+        }
+    };
+    let mut unique: std::collections::HashMap<(usize, Option<usize>, Option<usize>), u32> = Default::default();
+    let mut model = Model::default();
+    let (mut indices, mut missing_normals) = (Vec::<u32>::new(), false);
+    for polygon in polygons {
+        let ids: Option<Vec<u32>> = corners[polygon]
+            .iter()
+            .map(|c| {
+                let p = resolve(c[0], v.len())?;
+                let t = resolve(c[1], vt.len());
+                let n = resolve(c[2], vn.len());
+                missing_normals |= n.is_none();
+                Some(*unique.entry((p, t, n)).or_insert_with(|| {
+                    model.positions.push(v[p]);
+                    model.normals.push(n.map_or([0.; 3], |n| vn[n]));
+                    model.uvs.push(t.map_or([0.; 2], |t| [vt[t][0], 1. - vt[t][1]]));
+                    model.positions.len() as u32 - 1
+                }))
+            })
+            .collect();
+        let ids = ids?;
+        for k in 1..ids.len() - 1 {
+            indices.extend([ids[0], ids[k], ids[k + 1]]);
+        }
+    }
+    if missing_normals {
+        let smooth = crate::glb::smooth_normals(&model.positions, indices.iter().copied());
+        for (normal, smooth) in model.normals.iter_mut().zip(smooth) {
+            if *normal == [0.; 3] {
+                *normal = smooth;
+            }
+        }
+    }
+    if vt.is_empty() {
+        model.uvs.clear();
+    }
+    model.primitives.push((indices, 0));
+    model.to_glb()
+}
+
+// ---------------------------------------------------------------------------------------------
+// Images
+
+/// Decodes a `.tga` (true colour, greyscale or colour-mapped, raw or run-length encoded).
+pub fn decode_tga(b: &[u8]) -> Option<Rgba> {
+    if b.len() < 18 {
+        return None;
+    }
+    let (id_len, map_type, kind) = (b[0] as usize, b[1], b[2]);
+    let (map_first, map_len, map_bits) = (u16::from_le_bytes([b[3], b[4]]) as usize, u16::from_le_bytes([b[5], b[6]]) as usize, b[7] as usize);
+    let (w, h, bits, descriptor) = (u16::from_le_bytes([b[12], b[13]]) as usize, u16::from_le_bytes([b[14], b[15]]) as usize, b[16] as usize, b[17]);
+    if !matches!(kind, 1 | 2 | 3 | 9 | 10 | 11) || w == 0 || h == 0 || w > 16384 || h > 16384 || !matches!(bits, 8 | 15 | 16 | 24 | 32) {
+        return None;
+    }
+    let color = |px: &[u8], bits: usize| -> [u8; 4] {
+        match bits {
+            8 => [px[0], px[0], px[0], 255],
+            15 | 16 => {
+                let v = u16::from_le_bytes([px[0], px[1]]);
+                let c = |s: u16| (((v >> s) & 31) * 255 / 31) as u8;
+                [c(10), c(5), c(0), 255]
+            }
+            24 => [px[2], px[1], px[0], 255],
+            _ => [px[2], px[1], px[0], px[3]],
+        }
+    };
+    let mut at = 18 + id_len;
+    let mut palette = Vec::new();
+    if map_type == 1 {
+        let entry = map_bits.div_ceil(8);
+        for i in 0..map_len {
+            palette.push(color(b.get(at + i * entry..at + (i + 1) * entry)?, map_bits));
+        }
+        at += map_len * entry;
+    }
+    let px_bytes = bits.div_ceil(8);
+    let pixel = |px: &[u8]| -> Option<[u8; 4]> {
+        if kind == 1 || kind == 9 {
+            let index = if px_bytes == 1 { px[0] as usize } else { u16::from_le_bytes([px[0], px[1]]) as usize };
+            palette.get(index.checked_sub(map_first)?).copied()
+        } else if kind == 3 || kind == 11 {
+            Some([px[0], px[0], px[0], if px_bytes > 1 { px[1] } else { 255 }])
+        } else {
+            Some(color(px, bits))
+        }
+    };
+    let mut pixels: Vec<[u8; 4]> = Vec::with_capacity(w * h);
+    if kind >= 9 {
+        while pixels.len() < w * h {
+            let header = *b.get(at)?;
+            at += 1;
+            let count = (header & 0x7F) as usize + 1;
+            if header & 0x80 != 0 {
+                let p = pixel(b.get(at..at + px_bytes)?)?;
+                at += px_bytes;
+                pixels.extend(std::iter::repeat_n(p, count));
+            } else {
+                for _ in 0..count {
+                    pixels.push(pixel(b.get(at..at + px_bytes)?)?);
+                    at += px_bytes;
+                }
+            }
+        }
+        pixels.truncate(w * h);
+    } else {
+        for chunk in b.get(at..at + w * h * px_bytes)?.chunks_exact(px_bytes) {
+            pixels.push(pixel(chunk)?);
+        }
+    }
+    let top_down = descriptor & 0x20 != 0;
+    let mut out = Vec::with_capacity(w * h * 4);
+    for y in 0..h {
+        let row = if top_down { y } else { h - 1 - y };
+        out.extend(pixels[row * w..row * w + w].iter().flatten());
+    }
+    Some(Rgba { width: w as u32, height: h as u32, pixels: out })
+}
+
+/// Decodes an uncompressed (or bit-field) `.bmp` of 1, 4, 8, 16, 24 or 32 bits.
+pub fn decode_bmp(b: &[u8]) -> Option<Rgba> {
+    if b.len() < 54 || &b[..2] != b"BM" {
+        return None;
+    }
+    let u32_at = |at: usize| Some(u32::from_le_bytes(b.get(at..at + 4)?.try_into().ok()?));
+    let data = u32_at(10)? as usize;
+    let header = u32_at(14)? as usize;
+    let w = u32_at(18)? as i32;
+    let h = u32_at(22)? as i32;
+    let bits = u16::from_le_bytes([b[28], b[29]]) as usize;
+    let compression = u32_at(30)?;
+    if w <= 0 || h == 0 || w > 16384 || h.unsigned_abs() > 16384 || !matches!(compression, 0 | 3) {
+        return None;
+    }
+    let (w, top_down, h) = (w as usize, h < 0, h.unsigned_abs() as usize);
+    let stride = (w * bits).div_ceil(32) * 4;
+    let palette_at = 14 + header;
+    let palette = |i: usize| -> Option<[u8; 4]> {
+        let p = b.get(palette_at + i * 4..palette_at + i * 4 + 3)?;
+        Some([p[2], p[1], p[0], 255])
+    };
+    let (masks, has_masks) = if compression == 3 { ([u32_at(54)?, u32_at(58)?, u32_at(62)?, if header >= 56 { u32_at(66)? } else { 0 }], true) } else { ([0; 4], false) };
+    let mut out = Vec::with_capacity(w * h * 4);
+    for y in 0..h {
+        let row_index = if top_down { y } else { h - 1 - y };
+        let row = b.get(data + row_index * stride..data + row_index * stride + stride)?;
+        for x in 0..w {
+            let px = match bits {
+                1 | 4 | 8 => {
+                    let bit = x * bits;
+                    let index = (row[bit / 8] >> (8 - bits - bit % 8)) & ((1u16 << bits) - 1) as u8;
+                    palette(index as usize)?
+                }
+                16 => {
+                    let v = u16::from_le_bytes([row[x * 2], row[x * 2 + 1]]) as u32;
+                    let m = if has_masks { masks } else { [0x7C00, 0x03E0, 0x001F, 0] };
+                    let c = |mask: u32| if mask == 0 { 255 } else { (((v & mask) >> mask.trailing_zeros()) * 255 / (mask >> mask.trailing_zeros())) as u8 };
+                    [c(m[0]), c(m[1]), c(m[2]), if m[3] == 0 { 255 } else { c(m[3]) }]
+                }
+                24 => [row[x * 3 + 2], row[x * 3 + 1], row[x * 3], 255],
+                32 => {
+                    let p = &row[x * 4..x * 4 + 4];
+                    // Plain 32-bit BMPs leave the fourth byte unused.
+                    [p[2], p[1], p[0], if has_masks && masks[3] != 0 { p[3] } else { 255 }]
+                }
+                _ => return None,
+            };
+            out.extend(px);
+        }
+    }
+    Some(Rgba { width: w as u32, height: h as u32, pixels: out })
+}
+
+/// PS2 32-bit colours use 0x80 as fully opaque.
+fn ps2_alpha(a: u8) -> u8 {
+    (a as u16 * 2).min(255) as u8
+}
+
+fn rgba5551(v: u16) -> [u8; 4] {
+    let c = |s: u16| (((v >> s) & 31) * 255 / 31) as u8;
+    [c(0), c(5), c(10), 255]
+}
+
+/// Decodes the first picture of a PS2 `.tm2` (TIM2) file.
+pub fn decode_tim2(b: &[u8]) -> Option<Rgba> {
+    if b.len() < 64 || &b[..4] != b"TIM2" {
+        return None;
+    }
+    let base = if b[5] == 1 { 128 } else { 16 }; // format 1 aligns pictures to 128 bytes
+    let p = b.get(base..base + 48)?;
+    let u32_at = |at: usize| u32::from_le_bytes(p[at..at + 4].try_into().unwrap()) as usize;
+    let u16_at = |at: usize| u16::from_le_bytes([p[at], p[at + 1]]) as usize;
+    let (clut_size, image_size, header_size, colors) = (u32_at(4), u32_at(8), u16_at(12), u16_at(14));
+    let (clut_type, image_type, w, h) = (p[18], p[19], u16_at(20), u16_at(22));
+    if w == 0 || h == 0 || w > 8192 || h > 8192 {
+        return None;
+    }
+    let image = b.get(base + header_size..base + header_size + image_size)?;
+    let clut = b.get(base + header_size + image_size..base + header_size + image_size + clut_size)?;
+    let mut palette: Vec<[u8; 4]> = match clut_type & 0x1F {
+        1 => clut.chunks_exact(2).map(|c| rgba5551(u16::from_le_bytes([c[0], c[1]]))).collect(),
+        2 => clut.chunks_exact(3).map(|c| [c[0], c[1], c[2], 255]).collect(),
+        3 => clut.chunks_exact(4).map(|c| [c[0], c[1], c[2], ps2_alpha(c[3])]).collect(),
+        _ => Vec::new(),
+    };
+    palette.truncate(colors.max(1));
+    // 256-colour palettes in the GS's CSM1 layout swap every second group of 8 entries.
+    if image_type == 5 && clut_type & 0x80 == 0 && palette.len() >= 256 {
+        for block in palette.chunks_mut(32) {
+            if block.len() == 32 {
+                for i in 8..16 {
+                    block.swap(i, i + 8);
+                }
+            }
+        }
+    }
+    let mut out = Vec::with_capacity(w * h * 4);
+    for i in 0..w * h {
+        let px = match image_type {
+            1 => rgba5551(u16::from_le_bytes([*image.get(i * 2)?, *image.get(i * 2 + 1)?])),
+            2 => {
+                let c = image.get(i * 3..i * 3 + 3)?;
+                [c[0], c[1], c[2], 255]
+            }
+            3 => {
+                let c = image.get(i * 4..i * 4 + 4)?;
+                [c[0], c[1], c[2], ps2_alpha(c[3])]
+            }
+            4 => *palette.get(((*image.get(i / 2)? >> ((i & 1) * 4)) & 15) as usize)?,
+            5 => *palette.get(*image.get(i)? as usize)?,
+            _ => return None,
+        };
+        out.extend(px);
+    }
+    Some(Rgba { width: w as u32, height: h as u32, pixels: out })
+}
+
+/// Decodes a PS1 `.tim` image.
+pub fn decode_tim(b: &[u8]) -> Option<Rgba> {
+    if b.len() < 20 || u32::from_le_bytes(b[..4].try_into().unwrap()) != 0x10 {
+        return None;
+    }
+    let flags = u32::from_le_bytes(b[4..8].try_into().unwrap());
+    let mode = flags & 7;
+    let u16_at = |at: usize| Some(u16::from_le_bytes([*b.get(at)?, *b.get(at + 1)?]) as usize);
+    let color = |v: u16| -> [u8; 4] {
+        let c = |s: u16| (((v >> s) & 31) * 255 / 31) as u8;
+        [c(0), c(5), c(10), if v == 0 { 0 } else { 255 }]
+    };
+    let mut at = 8;
+    let mut palette = Vec::new();
+    if flags & 8 != 0 {
+        let len = u32::from_le_bytes(b.get(at..at + 4)?.try_into().ok()?) as usize;
+        let (cw, ch) = (u16_at(at + 8)?, u16_at(at + 10)?);
+        for i in 0..(cw * ch).min(256) {
+            palette.push(color(u16_at(at + 12 + i * 2)? as u16));
+        }
+        at += len;
+    }
+    let (w16, h) = (u16_at(at + 8)?, u16_at(at + 10)?);
+    let data = at + 12;
+    let w = match mode {
+        0 => w16 * 4,
+        1 => w16 * 2,
+        2 => w16,
+        3 => w16 * 2 / 3,
+        _ => return None,
+    };
+    if w == 0 || h == 0 {
+        return None;
+    }
+    let mut out = Vec::with_capacity(w * h * 4);
+    for y in 0..h {
+        for x in 0..w {
+            let row = data + y * w16 * 2;
+            let px = match mode {
+                0 => *palette.get(((b.get(row + x / 2)? >> ((x & 1) * 4)) & 15) as usize)?,
+                1 => *palette.get(*b.get(row + x)? as usize)?,
+                2 => color(u16_at(row + x * 2)? as u16),
+                _ => {
+                    let c = b.get(row + x * 3..row + x * 3 + 3)?;
+                    [c[0], c[1], c[2], 255]
+                }
+            };
+            out.extend(px);
+        }
+    }
+    Some(Rgba { width: w as u32, height: h as u32, pixels: out })
+}
+
+// ---------------------------------------------------------------------------------------------
+// Sound
+
+/// Decodes PS-ADPCM ("VAG") data; `interleave` bytes per channel block. Returns interleaved
+/// 16-bit samples.
+pub fn decode_ps_adpcm(data: &[u8], channels: usize, interleave: usize) -> Vec<i16> {
+    const COEFS: [(i32, i32); 5] = [(0, 0), (60, 0), (115, -52), (98, -55), (122, -60)];
+    let channels = channels.max(1);
+    let interleave = if channels == 1 { data.len().max(16) } else { interleave.max(16) / 16 * 16 };
+    let mut per_channel: Vec<Vec<i16>> = vec![Vec::new(); channels];
+    let mut history = vec![(0i32, 0i32); channels];
+    let mut ended = vec![false; channels];
+    for (block_index, block) in data.chunks(interleave).enumerate() {
+        let ch = block_index % channels;
+        for frame in block.chunks_exact(16) {
+            if ended[ch] {
+                break;
+            }
+            let (shift, predictor, flags) = ((frame[0] & 15) as i32, ((frame[0] >> 4) as usize).min(4), frame[1]);
+            if flags == 7 {
+                ended[ch] = true;
+                break;
+            }
+            let (c1, c2) = COEFS[predictor];
+            let (mut s1, mut s2) = history[ch];
+            for k in 0..28 {
+                let nibble = (frame[2 + k / 2] >> ((k & 1) * 4)) & 15;
+                let value = ((nibble as i32) << 28 >> 28) << 12;
+                let sample = (value >> shift.min(12)) + (s1 * c1 + s2 * c2) / 64;
+                let sample = sample.clamp(-32768, 32767);
+                per_channel[ch].push(sample as i16);
+                s2 = s1;
+                s1 = sample;
+            }
+            history[ch] = (s1, s2);
+        }
+    }
+    let len = per_channel.iter().map(Vec::len).min().unwrap_or(0);
+    (0..len).flat_map(|i| per_channel.iter().map(move |c| c[i])).collect()
+}
+
+/// A 16-bit PCM `.wav` file.
+pub fn wav(samples: &[i16], channels: usize, rate: u32) -> Vec<u8> {
+    let channels = channels.max(1) as u16;
+    let data_len = (samples.len() * 2) as u32;
+    let mut out = Vec::with_capacity(44 + data_len as usize);
+    out.extend(b"RIFF");
+    out.extend((36 + data_len).to_le_bytes());
+    out.extend(b"WAVEfmt ");
+    out.extend(16u32.to_le_bytes());
+    out.extend(1u16.to_le_bytes());
+    out.extend(channels.to_le_bytes());
+    out.extend(rate.to_le_bytes());
+    out.extend((rate * channels as u32 * 2).to_le_bytes());
+    out.extend((channels * 2).to_le_bytes());
+    out.extend(16u16.to_le_bytes());
+    out.extend(b"data");
+    out.extend(data_len.to_le_bytes());
+    for s in samples {
+        out.extend(s.to_le_bytes());
+    }
+    out
+}
+
+/// A PS2 `.vag` sound (mono PS-ADPCM with a 48-byte big-endian header) as `.wav`.
+pub fn vag_to_wav(b: &[u8]) -> Option<Vec<u8>> {
+    if b.len() < 64 || &b[..4] != b"VAGp" {
+        return None;
+    }
+    let size = u32::from_be_bytes(b[12..16].try_into().unwrap()) as usize;
+    let rate = u32::from_be_bytes(b[16..20].try_into().unwrap());
+    let end = (48 + size).min(b.len());
+    let samples = decode_ps_adpcm(&b[48..end], 1, 0);
+    (!samples.is_empty() && (4000..=192_000).contains(&rate)).then(|| wav(&samples, 1, rate))
+}
+
+// ---------------------------------------------------------------------------------------------
+// One file
+
+/// Converts one file by its type (extension or contents). `siblings` reads other files of the
+/// same disc for formats that span files (a `.gltf` and its buffers).
+pub fn convert(rel: &str, bytes: &[u8], out: &mut Output, sibling: &dyn Fn(&str) -> Option<Vec<u8>>) -> bool {
+    let ext = extension(rel);
+    let stem = rel.rsplit_once('.').map_or(rel, |(s, _)| s);
+    let magic = |m: &[u8]| bytes.starts_with(m);
+    if ext == "glb" || is_glb(bytes) {
+        return is_glb(bytes) && out.add_model(stem, bytes).is_some();
+    }
+    if ext == "gltf" {
+        let dir = rel.rsplit_once('/').map(|(d, _)| format!("{d}/")).unwrap_or_default();
+        let json: serde_json::Value = match serde_json::from_slice(bytes) {
+            Ok(json) => json,
+            Err(_) => return false,
+        };
+        let mut siblings = Vec::new();
+        for key in ["buffers", "images"] {
+            for uri in json[key].as_array().into_iter().flatten().filter_map(|v| v["uri"].as_str()) {
+                if !uri.starts_with("data:")
+                    && let Some(data) = sibling(&format!("{dir}{uri}"))
+                {
+                    siblings.push((uri.to_string(), data));
+                }
+            }
+        }
+        return out.add_gltf(rel, bytes, &siblings).is_some();
+    }
+    if ext == "obj" {
+        return obj_to_glb(&String::from_utf8_lossy(bytes)).is_some_and(|glb| out.add_model(stem, &glb).is_some());
+    }
+    if crate::lbp::is_resource(bytes) {
+        // Handled with the rest of the game's resources (they reference each other).
+        return false;
+    }
+    if let Some(done) = crate::radical::convert(rel, bytes, out) {
+        return done;
+    }
+    let image = if magic(b"DDS ") {
+        texture::decode_dds(bytes)
+    } else if magic(b"TIM2") {
+        decode_tim2(bytes)
+    } else if magic(b"BM") && ext == "bmp" {
+        decode_bmp(bytes)
+    } else if ext == "tga" {
+        decode_tga(bytes)
+    } else if ext == "tim" || (magic(&[0x10, 0, 0, 0]) && matches!(ext.as_str(), "tim" | "")) {
+        decode_tim(bytes)
+    } else {
+        None
+    };
+    if let Some(image) = image {
+        return out.add_image(rel, &image);
+    }
+    if magic(b"VAGp") {
+        return vag_to_wav(bytes).is_some_and(|w| out.add_sound(rel, &w));
+    }
+    if ext == "pss" && magic(&[0, 0, 1, 0xBA]) {
+        // PS2 movies are MPEG-2 program streams: video players open them as .mpg.
+        let ok = out.write_converted(&with_suffix(rel, ".mpg"), bytes);
+        out.report.converted += ok as usize;
+        out.add_note("PS2 movies (.pss) were copied as .mpg; their video plays in VLC, the PS2 audio track may not.".into());
+        return ok;
+    }
+    let embedded = find_embedded_glbs(bytes);
+    for (i, glb) in embedded.iter().enumerate() {
+        out.add_model(&format!("{rel}.{i}"), glb);
+    }
+    !embedded.is_empty()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn decodes_tga_bmp_tim2_and_tim() {
+        // 2x1 TGA, 24-bit, bottom-up: blue then red.
+        let mut tga = vec![0u8; 18];
+        tga[2] = 2;
+        tga[12] = 2;
+        tga[14] = 1;
+        tga[16] = 24;
+        tga.extend([255, 0, 0, 0, 0, 255]);
+        assert_eq!(decode_tga(&tga).unwrap().pixels, vec![0, 0, 255, 255, 255, 0, 0, 255]);
+
+        // 1x1 24-bit BMP, green.
+        let mut bmp = vec![0u8; 54];
+        bmp[..2].copy_from_slice(b"BM");
+        bmp[10] = 54;
+        bmp[14] = 40;
+        bmp[18] = 1;
+        bmp[22] = 1;
+        bmp[28] = 24;
+        bmp.extend([0, 255, 0, 0]);
+        assert_eq!(decode_bmp(&bmp).unwrap().pixels, vec![0, 255, 0, 255]);
+
+        // TIM2: one 2x1 picture, 8-bit indexed, 2-colour 32-bit palette.
+        let mut tim2 = b"TIM2".to_vec();
+        tim2.extend([4, 0, 1, 0]);
+        tim2.extend([0u8; 8]);
+        let mut header = vec![0u8; 48];
+        header[4..8].copy_from_slice(&8u32.to_le_bytes()); // clut size
+        header[8..12].copy_from_slice(&2u32.to_le_bytes()); // image size
+        header[12..14].copy_from_slice(&48u16.to_le_bytes());
+        header[14..16].copy_from_slice(&2u16.to_le_bytes());
+        header[18] = 3;
+        header[19] = 5;
+        header[20..22].copy_from_slice(&2u16.to_le_bytes());
+        header[22..24].copy_from_slice(&1u16.to_le_bytes());
+        tim2.extend(header);
+        tim2.extend([1, 0]);
+        tim2.extend([10, 20, 30, 0x80, 40, 50, 60, 0x40]);
+        assert_eq!(decode_tim2(&tim2).unwrap().pixels, vec![40, 50, 60, 128, 10, 20, 30, 255]);
+
+        // PS1 TIM: 16-bit, 1x1 white.
+        let mut tim = vec![0x10, 0, 0, 0, 2, 0, 0, 0];
+        tim.extend(14u32.to_le_bytes());
+        tim.extend([0, 0, 0, 0, 1, 0, 1, 0]);
+        tim.extend(0x7FFFu16.to_le_bytes());
+        assert_eq!(decode_tim(&tim).unwrap().pixels, vec![255, 255, 255, 255]);
+    }
+
+    #[test]
+    fn decodes_ps_adpcm() {
+        // One frame: shift 12, filter 0, nibbles of 1 (=> 1 each), then an end frame.
+        let mut data = vec![0x0C, 0x00];
+        data.extend([0x11; 14]);
+        data.extend([0x00, 0x07]);
+        data.extend([0; 14]);
+        let samples = decode_ps_adpcm(&data, 1, 0);
+        assert_eq!(samples.len(), 28);
+        assert!(samples.iter().all(|&s| s == 1));
+        let mut vag = b"VAGp".to_vec();
+        vag.extend([0, 0, 0, 0x20, 0, 0, 0, 0]);
+        vag.extend((data.len() as u32).to_be_bytes());
+        vag.extend(22050u32.to_be_bytes());
+        vag.extend([0u8; 28]);
+        vag.extend(&data);
+        let wav = vag_to_wav(&vag).unwrap();
+        assert_eq!(&wav[..4], b"RIFF");
+        assert_eq!(u32::from_le_bytes(wav[24..28].try_into().unwrap()), 22050);
+    }
+
+    #[test]
+    fn finds_glbs_inside_other_files() {
+        let glb = obj_to_glb("v 0 0 0\nv 1 0 0\nv 0 1 0\nf 1 2 3\n").unwrap();
+        let mut archive = b"HEADER".to_vec();
+        archive.extend(&glb);
+        archive.extend(b"TRAILER");
+        assert_eq!(find_embedded_glbs(&archive), vec![glb.as_slice()]);
+    }
+}
