+// ---------------------------------------------------------------------------------------------
+// Sound
+
+/// Radical `.rsd`/`.rsp` sound (RSD2/3/4/6 with PS2 ADPCM or 16-bit PCM) as `.wav`.
+pub fn rsd_to_wav(b: &[u8]) -> Option<Vec<u8>> {
+    if b.len() < 0x20 || &b[..3] != b"RSD" {
+        return None;
+    }
+    let u = |at: usize| u32::from_le_bytes(b[at..at + 4].try_into().unwrap()) as usize;
+    let codec = &b[4..8];
+    let (channels, rate) = (u(8).clamp(1, 8), u(0x10) as u32);
+    let (interleave, start) = match b[3] {
+        b'2' | b'3' => (u(0x14), u(0x18)),
+        b'4' if matches!(codec, b"PCM " | b"PCMB") && b.get(0x80..0x84) != Some(b"----") => (0, 0x80),
+        b'4' | b'6' => (0, 0x800),
+        _ => return None,
+    };
+    let data = b.get(start..)?;
+    if !(4000..=192_000).contains(&rate) {
+        return None;
+    }
+    let samples: Vec<i16> = match codec {
+        b"VAG " => decode_ps_adpcm(data, channels, if interleave == 0 { 0x10 } else { interleave }),
+        b"PCM " => data.chunks_exact(2).map(|c| i16::from_le_bytes([c[0], c[1]])).collect(),
+        b"PCMB" => data.chunks_exact(2).map(|c| i16::from_be_bytes([c[0], c[1]])).collect(),
+        _ => return None,
+    };
+    (!samples.is_empty()).then(|| wav(&samples, channels, rate))
+}
+
+/// The audio tracks of a PS2 `.rmv` movie (`rmvps212`): each is an RSD sound.
+fn rmv_tracks(b: &[u8]) -> Vec<Vec<u8>> {
+    if !b.starts_with(b"rmvps212") || b.len() < 0x60 {
+        return Vec::new();
+    }
+    let u = |at: usize| b.get(at..at + 4).map(|c| u32::from_le_bytes(c.try_into().unwrap()) as usize);
+    let languages = u(0x18).unwrap_or(0).min(16);
+    (0..languages)
+        .filter_map(|i| {
+            let (offset, size) = (u(0x1C + i * 4)?, u(0x60 + i * 4)?);
+            rsd_to_wav(b.get(offset..offset.checked_add(size)?)?)
+        })
+        .collect()
+}
+
+/// Converts one standalone Radical file (sounds). `None` if it isn't one.
+pub fn convert(rel: &str, bytes: &[u8], out: &mut Output) -> Option<bool> {
+    if bytes.starts_with(b"RSD") {
+        return Some(rsd_to_wav(bytes).is_some_and(|w| out.add_sound(rel, &w)));
+    }
+    if bytes.starts_with(b"rmvps212") {
+        let tracks = rmv_tracks(bytes);
+        for (i, track) in tracks.iter().enumerate() {
+            out.add_sound(&format!("{rel}.audio{i}"), track);
+        }
+        out.add_note("Radical .rmv movies: their sound tracks were converted to .wav; the PS2 video (IPU) isn't converted.".into());
+        return Some(!tracks.is_empty());
+    }
+    None
+}
