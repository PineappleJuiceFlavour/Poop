+                    min: std::array::from_fn(|i| start[i].min(end[i])),
+                    max: std::array::from_fn(|i| start[i].max(end[i])),
+                });
+                #[cfg(test)]
+                source_for_primitive.push(self.assets.len());
+                #[cfg(test)]
+                source_rail_indices.push(owner - 1);
+            }
+        }
+        let mut assets = self.assets.clone();
+        if let Some(bounds) = segment_bounds.iter().copied().reduce(Bounds::union) {
+            let bounds = bounds.padded();
+            assets.push(std::sync::Arc::new(Asset {
+                #[cfg(test)]
+                source: SourceIdentity { stream_file: String::new(), asset_id: "map-editor".into(), section_index: 0, section_offset: 0 },
+                bounds,
+                indices: (first..primitives.len()).collect(),
+                tree: Octree::new(bounds, segment_bounds)?,
+            }));
+        }
