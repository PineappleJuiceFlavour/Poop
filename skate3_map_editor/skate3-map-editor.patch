+/// An object bigger than this is part of the ground, a wall or a building.
+const MAX_TRIANGLES: usize = 60_000;
+const MAX_EXTENT: f32 = 30.0;
+/// World meshes this far from the click are not searched.
+const SEARCH_RADIUS: f32 = 40.0;
+/// Vertices closer than this (1 mm) count as shared.
+const WELD: f32 = 1000.0;
+
+pub(crate) fn install(app: &mut App) {
+    app.init_resource::<PieceLibrary>()
+        .add_systems(Startup, load_saved)
+        .add_systems(Update, (copy_picked, dress_surfaces, apply_to_map_physics));
+}
+
+fn pieces_dir() -> PathBuf {
+    maps_dir().join("pieces")
+}
+
+#[derive(Serialize, Deserialize)]
+struct PieceFile {
+    version: u32,
+    name: String,
+    /// The map it was copied from: its materials only exist while that map is loaded.
+    map: String,
+    parts: Vec<PiecePart>,
+    /// The original's static collision, around the piece's origin.
+    #[serde(default)]
+    collision: Vec<PieceCollision>,
+    /// The original's grind lines, around the piece's origin.
+    #[serde(default)]
+    grinds: Vec<PieceGrind>,
+}
+
+/// Static collision triangles from one of the map's collision meshes.
+#[derive(Serialize, Deserialize, Clone)]
+struct PieceCollision {
+    rejection_flags: u32,
+    matching_group: i32,
+    geometry: u32,
+    pool: u8,
+    triangles: Vec<PieceTriangle>,
+}
+
+#[derive(Serialize, Deserialize, Clone)]
+struct PieceTriangle {
+    vertices: [[f32; 3]; 3],
+    /// The authored surface code: material, category and flags.
+    surface: u16,
+    tag: u32,
+    flags: u32,
+    cosines: [f32; 3],
+    fatness: f32,
+}
+
+/// One grind spline: its segments in order, and its authored GUIDs.
+#[derive(Serialize, Deserialize, Clone)]
+struct PieceGrind {
+    guids: [u64; 2],
+    segments: Vec<([f32; 3], [f32; 3])>,
+}
+
+/// The physics of every known piece, by prefab name.
+#[derive(Resource, Default)]
+struct PieceLibrary(HashMap<String, Arc<PiecePhysics>>);
+
+struct PiecePhysics {
+    collision: Vec<PieceCollision>,
+    grinds: Vec<PieceGrind>,
+}
+
+/// On a placed piece that brings the original's static collision: the mod-physics
+/// collider (`modding::editor_solids`) stays off it.
+#[derive(Component)]
+pub(crate) struct StaticPiece;
+
+/// The triangles of one world mesh (one material slab), around the piece's own origin.
+#[derive(Serialize, Deserialize, Default)]
+struct PiecePart {
+    /// The world mesh's name, which identifies its material: `world Opaque slab 3`.
+    material: String,
+    positions: Vec<[f32; 3]>,
+    normals: Vec<[f32; 3]>,
+    uv0: Vec<[f32; 2]>,
+    uv1: Vec<[f32; 2]>,
+    color: Vec<[f32; 4]>,
+    material_index: Vec<u32>,
+    tangents: Vec<[f32; 4]>,
+    indices: Vec<u32>,
+}
+
+impl PiecePart {
+    /// The mesh as the world draws it, and a copy for maps where its material doesn't exist.
+    fn meshes(&self) -> (Mesh, Mesh) {
+        let count = self.positions.len();
+        let mut mesh = Mesh::new(PrimitiveTopology::TriangleList, RenderAssetUsages::default())
+            .with_inserted_attribute(Mesh::ATTRIBUTE_POSITION, self.positions.clone());
+        if self.normals.len() == count {
+            mesh.insert_attribute(Mesh::ATTRIBUTE_NORMAL, self.normals.clone());
+        }
+        if self.uv0.len() == count {
+            mesh.insert_attribute(Mesh::ATTRIBUTE_UV_0, self.uv0.clone());
+        }
+        if self.uv1.len() == count {
+            mesh.insert_attribute(Mesh::ATTRIBUTE_UV_1, self.uv1.clone());
+        }
+        if self.tangents.len() == count {
+            mesh.insert_attribute(Mesh::ATTRIBUTE_TANGENT, self.tangents.clone());
+        }
+        mesh.insert_indices(Indices::U32(self.indices.clone()));
+        let plain = mesh.clone();
+        if self.color.len() == count {
+            mesh.insert_attribute(Mesh::ATTRIBUTE_COLOR, self.color.clone());
+        }
+        if self.material_index.len() == count {
+            mesh.insert_attribute(ATTRIBUTE_MATERIAL_INDEX, self.material_index.clone());
+        }
+        (mesh, plain)
+    }
+}
+
+/// One mesh of a placed piece, waiting for (or wearing) its material.
+#[derive(Component, Clone)]
+struct PieceSurface {
+    map: String,
+    material: String,
+    plain: Handle<Mesh>,
+}
+
+#[derive(Clone)]
+struct RegisteredPart {
+    mesh: Handle<Mesh>,
+    surface: PieceSurface,
+}
+
+fn register(piece: &PieceFile, meshes: &mut Assets<Mesh>, registry: &mut PrefabRegistry, library: &mut PieceLibrary) {
+    let has_collision = piece.collision.iter().any(|c| !c.triangles.is_empty());
+    library.0.insert(
+        piece.name.clone(),
+        Arc::new(PiecePhysics { collision: piece.collision.clone(), grinds: piece.grinds.clone() }),
+    );
+    let parts: Vec<RegisteredPart> = piece
+        .parts
+        .iter()
+        .map(|part| {
+            let (mesh, plain) = part.meshes();
+            RegisteredPart {
+                mesh: meshes.add(mesh),
+                surface: PieceSurface { map: piece.map.clone(), material: part.material.clone(), plain: meshes.add(plain) },
+            }
+        })
+        .collect();
+    registry.register(piece.name.clone(), move |entity, _| {
+        if has_collision {
+            entity.insert(StaticPiece);
+        }
+        entity.with_children(|children| {
+            for part in &parts {
+                children.spawn((Mesh3d(part.mesh.clone()), part.surface.clone(), Transform::default()));
+            }
+        });
+    });
+}
+
+fn load_saved(mut meshes: ResMut<Assets<Mesh>>, mut registry: ResMut<PrefabRegistry>, mut library: ResMut<PieceLibrary>) {
+    let Ok(files) = std::fs::read_dir(pieces_dir()) else { return };
+    for path in files.flatten().map(|f| f.path()) {
+        if !path.to_string_lossy().ends_with(".piece.json") {
+            continue;
+        }
+        match std::fs::read(&path).map_err(|e| e.to_string()).and_then(|bytes| {
+            serde_json::from_slice::<PieceFile>(&bytes).map_err(|e| e.to_string())
+        }) {
+            Ok(piece) => register(&piece, &mut meshes, &mut registry, &mut library),
+            Err(error) => warn!("map editor: skipping {}: {error}", path.display()),
+        }
+    }
+}
+
+/// Gives placed pieces their world material once the map's world exists, or a
+/// plain one on another map.
+fn dress_surfaces(
+    mut commands: Commands,
+    surfaces: Query<(Entity, &PieceSurface), (Without<MeshMaterial3d<WorldMaterial>>, Without<MeshMaterial3d<StandardMaterial>>)>,
+    world: Query<(&Name, &MeshMaterial3d<WorldMaterial>), Without<PieceSurface>>,
+    map: Res<crate::map_transition::CurrentMap>,
+    mut plain: Local<Option<Handle<StandardMaterial>>>,
+    mut materials: ResMut<Assets<StandardMaterial>>,
+    mut waited: Local<u32>,
+) {
+    if surfaces.is_empty() {
+        *waited = 0;
+        return;
+    }
+    let world: HashMap<&str, &Handle<WorldMaterial>> = world.iter().map(|(name, m)| (name.as_str(), &m.0)).collect();
+    // Placed before the world finished spawning: give it a few seconds.
+    *waited += 1;
+    let world_ready = !world.is_empty() || *waited > 600;
+    let plain = plain
+        .get_or_insert_with(|| materials.add(StandardMaterial { base_color: Color::srgb(0.62, 0.6, 0.57), perceptual_roughness: 0.9, ..default() }))
+        .clone();
+    for (entity, surface) in &surfaces {
+        if surface.map == map.name
+            && let Some(material) = world.get(surface.material.as_str())
+        {
+            commands.entity(entity).insert(MeshMaterial3d((*material).clone()));
+        } else if surface.map != map.name || world_ready {
+            commands.entity(entity).insert((Mesh3d(surface.plain.clone()), MeshMaterial3d(plain.clone())));
+        }
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn copy_picked(
+    mut picks: MessageReader<UnresolvedPick>,
+    mut actions: MessageWriter<EditorAction>,
+    world: Query<(Entity, &Name, &Mesh3d, &GlobalTransform, Option<&Aabb>), (With<MeshMaterial3d<WorldMaterial>>, Without<PieceSurface>)>,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut registry: ResMut<PrefabRegistry>,
+    mut library: ResMut<PieceLibrary>,
+    map: Res<crate::map_transition::CurrentMap>,
+    physics: Res<crate::physics::GamePhysics>,
+) {
+    for pick in picks.read() {
+        if !world.contains(pick.entity) {
+            actions.write(EditorAction::SetStatus(
+                "That object is drawn by the game itself, not part of the map, so it can't be copied".into(),
+            ));
+            continue;
+        }
+        let sources: Vec<Source> = world
+            .iter()
+            .filter(|(.., global, aabb)| near(pick.point, global, *aabb))
+            .filter_map(|(entity, name, mesh, global, _)| {
+                Source::new(entity, name.as_str(), meshes.get(&mesh.0)?, global)
+            })
+            .collect();
+        let (parts, origin, bounds) = match extract(&sources, pick.entity, pick.point) {
+            Ok(found) => found,
+            Err(error) => {
+                actions.write(EditorAction::SetStatus(error));
+                continue;
+            }
+        };
+        let collision = capture_collision(physics.world(), origin, bounds);
+        let grinds = capture_grinds(physics.grind_provider(), origin, bounds);
+        let number = next_number(&map.name);
+        let piece = PieceFile {
+            version: 2,
+            name: format!("{} piece {number}", map.name),
+            map: map.name.clone(),
+            parts,
+            collision,
+            grinds,
+        };
+        let path = pieces_dir().join(format!("{}_{number}.piece.json", crate::map_editor::layout_name(&map.name)));
+        let saved = std::fs::create_dir_all(pieces_dir())
+            .and_then(|_| std::fs::write(&path, serde_json::to_vec(&piece).unwrap_or_default()));
+        if let Err(error) = saved {
+            warn!("map editor: could not save {}: {error}", path.display());
+        }
+        register(&piece, &mut meshes, &mut registry, &mut library);
+        let triangles: usize = piece.parts.iter().map(|p| p.indices.len() / 3).sum();
+        let grind_note = match piece.grinds.len() {
+            0 => "no grind lines".to_string(),
+            1 => "1 grind line".to_string(),
+            n => format!("{n} grind lines"),
+        };
+        let mut data = PropData::new(PropSource::Prefab(piece.name.clone()));
+        data.name = piece.name.clone();
+        actions.write(EditorAction::AddPicked(LibraryEntry {
+            group: LibraryGroup::Picked,
+            label: piece.name.clone(),
+            hint: format!("Copied from {} ({triangles} triangles, {grind_note})", map.name),
+            data,
+        }));
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// The original's physics
+
+fn v3(v: Vector3) -> Vec3 {
+    Vec3::new(v.x, v.y, v.z)
+}
+
+fn pool_code(pool: query_metadata::QueryPool) -> u8 {
+    match pool {
+        query_metadata::QueryPool::Ground => 0,
+        query_metadata::QueryPool::Island => 1,
+        query_metadata::QueryPool::Conditional => 2,
+    }
+}
+
+fn pool_from(code: u8) -> query_metadata::QueryPool {
+    match code {
+        1 => query_metadata::QueryPool::Island,
+        2 => query_metadata::QueryPool::Conditional,
+        _ => query_metadata::QueryPool::Ground,
+    }
+}
+
+/// The map's static collision triangles that belong to the piece: inside its bounds, and not
+/// the ground it stands on.
+fn capture_collision(world: &BoardWorld, origin: Vec3, bounds: Bounds) -> Vec<PieceCollision> {
+    let Ok(metadata) = world.query_metadata() else { return Vec::new() };
+    let triangles = world.triangles();
+    let outer = bounds.grown(0.08);
+    let floor = bounds.min.y + 0.02;
+    let identity = skate_core::physics::drive_frames::RetailAffineTransform::IDENTITY;
+    let mut out = Vec::new();
+    for mesh in &metadata.meshes {
+        // Static map meshes are in world space; anything else isn't a fixed part of the map.
+        if mesh.local_to_world != identity {
+            continue;
+        }
+        let mesh_bounds = Bounds { min: v3(mesh.local_bounds.min), max: v3(mesh.local_bounds.max) };
+        if !mesh_bounds.overlaps(&outer) {
+            continue;
+        }
+        let mut copied = Vec::new();
+        for i in mesh.triangle_range.clone() {
+            let triangle = &triangles[i];
+            let vertices = triangle.triangle.vertices.map(v3);
+            if !vertices.iter().all(|v| outer.contains(*v)) || vertices.iter().all(|v| v.y <= floor) {
+                continue;
+            }
+            copied.push(PieceTriangle {
+                vertices: vertices.map(|v| (v - origin).to_array()),
+                surface: metadata.packed_surfaces[i],
+                tag: triangle.tag,
+                flags: triangle.triangle.feature.flags,
+                cosines: triangle.triangle.feature.edge_cosines,
+                fatness: triangle.triangle.fatness,
+            });
+        }
+        if !copied.is_empty() {
+            out.push(PieceCollision {
+                rejection_flags: mesh.rejection_flags,
+                matching_group: mesh.matching_group,
+                geometry: mesh.geometry,
+                pool: pool_code(mesh.pool),
+                triangles: copied,
+            });
+        }
+    }
+    out
+}
+
+/// The map's grind lines that lie on the piece.
+fn capture_grinds(provider: &crate::grind_world::StaticProvider, origin: Vec3, bounds: Bounds) -> Vec<PieceGrind> {
+    let outer = bounds.grown(0.25);
+    let mut splines: BTreeMap<u64, PieceGrind> = BTreeMap::new();
+    for (i, primitive) in provider.primitives().iter().enumerate() {
+        let start = Vec3::new(primitive.start[0], primitive.start[1], primitive.start[2]);
+        let end = Vec3::new(primitive.end[0], primitive.end[1], primitive.end[2]);
+        if !outer.contains(start) || !outer.contains(end) {
+            continue;
+        }
+        let Some(metadata) = provider.metadata(i) else { continue };
+        splines
+            .entry(primitive.owner)
+            .or_insert_with(|| PieceGrind { guids: metadata.spline_guids, segments: Vec::new() })
+            .segments
+            .push(((start - origin).to_array(), (end - origin).to_array()));
+    }
+    splines.into_values().collect()
+}
+
+/// The editor's grindable Rail and Ledge, built like the engine's test-course rails: closed
+/// boxes with convex edges (surface code 0) and a grind line along each grindable edge.
+fn built_in_physics(primitive: Primitive) -> PiecePhysics {
+    use skate_core::physics::collision::TriangleFeature;
+    let mut triangles = Vec::new();
+    for (center, size) in primitive.boxes() {
+        let (min, max) = (center - size / 2., center + size / 2.);
+        let top = [Vec3::new(min.x, max.y, min.z), Vec3::new(max.x, max.y, min.z), Vec3::new(max.x, max.y, max.z), Vec3::new(min.x, max.y, max.z)];
+        let mut quads = vec![top];
+        for i in 0..4 {
+            let (a, b) = (top[i], top[(i + 1) % 4]);
+            quads.push([b, a, Vec3::new(a.x, min.y, a.z), Vec3::new(b.x, min.y, b.z)]);
+        }
+        quads.push([
+            Vec3::new(min.x, min.y, max.z),
+            Vec3::new(max.x, min.y, max.z),
+            Vec3::new(max.x, min.y, min.z),
+            Vec3::new(min.x, min.y, min.z),
+        ]);
+        for quad in quads {
+            for (half, indices) in [[0, 2, 1], [0, 3, 2]].into_iter().enumerate() {
+                let convex = if half == 0 { 0x60 } else { 0xc0 };
+                triangles.push(PieceTriangle {
+                    vertices: indices.map(|i| quad[i].to_array()),
+                    surface: 0,
+                    tag: 0,
+                    flags: TriangleFeature::ONE_SIDED | convex,
+                    cosines: [1.; 3],
+                    fatness: 0.,
+                });
+            }
+        }
+    }
+    let label = primitive.label();
+    let grinds = primitive
+        .grind_lines()
+        .into_iter()
+        .enumerate()
+        .map(|(i, (a, b))| {
+            // Authored rails' GUID scheme (grind_world::spline::build_rails): a name hash and
+            // the authored type signature.
+            let mut id = 1469598103934665603u64;
+            for byte in format!("map editor {label} {i}").bytes() {
+                id = (id ^ byte as u64).wrapping_mul(1099511628211);
+            }
+            PieceGrind { guids: [id, 0x2c70_1707_0007_004a], segments: vec![(a.to_array(), b.to_array())] }
+        })
+        .collect();
+    PiecePhysics {
+        collision: vec![PieceCollision { rejection_flags: 0, matching_group: -1, geometry: 0, pool: 0, triangles }],
+        grinds,
+    }
+}
+
+/// The map's own static world and grind lines, before any copies were added.
+struct MapPhysics {
+    generation: u64,
+    triangles: Vec<WorldTriangle>,
+    metadata: Option<query_metadata::QueryMetadata>,
+    grinds: Arc<crate::grind_world::StaticProvider>,
+    applied: u64,
+}
+
+/// While playing, adds every placed piece's collision and grind lines to the map's own.
+/// Rebuilt when the placed pieces change (on leaving the editor, or when a layout loads).
+#[allow(clippy::type_complexity)]
+fn apply_to_map_physics(
+    mode: Res<State<EditorMode>>,
+    map: Res<crate::map_transition::CurrentMap>,
+    mut physics: ResMut<crate::physics::GamePhysics>,
+    mut skater: ResMut<crate::physics::SkaterRuntime>,
+    library: Res<PieceLibrary>,
+    pieces: Query<(Entity, &Prop, &GlobalTransform), Without<Ghost>>,
+    mut base: Local<Option<MapPhysics>>,
+    mut built_in: Local<HashMap<Primitive, Arc<PiecePhysics>>>,
+) {
+    if *mode.get() != EditorMode::Playing {
+        return;
+    }
+    // A new map brings new physics: that is the base from now on.
+    if base.as_ref().is_none_or(|b| b.generation != map.generation) {
+        let world = physics.world();
+        *base = Some(MapPhysics {
+            generation: map.generation,
+            triangles: world.triangles().to_vec(),
+            metadata: world.query_metadata().ok().cloned(),
+            grinds: physics.grind_provider().clone(),
+            applied: 0,
+        });
+    }
+    let base = base.as_mut().unwrap();
+
+    let mut placed: Vec<(Entity, Arc<PiecePhysics>, Affine3A)> = pieces
+        .iter()
+        .filter(|(_, prop, _)| prop.collision != CollisionKind::None)
+        .filter_map(|(entity, prop, global)| match &prop.source {
+            PropSource::Prefab(name) => Some((entity, library.0.get(name)?.clone(), global.affine())),
+            PropSource::Primitive(primitive) if !primitive.grind_lines().is_empty() => {
+                let physics = built_in.entry(*primitive).or_insert_with(|| Arc::new(built_in_physics(*primitive)));
+                Some((entity, physics.clone(), global.affine()))
+            }
+            _ => None,
+        })
+        .collect();
+    placed.sort_by_key(|(entity, ..)| *entity);
+    let fingerprint = {
+        use std::hash::{Hash, Hasher};
+        let mut hasher = std::collections::hash_map::DefaultHasher::new();
+        for (entity, piece, affine) in &placed {
+            entity.hash(&mut hasher);
+            Arc::as_ptr(piece).hash(&mut hasher);
+            for value in affine.to_cols_array() {
+                ((value * 10_000.).round() as i64).hash(&mut hasher);
+            }
+        }
+        if placed.is_empty() { 0 } else { hasher.finish() | 1 }
+    };
+    if fingerprint == base.applied {
+        return;
+    }
+    base.applied = fingerprint;
+
+    let (world, triangles) = overlay_world(base, &placed);
+    let splines: Vec<(Vec<([f32; 3], [f32; 3])>, [u64; 2])> = placed
+        .iter()
+        .flat_map(|(_, piece, affine)| {
+            piece.grinds.iter().map(move |grind| {
+                let segments = grind
+                    .segments
+                    .iter()
+                    .map(|(a, b)| {
+                        (affine.transform_point3(Vec3::from_array(*a)).to_array(), affine.transform_point3(Vec3::from_array(*b)).to_array())
+                    })
+                    .collect();
+                (segments, grind.guids)
+            })
+        })
+        .collect();
+    let grinds = match base.grinds.extended(&splines) {
+        Ok(provider) => Arc::new(provider),
+        Err(error) => {
+            warn!("map editor: copied grind lines left out: {error}");
+            base.grinds.clone()
+        }
+    };
+    if let Some(world) = world {
+        physics.replace_static_world(world);
+    }
+    physics.replace_grind_provider(grinds.clone());
+    skater.trajectory.bind_grind_world(grinds);
+    info!(
+        "MAP_EDITOR_PHYSICS copies={} collision_triangles={triangles} grind_lines={}",
+        placed.len(),
+        splines.len()
+    );
+}
+
+/// The map's static world plus the placed pieces' collision. `None` when the map has no
+/// query metadata to extend (then copies keep their mod-physics colliders only).
+fn overlay_world(base: &MapPhysics, placed: &[(Entity, Arc<PiecePhysics>, Affine3A)]) -> (Option<BoardWorld>, usize) {
+    let (Some(metadata), Some(first)) = (&base.metadata, base.triangles.first()) else { return (None, 0) };
+    let material = first.material;
+    let mut triangles = base.triangles.clone();
+    let mut metadata = metadata.clone();
+    let identity = skate_core::physics::drive_frames::RetailAffineTransform::IDENTITY;
+    for (_, piece, affine) in placed {
+        for collision in &piece.collision {
+            let start = triangles.len();
+            for t in &collision.triangles {
+                let vertices = t.vertices.map(|v| {
+                    let p = affine.transform_point3(Vec3::from_array(v));
+                    Vector3::new(p.x, p.y, p.z)
+                });
+                if let Some(triangle) = WorldTriangle::from_vertices(vertices, material, t.tag, t.flags, t.cosines, t.fatness) {
+                    triangles.push(triangle);
+                    metadata.packed_surfaces.push(t.surface);
+                }
+            }
+            if triangles.len() == start {
+                continue;
+            }
+            let Some(local_bounds) =
+                query_metadata::Bounds::from_points(triangles[start..].iter().flat_map(|t| t.triangle.vertices))
+            else {
+                triangles.truncate(start);
+                metadata.packed_surfaces.truncate(start);
+                continue;
+            };
+            metadata.meshes.push(query_metadata::QueryMesh {
+                triangle_range: start..triangles.len(),
+                local_to_world: identity,
+                world_to_local: identity,
+                local_bounds,
+                matching_group: collision.matching_group,
+                rejection_flags: collision.rejection_flags,
+                geometry: collision.geometry,
+                pool: pool_from(collision.pool),
+            });
+        }
+    }
+    let added = triangles.len() - base.triangles.len();
+    match BoardWorld::with_query_metadata(triangles, metadata) {
+        Ok(world) => (Some(world), added),
+        Err(error) => {
+            warn!("map editor: copied collision left out: {error}");
+            (None, 0)
+        }
+    }
+}
+
+fn near(point: Vec3, global: &GlobalTransform, aabb: Option<&Aabb>) -> bool {
+    let Some(aabb) = aabb else { return true };
+    let center = global.transform_point(Vec3::from(aabb.center));
+    let half = Vec3::from(aabb.half_extents) * global.scale().abs();
+    let closest = point.clamp(center - half, center + half);
+    closest.distance(point) <= SEARCH_RADIUS
+}
+
+fn next_number(map: &str) -> u32 {
+    let prefix = format!("{}_", crate::map_editor::layout_name(map));
+    std::fs::read_dir(pieces_dir())
+        .into_iter()
+        .flatten()
+        .flatten()
+        .filter_map(|f| {
+            let name = f.file_name().to_string_lossy().into_owned();
+            name.strip_prefix(&prefix)?.strip_suffix(".piece.json")?.parse::<u32>().ok()
+        })
+        .max()
+        .map_or(1, |n| n + 1)
+}
+
+/// One world mesh, in world space.
+struct Source<'a> {
+    entity: Entity,
+    material: String,
+    mesh: &'a Mesh,
+    world: Affine3A,
+    positions: Vec<Vec3>,
+    indices: Vec<u32>,
+}
+
+impl<'a> Source<'a> {
+    fn new(entity: Entity, material: &str, mesh: &'a Mesh, global: &GlobalTransform) -> Option<Self> {
+        let world = global.affine();
+        let positions = mesh.attribute(Mesh::ATTRIBUTE_POSITION)?.as_float3()?;
+        let positions: Vec<Vec3> = positions.iter().map(|p| world.transform_point3(Vec3::from_array(*p))).collect();
+        let indices: Vec<u32> = match mesh.indices() {
+            Some(indices) => indices.iter().map(|i| i as u32).collect(),
+            None => (0..positions.len() as u32).collect(),
+        };
+        Some(Self { entity, material: material.to_owned(), mesh, world, positions, indices })
+    }
+
+    fn triangle(&self, t: usize) -> [Vec3; 3] {
+        [0, 1, 2].map(|k| self.positions[self.indices[t * 3 + k] as usize])
+    }
+
+    fn triangles(&self) -> usize {
+        self.indices.len() / 3
+    }
+}
+
+/// Triangle `t` of source `s`.
+type Id = (u32, u32);
+
+/// Cuts the object around `point` (on `hit`) out of the world meshes.
+/// The piece's meshes, its origin, and its bounds in the world.
+fn extract(sources: &[Source], hit: Entity, point: Vec3) -> Result<(Vec<PiecePart>, Vec3, Bounds), String> {
+    let too_big = "That's part of something big (the ground, a wall or a building). Pick a smaller object: \
+                   a bench, rail, ledge, ramp, bin or sign"
+        .to_string();
+    let hit_source = sources.iter().position(|s| s.entity == hit).ok_or("That mesh isn't loaded")? as u32;
+    let source = &sources[hit_source as usize];
+    let seed = (0..source.triangles())
+        .min_by(|a, b| {
+            let distance = |t| closest_on_triangle(point, source.triangle(t)).distance_squared(point);
+            distance(*a).total_cmp(&distance(*b))
+        })
+        .ok_or("That mesh has no triangles")?;
+
+    // Triangles sharing a vertex position are connected, across meshes too
+    // (an object with two materials is split over two slabs).
+    let mut shared: HashMap<IVec3, Vec<Id>> = HashMap::new();
+    for (s, source) in sources.iter().enumerate() {
+        for t in 0..source.triangles() {
+            for v in source.triangle(t) {
+                shared.entry(weld(v)).or_default().push((s as u32, t as u32));
+            }
+        }
+    }
+    let flood = |start: Id| -> (Vec<Id>, bool) {
+        let mut seen = HashSet::from([start]);
+        let mut queue = VecDeque::from([start]);
+        let mut found = Vec::new();
+        let mut bounds = Bounds::default();
+        while let Some(id) = queue.pop_front() {
+            found.push(id);
+            let triangle = sources[id.0 as usize].triangle(id.1 as usize);
+            for v in triangle {
+                bounds.add(v);
+            }
+            if found.len() > MAX_TRIANGLES || bounds.extent().max_element() > MAX_EXTENT {
+                return (found, false);
+            }
+            for v in triangle {
+                for next in &shared[&weld(v)] {
+                    if seen.insert(*next) {
+                        queue.push_back(*next);
+                    }
+                }
+            }
+        }
+        (found, true)
+    };
+
+    let (first, fits) = flood((hit_source, seed as u32));
+    if !fits {
+        return Err(too_big);
+    }
+    let mut taken: HashSet<Id> = first.into_iter().collect();
+    // Loose parts in the same spot belong to the same object.
+    let mut rejected: HashSet<Id> = HashSet::new();
+    for _ in 0..3 {
+        let bounds = Bounds::of(sources, &taken);
+        let (inner, outer) = (bounds.grown(0.1), bounds.grown(0.5));
+        let mut grew = false;
+        for (s, source) in sources.iter().enumerate() {
+            for t in 0..source.triangles() {
+                let id = (s as u32, t as u32);
+                if taken.contains(&id) || rejected.contains(&id) {
+                    continue;
+                }
+                let [a, b, c] = source.triangle(t);
+                if !inner.contains((a + b + c) / 3.) {
+                    continue;
+                }
+                let (part, fits) = flood(id);
+                if fits && outer.contains_bounds(&Bounds::of(sources, &part)) {
+                    taken.extend(part);
+                    grew = true;
+                } else {
+                    rejected.extend(part);
+                }
+            }
+        }
+        if !grew {
+            break;
+        }
+    }
+
+    // Origin at the bottom centre, so the copy sits on whatever it's placed on.
+    let bounds = Bounds::of(sources, &taken);
+    let origin = Vec3::new((bounds.min.x + bounds.max.x) / 2., bounds.min.y, (bounds.min.z + bounds.max.z) / 2.);
+    let mut by_source: HashMap<u32, Vec<u32>> = HashMap::new();
+    for (s, t) in taken {
+        by_source.entry(s).or_default().push(t);
+    }
+    let mut parts: Vec<PiecePart> = by_source
+        .into_iter()
+        .map(|(s, mut triangles)| {
+            triangles.sort_unstable();
+            cut(&sources[s as usize], &triangles, origin)
+        })
+        .collect();
+    parts.sort_by(|a, b| a.material.cmp(&b.material));
+    Ok((parts, origin, bounds))
+}
+
+/// The listed triangles of one world mesh as a mesh of their own.
+fn cut(source: &Source, triangles: &[u32], origin: Vec3) -> PiecePart {
+    let mesh = source.mesh;
+    let mut remap: HashMap<u32, u32> = HashMap::new();
+    let mut order: Vec<u32> = Vec::new();
+    let mut indices = Vec::with_capacity(triangles.len() * 3);
+    for &t in triangles {
+        for k in 0..3 {
+            let v = source.indices[t as usize * 3 + k];
+            let next = order.len() as u32;
+            let index = *remap.entry(v).or_insert(next);
+            if index == next {
+                order.push(v);
+            }
+            indices.push(index);
+        }
+    }
+    let rotate = |v: Vec3| source.world.transform_vector3(v).normalize_or_zero();
+    let pick = |attribute: MeshVertexAttribute| mesh.attribute(attribute);
+    let f2 = |id| match pick(id) {
+        Some(VertexAttributeValues::Float32x2(values)) => order.iter().map(|&v| values[v as usize]).collect(),
+        _ => Vec::new(),
+    };
+    PiecePart {
+        material: source.material.clone(),
+        positions: order.iter().map(|&v| (source.positions[v as usize] - origin).to_array()).collect(),
+        normals: match pick(Mesh::ATTRIBUTE_NORMAL) {
+            Some(VertexAttributeValues::Float32x3(values)) => {
+                order.iter().map(|&v| rotate(Vec3::from_array(values[v as usize])).to_array()).collect()
+            }
+            _ => Vec::new(),
+        },
+        uv0: f2(Mesh::ATTRIBUTE_UV_0),
+        uv1: f2(Mesh::ATTRIBUTE_UV_1),
+        color: match pick(Mesh::ATTRIBUTE_COLOR) {
+            Some(VertexAttributeValues::Float32x4(values)) => order.iter().map(|&v| values[v as usize]).collect(),
+            _ => Vec::new(),
+        },
+        material_index: match pick(ATTRIBUTE_MATERIAL_INDEX) {
+            Some(VertexAttributeValues::Uint32(values)) => order.iter().map(|&v| values[v as usize]).collect(),
+            _ => Vec::new(),
+        },
+        tangents: match pick(Mesh::ATTRIBUTE_TANGENT) {
+            Some(VertexAttributeValues::Float32x4(values)) => order
+                .iter()
+                .map(|&v| {
+                    let [x, y, z, w] = values[v as usize];
+                    rotate(Vec3::new(x, y, z)).extend(w).to_array()
+                })
+                .collect(),
+            _ => Vec::new(),
+        },
+        indices,
+    }
+}
+
+fn weld(v: Vec3) -> IVec3 {
+    (v * WELD).round().as_ivec3()
+}
+
+#[derive(Clone, Copy)]
+struct Bounds {
+    min: Vec3,
+    max: Vec3,
+}
+
+impl Default for Bounds {
+    fn default() -> Self {
+        Self { min: Vec3::INFINITY, max: Vec3::NEG_INFINITY }
+    }
+}
+
+impl Bounds {
+    fn of<'a>(sources: &[Source], ids: impl IntoIterator<Item = &'a Id>) -> Self {
+        let mut bounds = Self::default();
+        for id in ids {
+            for v in sources[id.0 as usize].triangle(id.1 as usize) {
+                bounds.add(v);
+            }
+        }
+        bounds
+    }
+    fn add(&mut self, v: Vec3) {
+        self.min = self.min.min(v);
+        self.max = self.max.max(v);
+    }
+    fn extent(&self) -> Vec3 {
+        (self.max - self.min).max(Vec3::ZERO)
+    }
+    fn grown(&self, by: f32) -> Self {
+        Self { min: self.min - by, max: self.max + by }
+    }
+    fn contains(&self, v: Vec3) -> bool {
+        v.cmpge(self.min).all() && v.cmple(self.max).all()
+    }
+    fn contains_bounds(&self, other: &Self) -> bool {
+        self.contains(other.min) && self.contains(other.max)
+    }
+    fn overlaps(&self, other: &Self) -> bool {
+        self.min.cmple(other.max).all() && other.min.cmple(self.max).all()
+    }
+}
+
+/// Closest point to `p` on triangle `[a, b, c]` (Ericson, Real-Time Collision Detection 5.1.5).
+fn closest_on_triangle(p: Vec3, [a, b, c]: [Vec3; 3]) -> Vec3 {
+    let (ab, ac, ap) = (b - a, c - a, p - a);
+    let (d1, d2) = (ab.dot(ap), ac.dot(ap));
+    if d1 <= 0. && d2 <= 0. {
+        return a;
+    }
+    let bp = p - b;
+    let (d3, d4) = (ab.dot(bp), ac.dot(bp));
+    if d3 >= 0. && d4 <= d3 {
+        return b;
+    }
+    let vc = d1 * d4 - d3 * d2;
+    if vc <= 0. && d1 >= 0. && d3 <= 0. {
+        return a + ab * (d1 / (d1 - d3));
+    }
+    let cp = p - c;
+    let (d5, d6) = (ab.dot(cp), ac.dot(cp));
+    if d6 >= 0. && d5 <= d6 {
+        return c;
+    }
+    let vb = d5 * d2 - d1 * d6;
+    if vb <= 0. && d2 >= 0. && d6 <= 0. {
+        return a + ac * (d2 / (d2 - d6));
+    }
+    let va = d3 * d6 - d5 * d4;
+    if va <= 0. && (d4 - d3) >= 0. && (d5 - d6) >= 0. {
+        return b + (c - b) * ((d4 - d3) / ((d4 - d3) + (d5 - d6)));
+    }
+    let denom = 1. / (va + vb + vc);
+    a + ab * (vb * denom) + ac * (vc * denom)
+}
