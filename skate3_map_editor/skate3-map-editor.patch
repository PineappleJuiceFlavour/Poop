+/// PS3 (GTF) / Vita (GXT) texture header.
+#[derive(Clone, Copy, Debug)]
+pub struct GcmTexture {
+    pub format: u8,
+    /// A normal map (not a colour texture).
+    pub bump: bool,
+    pub width: u16,
+    pub height: u16,
+}
+
+/// A decoded resource.
+#[derive(Clone, Debug)]
+pub struct Resource {
+    pub magic: [u8; 3],
+    pub method: u8,
+    pub head: u32,
+    pub branch: (u16, u16),
+    pub compression: u8,
+    pub data: Vec<u8>,
+    pub dependencies: Vec<Dependency>,
+    pub gcm: Option<GcmTexture>,
+}
+
+impl Resource {
+    pub fn version(&self) -> u32 {
+        self.head & 0xFFFF
+    }
+    pub fn subversion(&self) -> u32 {
+        self.head >> 16
+    }
+    pub fn kind_name(&self) -> &'static str {
+        kind(&self.magic).map_or("unknown", |k| k.0)
+    }
+}
+
+const TEA_KEY: [u32; 4] = [0x01B7_0CBD, 0x1496_07D6, 0x07F9_4DD5, 0x10DB_8CA0];
+
+fn xxtea_decrypt(data: &mut [u8]) {
+    let mut v: Vec<u32> = data.chunks_exact(4).map(|c| u32::from_be_bytes(c.try_into().unwrap())).collect();
+    let n = v.len();
+    if n < 2 {
+        return;
+    }
+    const DELTA: u32 = 0x9E37_79B9;
+    let rounds = 6 + 52 / n as u32;
+    let mut sum = rounds.wrapping_mul(DELTA);
+    let mut y = v[0];
+    let mx = |z: u32, y: u32, sum: u32, p: usize, e: u32| {
+        ((z >> 5 ^ y << 2).wrapping_add(y >> 3 ^ z << 4)) ^ ((sum ^ y).wrapping_add(TEA_KEY[(p & 3) ^ e as usize] ^ z))
+    };
+    while sum != 0 {
+        let e = (sum >> 2) & 3;
+        for p in (1..n).rev() {
+            let z = v[p - 1];
+            v[p] = v[p].wrapping_sub(mx(z, y, sum, p, e));
+            y = v[p];
+        }
+        let z = v[n - 1];
+        v[0] = v[0].wrapping_sub(mx(z, y, sum, 0, e));
+        y = v[0];
+        sum = sum.wrapping_sub(DELTA);
+    }
+    for (chunk, value) in data.chunks_exact_mut(4).zip(v) {
+        chunk.copy_from_slice(&value.to_be_bytes());
+    }
+}
+
+/// Inflates the game's chunked zlib stream (`u16 flag, u16 chunks, (u16 packed, u16 size)*`).
+fn decompress(r: &mut Reader, end: usize) -> Option<Vec<u8>> {
+    r.u16()?;
+    let chunks = r.u16()? as usize;
+    if chunks == 0 {
+        return r.bytes(end.checked_sub(r.at)?).map(<[u8]>::to_vec);
+    }
+    let sizes: Vec<(usize, usize)> = (0..chunks).map(|_| Some((r.u16()? as usize, r.u16()? as usize))).collect::<Option<_>>()?;
+    let mut out = Vec::with_capacity(sizes.iter().map(|s| s.1).sum());
+    for (packed, size) in sizes {
+        let data = r.bytes(packed)?;
+        if packed == size {
+            out.extend_from_slice(data);
+            continue;
+        }
+        let start = out.len();
+        flate2::read::ZlibDecoder::new(data).read_to_end(&mut out).ok()?;
+        if out.len() - start != size {
+            return None;
+        }
+    }
+    Some(out)
+}
+
+/// Decodes a resource's header, dependencies and (decompressed) body.
+pub fn read_resource(bytes: &[u8]) -> Result<Resource, String> {
+    if !is_resource(bytes) {
+        return Err("not a LittleBigPlanet resource".into());
+    }
+    let magic: [u8; 3] = bytes[..3].try_into().unwrap();
+    let method = bytes[3];
+    let mut res = Resource { magic, method, head: 0, branch: (0, 0), compression: 0, data: Vec::new(), dependencies: Vec::new(), gcm: None };
+    let mut r = Reader::new(bytes, 0);
+    r.at = 4;
+    let bad = || "damaged resource".to_string();
+    match method {
+        b'b' | b'e' => {
+            let head = r.u32_raw().ok_or_else(bad)?;
+            res.head = head;
+            let mut compressed = head >= 0x132;
+            let mut table: Option<usize> = None;
+            if head >= 0x109 {
+                let offset = r.u32_raw().ok_or_else(bad)? as usize;
+                if offset > bytes.len() {
+                    return Err(bad());
+                }
+                table = Some(offset);
+                res.dependencies = read_dependencies(bytes, offset).ok_or_else(bad)?;
+                if head >= 0x189 {
+                    if &magic != b"SMH" {
+                        if head >= 0x271 {
+                            res.branch = (r.u16().ok_or_else(bad)?, r.u16().ok_or_else(bad)?);
+                        }
+                        // Leerdammer (LBP2 branch) gained the flags at its own revision.
+                        let leerdammer = head == 0x272 && res.branch.0 == 0x4C44 && res.branch.1 >= 0x2;
+                        if head >= 0x297 || leerdammer {
+                            res.compression = r.u8().ok_or_else(bad)?;
+                        }
+                        compressed = r.u8().ok_or_else(bad)? != 0;
+                    } else {
+                        return Err("static meshes (LittleBigPlanet 3 / Vita) aren't converted yet".into());
+                    }
+                }
+            }
+            let end = table.unwrap_or(bytes.len());
+            if method == b'e' {
+                let size = r.u32_raw().ok_or_else(bad)? as usize;
+                let padding = (4 - size % 4) % 4;
+                let mut block = vec![0u8; padding];
+                block.extend_from_slice(r.bytes(size).ok_or_else(bad)?);
+                xxtea_decrypt(&mut block);
+                let mut inner = Reader::new(&block, 0);
+                inner.at = padding;
+                let len = block.len();
+                res.data = if compressed { decompress(&mut inner, len).ok_or_else(bad)? } else { block[padding..].to_vec() };
+            } else {
+                res.data = if compressed { decompress(&mut r, end).ok_or_else(bad)? } else { r.bytes(end.checked_sub(r.at).ok_or_else(bad)?).ok_or_else(bad)?.to_vec() };
+            }
+        }
+        b't' => res.data = bytes[4..].to_vec(),
+        b' ' | b's' | b'S' => {
+            if &magic != b"TEX" {
+                if method == b'S' {
+                    r.at += 0x14;
+                }
+                let format = r.u8().ok_or_else(bad)?;
+                r.bytes(1 + 2 + 4).ok_or_else(bad)?; // mips, dimension, cubemap, remap
+                let width = r.u16().ok_or_else(bad)?;
+                let height = r.u16().ok_or_else(bad)?;
+                r.bytes(2 + 1).ok_or_else(bad)?; // depth, location
+                let bump = r.u8().ok_or_else(bad)? & 1 != 0;
+                r.bytes(8).ok_or_else(bad)?; // pitch, offset
+                res.gcm = Some(GcmTexture { format, bump, width, height });
+            }
+            res.data = decompress(&mut r, bytes.len()).ok_or_else(bad)?;
+        }
+        _ => return Err(bad()),
+    }
+    Ok(res)
+}
+
+fn read_dependencies(bytes: &[u8], offset: usize) -> Option<Vec<Dependency>> {
+    let mut r = Reader::new(bytes, 0);
+    r.at = offset;
+    let count = r.u32_raw()? as usize;
+    if count > bytes.len() {
+        return None;
+    }
+    let mut out = Vec::with_capacity(count);
+    for _ in 0..count {
+        let flags = r.u8()?;
+        let guid = if flags & 2 != 0 { Some(r.u32_raw()?) } else { None };
+        let sha1 = if flags & 1 != 0 { Some(r.bytes(20)?.try_into().ok()?) } else { None };
+        let kind = r.u32_raw()?;
+        out.push(Dependency { guid, sha1, kind });
+    }
+    Some(out)
+}
+
+/// Big-endian reader that follows the resource's integer compression flag.
+struct Reader<'a> {
+    b: &'a [u8],
+    at: usize,
+    compressed_ints: bool,
+}
+
+impl<'a> Reader<'a> {
+    fn new(b: &'a [u8], flags: u8) -> Self {
+        Reader { b, at: 0, compressed_ints: flags & 1 != 0 }
+    }
+    fn bytes(&mut self, n: usize) -> Option<&'a [u8]> {
+        let out = self.b.get(self.at..self.at.checked_add(n)?)?;
+        self.at += n;
+        Some(out)
+    }
+    fn u8(&mut self) -> Option<u8> {
+        self.bytes(1).map(|b| b[0])
+    }
+    fn u16(&mut self) -> Option<u16> {
+        self.bytes(2).map(|b| u16::from_be_bytes([b[0], b[1]]))
+    }
+    fn u32_raw(&mut self) -> Option<u32> {
+        self.bytes(4).map(|b| u32::from_be_bytes(b.try_into().unwrap()))
+    }
+    fn uleb(&mut self) -> Option<u64> {
+        let mut out = 0u64;
+        for shift in (0..64).step_by(7) {
+            let b = self.u8()?;
+            out |= ((b & 0x7F) as u64) << shift;
+            if b & 0x80 == 0 {
+                return Some(out);
+            }
+        }
+        None
+    }
+    /// `i32`/`u32` as the serializer writes them (LEB128 when integers are compressed).
+    fn int(&mut self) -> Option<u32> {
+        if self.compressed_ints { self.uleb().map(|v| v as u32) } else { self.u32_raw() }
+    }
+    fn f32(&mut self) -> Option<f32> {
+        self.u32_raw().map(f32::from_bits)
+    }
+    fn array(&mut self) -> Option<&'a [u8]> {
+        let n = self.int()? as usize;
+        self.bytes(n)
+    }
+    /// A resource reference as the serializer writes it.
+    fn reference(&mut self, version: u32) -> Option<Option<Ref>> {
+        if version > 0x22E {
+            self.int()?; // flags
+        }
+        let (hash, guid) = if version < 0x191 { (2, 1) } else { (1, 2) };
+        let which = self.u8()?;
+        let g = if which & guid != 0 { Some(self.int()?) } else { None };
+        let s: Option<Sha1> = if which & hash != 0 { Some(self.bytes(20)?.try_into().ok()?) } else { None };
+        Some(s.map(Ref::Sha1).or(g.filter(|&g| g != 0).map(Ref::Guid)))
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Meshes
+
+/// A mesh's geometry and the material of each part.
+#[derive(Debug, Default)]
+pub struct Mesh {
+    pub positions: Vec<[f32; 3]>,
+    pub normals: Vec<[f32; 3]>,
+    pub uvs: Vec<[f32; 2]>,
+    /// (triangle list, material)
+    pub parts: Vec<(Vec<u32>, Option<Ref>)>,
+}
+
+fn unpack_normal(v: u32) -> [f32; 3] {
+    let x = (v & 0x7FF) as f32;
+    let x = if v & 0x800 != 0 { -(0x800 as f32 - x) / 0x7FF as f32 } else { x / 0x7FF as f32 };
+    let y = ((v >> 12) & 0x3FF) as f32;
+    let y = if (v >> 12) & 0x400 != 0 { -(0x400 as f32 - y) / 0x3FF as f32 } else { y / 0x3FF as f32 };
+    let z = (1.0 - (x * x + y * y)).max(0.0).sqrt();
+    [x, y, if (v >> 23) & 1 != 0 { -z } else { z }]
+}
+
+/// Reads an `MSH` resource (as far as its parts; bones and soft-body data are skipped).
+pub fn read_mesh(res: &Resource) -> Option<Mesh> {
+    let (version, sub) = (res.version(), res.subversion());
+    let mut r = Reader::new(&res.data, res.compression);
+    let verts = r.int()? as usize;
+    let num_indices = r.int()? as usize;
+    r.int()?; // edge indices
+    let num_tris = r.int()? as usize;
+    let streams = r.int()? as usize;
+    let attributes = r.int()? as usize;
+    r.int()?; // morphs
+    r.bytes(0x20 * 0x10)?; // morph names
+    if version >= 0x239 {
+        for _ in 0..2 {
+            let n = r.int()? as usize;
+            r.bytes(n.checked_mul(4)?)?;
+        }
+        r.f32()?;
+    }
+    if streams == 0 || streams > 64 || verts == 0 || verts.checked_mul(16 * streams)? > res.data.len() {
+        return None;
+    }
+    for _ in 0..streams + 2 {
+        r.int()?;
+    }
+    let stream0 = r.bytes(verts * 16)?;
+    let stream1 = if streams > 1 { Some(r.bytes(verts * 16)?) } else { None };
+    r.bytes(verts * 16 * streams.saturating_sub(2))?;
+    let attribute_data = r.array()?;
+    let index_data = r.array()?;
+    if sub >= 0x16B {
+        r.array()?;
+    }
+    let primitive_count = r.int()? as usize;
+    if primitive_count > 4096 {
+        return None;
+    }
+    let mut primitives = Vec::with_capacity(primitive_count);
+    for _ in 0..primitive_count {
+        let material = r.reference(version)?;
+        if version < 0x149 {
+            r.reference(version)?;
+        }
+        if version >= 0x179 {
+            r.reference(version)?;
+        }
+        let _min_vert = r.int()?;
+        let _max_vert = r.int()?;
+        let first = r.int()? as usize;
+        let count = r.int()? as usize;
+        r.int()?; // region
+        primitives.push((material, first, count));
+    }
+
+    let be = |b: &[u8], at: usize| f32::from_bits(u32::from_be_bytes(b[at..at + 4].try_into().unwrap()));
+    let positions = (0..verts).map(|i| [be(stream0, i * 16), be(stream0, i * 16 + 4), be(stream0, i * 16 + 8)].map(|v| v * SCALE)).collect();
+    let normals = stream1
+        .map(|s| (0..verts).map(|i| unpack_normal(u32::from_be_bytes([0, s[i * 16 + 4], s[i * 16 + 5], s[i * 16 + 6]]))).collect())
+        .unwrap_or_default();
+    let uvs = if attributes > 0 && attribute_data.len() >= verts * attributes * 8 {
+        (0..verts).map(|i| [be(attribute_data, i * attributes * 8), be(attribute_data, i * attributes * 8 + 4)]).collect()
+    } else {
+        Vec::new()
+    };
+    let indices: Vec<u32> = index_data.chunks_exact(2).map(|c| u16::from_be_bytes([c[0], c[1]]) as u32).collect();
+    // The strip/list flag sits after the bone data; the game's own meshes are strips with
+    // 0xFFFF restarts, meshes built by tools are lists of exactly three indices per triangle.
+    let strips = indices.contains(&0xFFFF) || num_tris * 3 != num_indices;
+    let parts = primitives
+        .into_iter()
+        .filter_map(|(material, first, count)| {
+            let range = indices.get(first..first.checked_add(count)?)?;
+            let list = if strips { crate::glb::strip_to_list(range, Some(0xFFFF)) } else { range.to_vec() };
+            Some((list, material))
+        })
+        .collect();
+    Some(Mesh { positions, normals, uvs, parts })
+}
+
+// ---------------------------------------------------------------------------------------------
+// Textures
+
+/// The texture slots of a graphics material (`GMT`), in order.
+pub fn material_textures(res: &Resource) -> Option<Vec<Ref>> {
+    // Craftworld Toolkit's own branch stores materials differently.
+    if res.magic != *b"GMT" || res.branch.0 == 0x4D5A {
+        return None;
+    }
+    let (version, sub) = (res.version(), res.subversion());
+    let mut r = Reader::new(&res.data, res.compression);
+    let flags = r.int()?;
+    r.f32()?; // alpha test level
+    r.u8()?; // alpha layer
+    if version >= 0x2FA {
+        r.u8()?; // alpha mode
+    }
+    r.u8()?; // shadow cast mode
+    r.bytes(4 * 4)?; // bump level, cosine power, reflection blur, refractive index
+    if sub >= 0x13A {
+        r.bytes(4 * 4)?; // refractive fresnel
+        if sub >= 0x16B {
+            r.u8()?;
+            if sub >= 0x17C {
+                r.bytes(6)?; // fuzz lighting
+            }
+        }
+    }
+    let vita = res.branch.0 == 0x4431 && (0x3C1..=0x3E2).contains(&version);
+    let leerdammer = res.branch.0 == 0x4C44 && res.head == 0x272;
+    let mut offsets = if flags & 0x10000 != 0 { 0x18 } else { 0xC };
+    if version < 0x3C1 || !vita || res.branch.1 < 0x10 {
+        offsets = 0xA;
+    }
+    if version < 0x393 {
+        offsets = 8;
+    }
+    if version < 0x34F {
+        offsets = 4;
+    }
+    if (version < 0x2D0 && !leerdammer) || (leerdammer && res.branch.1 < 0x13) {
+        offsets = 3;
+    }
+    for _ in 0..offsets {
+        r.int()?;
+    }
+    r.array()?; // shader code
+    let slots: Vec<Option<Ref>> = (0..8).map(|_| r.reference(version)).collect::<Option<_>>()?;
+    Some(slots.into_iter().flatten().collect())
+}
+
+/// Normal maps are marked in the PS3 header, or with a `BUMP` footer on plain DDS textures.
+fn is_bump(res: &Resource) -> bool {
+    res.gcm.is_some_and(|g| g.bump) || (res.gcm.is_none() && res.data.ends_with(b"BUMP"))
+}
+
+/// Decodes a `TEX`/`GTF` texture resource's top mip level.
+pub fn read_texture(res: &Resource) -> Option<Rgba> {
+    let Some(gcm) = res.gcm else {
+        // Plain `TEX `: the body is a DDS file.
+        return texture::decode_dds(&res.data);
+    };
+    let (w, h) = (gcm.width as u32, gcm.height as u32);
+    let vita = res.method == b'S';
+    let format = gcm.format & !0x60;
+    let linear = gcm.format & 0x20 != 0;
+    let block = match format {
+        0x86 => Some(Block::Dxt1),
+        0x87 => Some(Block::Dxt3),
+        0x88 => Some(Block::Dxt5),
+        _ => None,
+    };
+    if let Some(block) = block {
+        let data = if vita { unswizzle_morton(&res.data, w.div_ceil(4), h.div_ceil(4), block.bytes())? } else { res.data.clone() };
+        return texture::decode_blocks(&data, w, h, block);
+    }
+    let masks = |bytes: usize, r: u32, g: u32, b: u32, a: u32| Masks { bytes, r, g, b, a, luminance: false, big_endian: true };
+    let m = match format {
+        0x81 => Masks { luminance: true, ..masks(1, 0xFF, 0, 0, 0) },
+        0x82 => masks(2, 0x7C00, 0x03E0, 0x001F, 0x8000),
+        0x83 => masks(2, 0x0F00, 0x00F0, 0x000F, 0xF000),
+        0x84 => masks(2, 0xF800, 0x07E0, 0x001F, 0),
+        0x85 => masks(4, 0x00FF_0000, 0x0000_FF00, 0x0000_00FF, 0xFF00_0000),
+        0x8B => masks(2, 0, 0xFF00, 0x00FF, 0),
+        0x8F => masks(2, 0x7C00, 0x03E0, 0x001F, 0),
+        _ => return None,
+    };
+    let data = if vita {
+        unswizzle_morton(&res.data, w, h, m.bytes)?
+    } else if linear {
+        res.data.clone()
+    } else {
+        unswizzle_gtf(&res.data, w, h, m.bytes)?
+    };
+    texture::decode_masked(&data, w, h, m)
+}
+
+/// PS3 swizzled (interleaved X/Y bits) to linear, top mip level.
+fn unswizzle_gtf(data: &[u8], width: u32, height: u32, px: usize) -> Option<Vec<u8>> {
+    let (w, h) = (width as usize, height as usize);
+    if data.len() < w * h * px || w == 0 || h == 0 {
+        return None;
+    }
+    let (log_w, log_h) = (31 - width.leading_zeros(), 31 - height.leading_zeros());
+    let limit = 1u32.checked_shl(log_w.min(log_h) * 2)?;
+    let x_mask = 0x5555_5555u32 | !(limit - 1);
+    let y_mask = 0xAAAA_AAAAu32 & (limit - 1);
+    let mut out = vec![0u8; w * h * px];
+    let (mut offset_y, mut offset_x0) = (0u32, 0u32);
+    for y in 0..h {
+        let mut offset_x = offset_x0;
+        for x in 0..w {
+            let src = (offset_y.wrapping_add(offset_x)) as usize * px;
+            if let Some(texel) = data.get(src..src + px) {
+                out[(y * w + x) * px..][..px].copy_from_slice(texel);
+            }
+            offset_x = offset_x.wrapping_sub(x_mask) & x_mask;
+        }
+        offset_y = offset_y.wrapping_sub(y_mask) & y_mask;
+        if offset_y == 0 {
+            offset_x0 = offset_x0.wrapping_add(limit);
+        }
+    }
+    Some(out)
+}
+
+fn morton(x: u32, y: u32, width: u32, height: u32) -> u32 {
+    let (log_w, log_h) = (31 - width.leading_zeros(), 31 - height.leading_zeros());
+    let d = log_w.min(log_h);
+    let mut m = 0;
+    for i in 0..d {
+        m |= ((x & (1 << i)) << (i + 1)) | ((y & (1 << i)) << i);
+    }
+    if width < height { m | ((y & !(width - 1)) << d) } else { m | ((x & !(height - 1)) << d) }
+}
+
+/// Vita (GXT) Morton-order to linear, top mip level; `width`/`height` in texels (or 4x4 blocks).
+fn unswizzle_morton(data: &[u8], width: u32, height: u32, px: usize) -> Option<Vec<u8>> {
+    let (w, h) = (width as usize, height as usize);
+    if w == 0 || h == 0 {
+        return None;
+    }
+    let (pw, ph) = (width.next_power_of_two(), height.next_power_of_two());
+    let (mx, my) = (morton(pw - 1, 0, pw, ph), morton(0, ph - 1, pw, ph));
+    let mut out = vec![0u8; w * h * px];
+    let mut oy = 0u32;
+    for y in 0..h {
+        let mut ox = 0u32;
+        for x in 0..w {
+            let src = (ox + oy) as usize * px;
+            out[(y * w + x) * px..][..px].copy_from_slice(data.get(src..src + px)?);
+            ox = ox.wrapping_sub(mx) & mx;
+        }
+        oy = oy.wrapping_sub(my) & my;
+    }
+    Some(out)
+}
+
+// ---------------------------------------------------------------------------------------------
+// Unpacking a game
+
+/// Where a resource's bytes live.
+#[derive(Clone, Debug)]
+enum Location {
+    Farc { archive: PathBuf, offset: u64, size: u64 },
+    File(PathBuf),
+}
+
+/// Every resource of the game, findable by hash or GUID.
+#[derive(Default)]
+struct Store {
+    by_sha1: HashMap<Sha1, Location>,
+    guid_to_sha1: HashMap<u32, Sha1>,
+    names: HashMap<Sha1, String>,
+    textures: HashMap<Sha1, Option<usize>>,
+    images: Vec<Vec<u8>>,
+}
+
+impl Store {
+    fn read(&self, at: &Location) -> Option<Vec<u8>> {
+        match at {
+            Location::File(path) => std::fs::read(path).ok(),
+            Location::Farc { archive, offset, size } => {
+                let mut file = File::open(archive).ok()?;
+                file.seek(SeekFrom::Start(*offset)).ok()?;
+                let mut out = vec![0u8; *size as usize];
+                file.read_exact(&mut out).ok()?;
+                Some(out)
+            }
+        }
+    }
+
+    fn resolve(&self, reference: Ref) -> Option<Sha1> {
+        match reference {
+            Ref::Sha1(sha1) => Some(sha1),
+            Ref::Guid(guid) => self.guid_to_sha1.get(&guid).copied(),
+        }
+    }
+
+    fn resource(&self, reference: Ref) -> Option<Resource> {
+        let sha1 = self.resolve(reference)?;
+        read_resource(&self.read(self.by_sha1.get(&sha1)?)?).ok()
+    }
+
+    /// The first texture a graphics material uses, as a PNG in `images` (cached).
+    fn material_texture(&mut self, material: Ref) -> Option<Vec<u8>> {
+        let gmat = self.resource(material)?;
+        // The material's texture slots in order; the dependency table (unordered) if they can't
+        // be read. The first colour texture is taken; normal maps are skipped.
+        let slots = material_textures(&gmat).unwrap_or_else(|| gmat.dependencies.iter().filter(|d| d.kind == 1).filter_map(|d| d.reference()).collect());
+        slots.into_iter().find_map(|texture| self.colour_texture(texture))
+    }
+
+    fn colour_texture(&mut self, texture: Ref) -> Option<Vec<u8>> {
+        let sha1 = self.resolve(texture)?;
+        if let Some(cached) = self.textures.get(&sha1) {
+            return cached.map(|i| self.images[i].clone());
+        }
+        let png = self.resource(Ref::Sha1(sha1)).filter(|t| !is_bump(t)).and_then(|t| read_texture(&t)).and_then(|t| t.png());
+        // Keep the cache bounded: the decoded PNGs of a whole game can run to gigabytes.
+        if self.images.iter().map(Vec::len).sum::<usize>() > 256 << 20 {
+            self.images.clear();
+            self.textures.clear();
+        }
+        let index = png.map(|png| {
+            self.images.push(png);
+            self.images.len() - 1
+        });
+        self.textures.insert(sha1, index);
+        index.map(|i| self.images[i].clone())
+    }
+
+    /// Converts a mesh with its materials' textures.
+    fn model(&mut self, mesh: Mesh) -> Model {
+        let mut model = Model { positions: mesh.positions, normals: mesh.normals, uvs: mesh.uvs, ..Default::default() };
+        let mut by_material: HashMap<Option<Sha1>, usize> = HashMap::new();
+        for (triangles, material) in mesh.parts {
+            let key = material.and_then(|m| self.resolve(m));
+            let index = match by_material.get(&key) {
+                Some(&i) => i,
+                None => {
+                    let png = material.and_then(|m| self.material_texture(m));
+                    let texture = png.map(|png| {
+                        model.images.push(png);
+                        model.images.len() - 1
+                    });
+                    let name = key.and_then(|k| self.names.get(&k).cloned()).unwrap_or_else(|| key.map(|k| hex(&k)).unwrap_or_default());
+                    model.materials.push(Material {
+                        name,
+                        color: if texture.is_some() { [1.0; 4] } else { [0.8, 0.8, 0.8, 1.0] },
+                        texture,
+                        alpha_mask: texture.is_some(),
+                    });
+                    by_material.insert(key, model.materials.len() - 1);
+                    model.materials.len() - 1
+                }
+            };
+            model.primitives.push((triangles, index));
+        }
+        model
+    }
+}
+
+fn is_ext(path: &Path, ext: &str) -> bool {
+    path.extension().is_some_and(|e| e.eq_ignore_ascii_case(ext))
+}
+
+/// Unpacks every `.farc` archive among `files` (named with the game's `.map` databases), and
+/// converts every LittleBigPlanet mesh to a model and every texture to a PNG.
+///
+/// `files` are (path on disk, path relative to the game root). Returns the archive entries that
+/// aren't resources (for the other converters) and the files it handled.
+pub fn unpack(files: &[(PathBuf, String)], out: &mut Output) -> (Vec<(PathBuf, String)>, HashSet<String>) {
+    let mut store = Store::default();
+    let mut found = false;
+    let mut handled = HashSet::new();
+    let mut new_files = Vec::new();
+    for (path, rel) in files.iter().filter(|(p, _)| is_ext(p, "map")) {
+        let Some(rows) = std::fs::read(path).ok().and_then(|b| read_map(&b)) else { continue };
+        found = true;
+        handled.insert(rel.clone());
+        out.status(format!("Reading file database {} ({} files)", path.display(), rows.len()));
+        for row in rows {
+            store.guid_to_sha1.entry(row.guid).or_insert(row.sha1);
+            store.names.entry(row.sha1).or_insert(row.path);
+        }
+    }
+    // Loose game files named by the database.
+    let by_name: HashMap<String, Vec<&(PathBuf, String)>> = files.iter().fold(HashMap::new(), |mut map, f| {
+        map.entry(f.1.rsplit('/').next().unwrap_or_default().to_ascii_lowercase()).or_default().push(f);
+        map
+    });
+    let named: Vec<(Sha1, String)> = store.names.iter().map(|(s, n)| (*s, n.clone())).collect();
+    for (sha1, name) in named {
+        let lower = name.to_ascii_lowercase();
+        let file_name = lower.rsplit('/').next().unwrap_or_default();
+        if let Some(found) = by_name.get(file_name).and_then(|c| c.iter().find(|(_, rel)| rel.to_ascii_lowercase().ends_with(&lower))) {
+            store.by_sha1.insert(sha1, Location::File(found.0.clone()));
+        }
+    }
+
+    let mut archives = Vec::new();
+    for (path, rel) in files.iter().filter(|(p, _)| is_ext(p, "farc")) {
+        let Ok(entries) = File::open(path).map_err(|e| e.to_string()).and_then(|mut f| read_farc(&mut f)) else { continue };
+        found = true;
+        handled.insert(rel.clone());
+        out.report.archives += 1;
+        for e in &entries {
+            store.by_sha1.entry(e.sha1).or_insert(Location::Farc { archive: path.clone(), offset: e.offset, size: e.size });
+        }
+        archives.push((path.clone(), rel.clone(), entries));
+    }
+
+    // Every resource: from archives (unpacked to `<archive>_files/`) and loose files.
+    let mut todo: Vec<(Location, PathBuf, String)> = Vec::new();
+    let mut loose = Vec::new();
+    for (archive, rel, entries) in &archives {
+        for e in entries {
+            let name = store.names.get(&e.sha1).cloned();
+            let target = PathBuf::from(format!("{rel}_files")).join(match &name {
+                Some(name) => safe_path(name),
+                None => PathBuf::from("unnamed").join(hex(&e.sha1)),
+            });
+            let label = name.unwrap_or_else(|| hex(&e.sha1));
+            todo.push((Location::Farc { archive: archive.clone(), offset: e.offset, size: e.size }, target, label));
+        }
+    }
+    for (path, rel) in files {
+        if is_ext(path, "farc") || is_ext(path, "map") {
+            continue;
+        }
+        let mut head = [0u8; 8];
+        // Other games' files can start with three capitals by chance: outside LittleBigPlanet
+        // data (no database or archive), only take files with the resource type's extension.
+        if File::open(path).and_then(|mut f| f.read_exact(&mut head)).is_ok()
+            && is_resource(&head)
+            && (found || kind(&head[..3]).is_some_and(|(_, ext)| is_ext(path, ext)))
+        {
+            loose.push((Location::File(path.clone()), PathBuf::from(rel), rel.clone()));
+        }
+    }
+    found |= !loose.is_empty();
+    for item in &loose {
+        handled.insert(item.2.clone());
+    }
+    todo.extend(loose);
+    if !found {
+        return (new_files, handled);
+    }
+
+    let mut index = String::from("path\ttype\trevision\tsha1/size\tdependencies\tconverted to\n");
+    let total = todo.len();
+    for (n, (location, target, label)) in todo.into_iter().enumerate() {
+        if n % 64 == 0 {
+            out.status(format!("LittleBigPlanet: {n}/{total} resources ({} models, {} textures)", out.report.models.len(), out.report.textures));
+        }
+        let Some(bytes) = store.read(&location) else { continue };
+        let mut target = target;
+        if matches!(location, Location::Farc { .. }) {
+            // Unnamed entries get their type's extension.
+            if target.extension().is_none() && let Some((_, ext)) = (bytes.len() >= 3).then(|| kind(&bytes[..3])).flatten() {
+                target.set_extension(ext);
+            }
+            out.write_extracted(&target, &bytes);
+            if !is_resource(&bytes) {
+                // Plain files (sounds, text) go to the other converters.
+                let rel = target.to_string_lossy().replace('\\', "/");
+                new_files.push((out.dir.join(&target), rel));
+                continue;
+            }
+        }
+        let res = match read_resource(&bytes) {
+            Ok(res) => res,
+            Err(e) => {
+                index.push_str(&format!("{label}\t?\t\t{} bytes\t\t{e}\n", bytes.len()));
+                continue;
+            }
+        };
+        let mut converted = String::new();
+        match &res.magic {
+            b"MSH" => {
+                if let Some(mesh) = read_mesh(&res) {
+                    let model = store.model(mesh);
+                    let stem = label.trim_end_matches(".mol").to_string();
+                    if let Some(asset) = model.to_glb().and_then(|glb| out.add_model(&stem, &glb)) {
+                        converted = asset;
+                    }
+                }
+            }
+            b"TEX" | b"GTF" => {
+                let rel = target.to_string_lossy().replace('\\', "/");
+                if let Some(image) = read_texture(&res)
+                    && out.add_image(&rel, &image)
+                {
+                    converted = format!("{rel}.png");
+                }
+            }
+            _ => {}
+        }
+        let deps: Vec<String> = res
+            .dependencies
+            .iter()
+            .filter_map(|d| d.reference())
+            .map(|r| match store.resolve(r).and_then(|s| store.names.get(&s)) {
+                Some(name) => name.clone(),
+                None => match r {
+                    Ref::Guid(g) => format!("g{g}"),
+                    Ref::Sha1(s) => hex(&s),
+                },
+            })
+            .collect();
+        index.push_str(&format!(
+            "{label}\t{}\t0x{:08x}\t{} bytes\t{}\t{converted}\n",
+            res.kind_name(),
+            res.head,
+            bytes.len(),
+            deps.join(", ")
+        ));
+        if res.magic == *b"MSH" && !converted.is_empty() {
+            out.report.converted += 1;
+        }
+    }
+    out.write_converted(Path::new("_littlebigplanet_resources.tsv"), index.as_bytes());
+    out.add_note(format!(
+        "LittleBigPlanet: {total} resources unpacked; meshes became models, textures PNGs. _littlebigplanet_resources.tsv lists every resource with its type and what it uses."
+    ));
+    (new_files, handled)
+}
+
+#[cfg(test)]
+mod tests {
