+//! # bevy_map_editor
+//!
+//! A drop-in, in-game map editor for any Bevy 3D game.
+//!
+//! ```no_run
+//! use bevy::prelude::*;
+//! use bevy_map_editor::MapEditorPlugin;
+//!
+//! App::new()
+//!     .add_plugins(DefaultPlugins)
+//!     .add_plugins(MapEditorPlugin::default())
+//!     .run();
+//! ```
+//!
+//! Press **F1** in game to open the editor. The game's camera is switched off and a free
+//! camera takes over from the same spot; press F1 again and the original camera comes back.
+//! Drag props from the asset browser into the world, move them, rotate them, save the map.
+//! Saved maps load automatically the next time the game starts (see [`MapEditorPlugin::startup_map`]).
+
+mod camera;
+mod disc;
+mod editor;
+mod library;
+mod props;
+mod ui;
+
+use std::path::PathBuf;
+use std::sync::OnceLock;
+
+use bevy::prelude::*;
+use bevy_egui::{EguiPlugin, EguiPrimaryContextPass};
+
+pub use camera::{EditorCamera, EditorUiCamera};
+pub use editor::{EditorAction, EditorState, LoadMap, UnresolvedPick};
+pub use library::{Library, LibraryEntry, LibraryGroup, MapEditorAppExt, PrefabRegistry};
+pub use props::{CollisionKind, Ghost, MapFile, MeshPart, Primitive, Prop, PropData, PropSource, PropSpawned};
+
+/// Add this to your app. Add it after `DefaultPlugins` (and after `EguiPlugin` if your game uses egui).
+#[derive(Clone)]
+pub struct MapEditorPlugin {
+    /// Key that opens and closes the editor.
+    pub toggle_key: KeyCode,
+    /// Map (file name inside `assets/maps/`) to load when the game starts, e.g. `"level1"`.
+    /// `None` starts with an empty map.
+    pub startup_map: Option<String>,
+    /// Freeze game time (`Time<Virtual>`) while the editor is open, so the game and its physics stop.
+    pub pause_game: bool,
+    /// Start the game inside the editor.
+    pub start_in_editor: bool,
+    /// File extensions in the game's assets folder that load as scenes, shown under "Game files".
+    /// glTF is always included; add the formats your game has loaders for (e.g. `"p3d"`).
+    pub model_extensions: Vec<String>,
+    /// The game's assets folder, if it isn't the default `assets/` (match your `AssetPlugin::file_path`).
+    pub assets_dir: Option<PathBuf>,
+    /// Where maps are saved, if not `<assets>/maps`.
+    pub maps_dir: Option<PathBuf>,
+    /// Only list files from these folders of the assets folder under "Game files" (e.g.
+    /// `["imported"]`). `None` lists the whole assets folder.
+    pub file_folders: Option<Vec<String>>,
+    /// List what the running game has loaded ("Loaded by the game").
+    pub show_loaded: bool,
+    /// The game resolves eyedropper picks the editor can't (objects with no asset file): the
+    /// editor sends [`UnresolvedPick`] and the game answers with [`EditorAction::AddPicked`].
+    pub handles_unresolved_picks: bool,
+}
+
+impl Default for MapEditorPlugin {
+    fn default() -> Self {
+        Self {
+            toggle_key: KeyCode::F1,
+            startup_map: None,
+            pause_game: true,
+            start_in_editor: false,
+            model_extensions: Vec::new(),
+            assets_dir: None,
+            maps_dir: None,
+            file_folders: None,
+            show_loaded: true,
+            handles_unresolved_picks: false,
+        }
+    }
+}
+
+/// Whether the editor is open. Use the run conditions [`editor_open`] / [`editor_closed`]
+/// to stop your gameplay input while the editor has the mouse and keyboard.
+#[derive(States, Default, Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum EditorMode {
+    #[default]
+    Playing,
+    Editing,
+}
+
+/// Run condition: the map editor is open.
+pub fn editor_open(mode: Res<State<EditorMode>>) -> bool {
+    *mode.get() == EditorMode::Editing
+}
+
+/// Run condition: the map editor is closed (the game is being played).
+pub fn editor_closed(mode: Res<State<EditorMode>>) -> bool {
+    *mode.get() == EditorMode::Playing
+}
+
+/// Runtime settings, editable from the editor toolbar.
+#[derive(Resource, Clone)]
+pub struct MapEditorSettings {
+    pub toggle_key: KeyCode,
+    pub pause_game: bool,
+    pub snap_enabled: bool,
+    pub grid_size: f32,
+    pub rotate_step_deg: f32,
+    pub camera_speed: f32,
+    pub look_sensitivity: f32,
+    pub show_grid: bool,
+    pub show_colliders_hint: bool,
+    /// Lower-case extensions (without the dot) scanned for in the assets folder.
+    pub model_extensions: Vec<String>,
+    /// See [`MapEditorPlugin::file_folders`].
+    pub file_folders: Option<Vec<String>>,
+    /// See [`MapEditorPlugin::show_loaded`].
+    pub show_loaded: bool,
+    /// See [`MapEditorPlugin::handles_unresolved_picks`].
+    pub handles_unresolved_picks: bool,
+}
+
+impl Default for MapEditorSettings {
+    fn default() -> Self {
+        Self {
+            toggle_key: KeyCode::F1,
+            pause_game: true,
+            snap_enabled: false,
+            grid_size: 1.0,
+            rotate_step_deg: 15.0,
+            camera_speed: 10.0,
+            look_sensitivity: 0.003,
+            show_grid: true,
+            show_colliders_hint: true,
+            model_extensions: vec!["glb".into(), "gltf".into()],
+            file_folders: None,
+            show_loaded: true,
+            handles_unresolved_picks: false,
+        }
+    }
+}
+
+/// The schedule the editor UI runs in (the editor camera's own egui context).
+#[derive(bevy::ecs::schedule::ScheduleLabel, Debug, Clone, PartialEq, Eq, Hash)]
+pub struct MapEditorUiPass;
+
+static ASSETS_DIR: OnceLock<PathBuf> = OnceLock::new();
+static MAPS_DIR: OnceLock<PathBuf> = OnceLock::new();
+
+/// Folder that Bevy's `AssetServer` reads from (`<project>/assets` when run through cargo,
+/// or [`MapEditorPlugin::assets_dir`]).
+pub fn assets_root() -> PathBuf {
+    let base = bevy::asset::io::file::FileAssetReader::get_base_path();
+    match ASSETS_DIR.get() {
+        Some(dir) if dir.is_absolute() => dir.clone(),
+        Some(dir) => base.join(dir),
+        None => base.join("assets"),
+    }
+}
+
+/// Folder maps are saved to.
+pub fn maps_dir() -> PathBuf {
+    match MAPS_DIR.get() {
+        Some(dir) => dir.clone(),
+        None => assets_root().join("maps"),
+    }
+}
+
+#[derive(Resource)]
+pub(crate) struct StartupConfig {
+    startup_map: Option<String>,
+    start_in_editor: bool,
+}
+
+impl Plugin for MapEditorPlugin {
+    fn build(&self, app: &mut App) {
+        if !app.is_plugin_added::<EguiPlugin>() {
+            app.add_plugins(EguiPlugin::default());
+        }
+        // bevy_egui gives the game's first camera a primary context and runs this schedule for it.
+        // A game without egui UI of its own never creates it, which makes that pass fail.
+        if app.get_schedule(EguiPrimaryContextPass).is_none() {
+            app.init_schedule(EguiPrimaryContextPass);
+        }
+
+        if let Some(dir) = &self.assets_dir {
+            let _ = ASSETS_DIR.set(dir.clone());
+        }
+        if let Some(dir) = &self.maps_dir {
+            let _ = MAPS_DIR.set(dir.clone());
+        }
+        let mut settings = MapEditorSettings {
+            toggle_key: self.toggle_key,
+            pause_game: self.pause_game,
+            file_folders: self.file_folders.clone(),
+            show_loaded: self.show_loaded,
+            handles_unresolved_picks: self.handles_unresolved_picks,
+            ..default()
+        };
+        for ext in &self.model_extensions {
+            let ext = ext.trim_start_matches('.').to_ascii_lowercase();
+            if !settings.model_extensions.contains(&ext) {
+                settings.model_extensions.push(ext);
+            }
+        }
+
+        app.init_state::<EditorMode>()
+            .insert_resource(settings)
+            .insert_resource(StartupConfig {
+                startup_map: self.startup_map.clone(),
+                start_in_editor: self.start_in_editor,
+            })
+            .add_plugins((
+                props::PropsPlugin,
+                library::LibraryPlugin,
+                camera::EditorCameraPlugin,
+                editor::EditorLogicPlugin,
+                ui::EditorUiPlugin,
+            ));
+    }
+}
diff --git a/crates/skate-map-editor/src/library.rs b/crates/skate-map-editor/src/library.rs
new file mode 100644
index 0000000..476a629
--- /dev/null
+++ b/crates/skate-map-editor/src/library.rs
@@ -0,0 +1,537 @@
+//! The asset browser's catalogue: everything the host game has to offer.
+//!
+//! - **Game prefabs**: objects the game registers in code ([`MapEditorAppExt::register_prefab`]).
+//! - **Game files**: scene files in the game's assets folder.
+//! - **Loaded by the game**: scenes and meshes the running game has loaded, in any format it has a
+//!   loader for, including every separate mesh inside multi-mesh glTF levels and kits.
+//! - **Picked**: objects copied from the game world with the eyedropper.
+
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::path::Path;
+use std::sync::Arc;
+
+use bevy::ecs::system::SystemParam;
+use bevy::gltf::{Gltf, GltfMesh};
+use bevy::prelude::*;
+use bevy::scene::{Scene, SceneRoot};
+
+use crate::props::{MeshPart, Prop, PropData, PropSource, is_gltf_path, path_stem};
+use crate::{EditorMode, MapEditorSettings, assets_root, maps_dir};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum LibraryGroup {
+    Prefabs,
+    Files,
+    Loaded,
+    Picked,
+}
+
+impl LibraryGroup {
+    pub fn title(self) -> &'static str {
+        match self {
+            LibraryGroup::Prefabs => "Game objects",
+            LibraryGroup::Files => "Game files",
+            LibraryGroup::Loaded => "Loaded by the game",
+            LibraryGroup::Picked => "Picked from the world",
+        }
+    }
+}
+
+/// One placeable thing in the asset browser.
+#[derive(Clone, Debug)]
+pub struct LibraryEntry {
+    pub group: LibraryGroup,
+    pub label: String,
+    pub hint: String,
+    /// The prop that gets placed (source, default scale, collision…).
+    pub data: PropData,
+}
+
+/// What the asset browser shows. Rebuilt when the editor opens, every second while it is open
+/// (so newly loaded game assets appear), and on Refresh.
+#[derive(Resource, Default)]
+pub struct Library {
+    pub entries: Vec<LibraryEntry>,
+    pub picked: Vec<LibraryEntry>,
+    pub maps: Vec<String>,
+    pub(crate) rescan: bool,
+}
+
+impl Library {
+    pub fn group(&self, group: LibraryGroup) -> impl Iterator<Item = &LibraryEntry> {
+        let picked = (group == LibraryGroup::Picked).then_some(self.picked.iter());
+        self.entries
+            .iter()
+            .filter(move |e| e.group == group)
+            .chain(picked.into_iter().flatten())
+    }
+
+    /// Scan files and maps again on the next update.
+    pub fn request_rescan(&mut self) {
+        self.rescan = true;
+    }
+}
+
+pub type PrefabSpawner = Arc<dyn Fn(&mut EntityCommands, &AssetServer) + Send + Sync>;
+
+/// Objects the game offers to the editor. The spawn function receives the prop's entity (which
+/// already has its transform) plus the `AssetServer`, and inserts whatever the object needs:
+/// meshes, scenes, gameplay components, its own colliders.
+#[derive(Resource, Default, Clone)]
+pub struct PrefabRegistry {
+    entries: Vec<(String, PrefabSpawner)>,
+}
+
+impl PrefabRegistry {
+    pub fn register(&mut self, name: impl Into<String>, spawn: impl Fn(&mut EntityCommands, &AssetServer) + Send + Sync + 'static) {
+        let name = name.into();
+        self.entries.retain(|(n, _)| *n != name);
+        self.entries.push((name, Arc::new(spawn)));
+    }
+
+    pub fn get(&self, name: &str) -> Option<&PrefabSpawner> {
+        self.entries.iter().find(|(n, _)| n == name).map(|(_, f)| f)
+    }
+
+    pub fn names(&self) -> impl Iterator<Item = &str> {
+        self.entries.iter().map(|(n, _)| n.as_str())
+    }
+}
+
+pub trait MapEditorAppExt {
+    /// Make one of your game's objects placeable in the editor:
+    ///
+    /// ```ignore
+    /// app.register_prefab("Health pack", |e, assets| {
+    ///     e.insert((HealthPack(25), SceneRoot(assets.load("pickups/health.glb#Scene0"))));
+    /// });
+    /// ```
+    ///
+    /// Maps store only the name, so the object is rebuilt by your code every time a map loads.
+    /// If the spawn function inserts a `Collider` on the entity, the editor won't add its own.
+    fn register_prefab(
+        &mut self,
+        name: impl Into<String>,
+        spawn: impl Fn(&mut EntityCommands, &AssetServer) + Send + Sync + 'static,
+    ) -> &mut Self;
+}
+
+impl MapEditorAppExt for App {
+    fn register_prefab(
+        &mut self,
+        name: impl Into<String>,
+        spawn: impl Fn(&mut EntityCommands, &AssetServer) + Send + Sync + 'static,
+    ) -> &mut Self {
+        self.init_resource::<PrefabRegistry>();
+        self.world_mut().resource_mut::<PrefabRegistry>().register(name, spawn);
+        self
+    }
+}
+
+pub(crate) struct LibraryPlugin;
+
+impl Plugin for LibraryPlugin {
+    fn build(&self, app: &mut App) {
+        app.init_resource::<Library>()
+            .init_resource::<PrefabRegistry>()
+            .add_systems(Startup, |mut library: ResMut<Library>| library.rescan = true)
+            .add_systems(OnEnter(EditorMode::Editing), |mut library: ResMut<Library>| {
+                library.rescan = true
+            })
+            .add_systems(Update, update_library);
+    }
+}
+
+fn update_library(
+    mut library: ResMut<Library>,
+    settings: Res<MapEditorSettings>,
+    mode: Res<State<EditorMode>>,
+    time: Res<Time<Real>>,
+    mut last: Local<f32>,
+    mut files: Local<Vec<LibraryEntry>>,
+    live: LiveAssets,
+) {
+    let now = time.elapsed_secs();
+    let due = *mode.get() == EditorMode::Editing && now - *last > 1.0;
+    if !library.rescan && !due {
+        return;
+    }
+    *last = now;
+    if library.rescan {
+        library.rescan = false;
+        *files = scan_files(&settings.model_extensions, settings.file_folders.as_deref());
+        library.maps = scan_maps();
+    }
+
+    let file_paths: HashSet<&str> = files
+        .iter()
+        .filter_map(|e| match &e.data.source {
+            PropSource::Model(path) => Some(path.as_str()),
+            _ => None,
+        })
+        .collect();
+    let mut entries = live.prefab_entries();
+    entries.extend(files.iter().cloned());
+    if settings.show_loaded {
+        entries.extend(live.loaded_entries(&file_paths));
+    }
+    library.entries = entries;
+}
+
+fn entry(group: LibraryGroup, label: String, hint: String, source: PropSource) -> LibraryEntry {
+    let mut data = PropData::new(source);
+    data.name = label.clone();
+    LibraryEntry { group, label, hint, data }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Files on disk
+
+pub(crate) fn scan_files(extensions: &[String], folders: Option<&[String]>) -> Vec<LibraryEntry> {
+    let root = assets_root();
+    let mut paths = Vec::new();
+    match folders {
+        Some(folders) => {
+            for folder in folders {
+                collect_files(&root, &root.join(folder), 1, extensions, &mut paths);
+            }
+        }
+        None => collect_files(&root, &root, 0, extensions, &mut paths),
+    }
+    paths.sort();
+    paths
+        .into_iter()
+        .map(|path| {
+            let hint = format!("assets/{path}");
+            entry(LibraryGroup::Files, path_stem(&path), hint, PropSource::Model(path))
+        })
+        .collect()
+}
+
+fn collect_files(root: &Path, dir: &Path, depth: usize, extensions: &[String], out: &mut Vec<String>) {
+    if depth > 8 || out.len() > 5000 {
+        return;
+    }
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if path.is_dir() {
+            if depth == 0 && path.file_name().is_some_and(|n| n == "maps") {
+                continue;
+            }
+            collect_files(root, &path, depth + 1, extensions, out);
+        } else if has_extension(&path, extensions)
+            && let Ok(rel) = path.strip_prefix(root)
+        {
+            out.push(rel.to_string_lossy().replace('\\', "/"));
+        }
+    }
+}
+
+fn has_extension(path: &Path, extensions: &[String]) -> bool {
+    let name = path.file_name().map(|n| n.to_string_lossy().to_ascii_lowercase()).unwrap_or_default();
+    // Matches multi-part extensions like "scn.ron" too.
+    extensions.iter().any(|ext| name.ends_with(&format!(".{ext}")))
+}
+
+pub(crate) fn scan_maps() -> Vec<String> {
+    let mut maps: Vec<String> = std::fs::read_dir(maps_dir())
+        .into_iter()
+        .flatten()
+        .flatten()
+        .filter_map(|e| {
+            let name = e.file_name().to_string_lossy().into_owned();
+            name.strip_suffix(".map.json").map(str::to_owned)
+        })
+        .collect();
+    maps.sort();
+    maps
+}
+
+// ---------------------------------------------------------------------------------------------
+// Whatever the running game has loaded
+
+const MAX_LOADED: usize = 5000;
+
+#[derive(SystemParam)]
+pub(crate) struct LiveAssets<'w, 's> {
+    asset_server: Res<'w, AssetServer>,
+    gltfs: Option<Res<'w, Assets<Gltf>>>,
+    gltf_meshes: Option<Res<'w, Assets<GltfMesh>>>,
+    scenes: Option<Res<'w, Assets<Scene>>>,
+    meshes: Res<'w, Assets<Mesh>>,
+    users: Query<
+        'w,
+        's,
+        (&'static Mesh3d, &'static MeshMaterial3d<StandardMaterial>, Option<&'static ChildOf>),
+        Without<Prop>,
+    >,
+    names: Query<'w, 's, &'static Name>,
+    prefabs: Res<'w, PrefabRegistry>,
+}
+
+impl LiveAssets<'_, '_> {
+    fn prefab_entries(&self) -> Vec<LibraryEntry> {
+        self.prefabs
+            .names()
+            .map(|name| {
+                entry(
+                    LibraryGroup::Prefabs,
+                    name.to_string(),
+                    "Registered by the game".into(),
+                    PropSource::Prefab(name.to_string()),
+                )
+            })
+            .collect()
+    }
+
+    fn loaded_entries(&self, files: &HashSet<&str>) -> Vec<LibraryEntry> {
+        let mut out = Vec::new();
+        let server = &self.asset_server;
+
+        // Scenes (any loader). The first scene of a file already listed under "Game files" is skipped.
+        if let Some(scenes) = &self.scenes {
+            for (id, _) in scenes.iter() {
+                let Some(path) = server.get_path(id) else {
+                    continue;
+                };
+                let path = path.to_string();
+                let (base, label) = path.split_once('#').unwrap_or((path.as_str(), ""));
+                if files.contains(base) && (label.is_empty() || label == "Scene0") {
+                    continue;
+                }
+                let name = if label.is_empty() { path_stem(base) } else { format!("{} › {label}", path_stem(base)) };
+                out.push(entry(LibraryGroup::Loaded, name, format!("Scene: {path}"), PropSource::Model(path.clone())));
+            }
+        }
+
+        // Every mesh of glTF files that hold several (levels, kits), each with its own materials.
+        let mut covered: HashSet<String> = HashSet::new();
+        if let (Some(gltfs), Some(gltf_meshes)) = (&self.gltfs, &self.gltf_meshes) {
+            for (id, gltf) in gltfs.iter() {
+                if gltf.meshes.len() < 2 {
+                    continue;
+                }
+                let Some(path) = server.get_path(id) else {
+                    continue;
+                };
+                let base = path.to_string();
+                let base = base.split('#').next().unwrap_or_default().to_string();
+                covered.insert(base.clone());
+                for (i, handle) in gltf.meshes.iter().enumerate() {
+                    let Some(mesh) = gltf_meshes.get(handle) else {
+                        continue;
+                    };
+                    let parts: Option<Vec<MeshPart>> = mesh
+                        .primitives
+                        .iter()
+                        .map(|primitive| {
+                            let mesh_path = server.get_path(primitive.mesh.id())?.to_string();
+                            let material = match &primitive.material {
+                                Some(m) => server.get_path(m.id())?.to_string(),
+                                None => format!("{base}#DefaultMaterial"),
+                            };
+                            Some(MeshPart::new(mesh_path, Some(material), Transform::IDENTITY))
+                        })
+                        .collect();
+                    let Some(parts) = parts.filter(|p| !p.is_empty()) else {
+                        continue;
+                    };
+                    let name = if mesh.name.is_empty() { format!("Mesh{i}") } else { mesh.name.clone() };
+                    let hint = format!("Mesh \"{name}\" in {base}");
+                    out.push(entry(
+                        LibraryGroup::Loaded,
+                        format!("{} › {name}", path_stem(&base)),
+                        hint,
+                        PropSource::Parts(parts),
+                    ));
+                    if out.len() >= MAX_LOADED {
+                        return out;
+                    }
+                }
+            }
+        }
+
+        // The material each mesh is drawn with, and the name of the node drawing it.
+        let mut materials: HashMap<AssetId<Mesh>, String> = HashMap::new();
+        let mut node_names: HashMap<AssetId<Mesh>, String> = HashMap::new();
+        for (mesh, material, parent) in &self.users {
+            if let Some(path) = server.get_path(material.0.id()) {
+                materials.insert(mesh.0.id(), path.to_string());
+            }
+            if let Some(name) = parent.and_then(|p| self.names.get(p.parent()).ok()) {
+                node_names.insert(mesh.0.id(), name.as_str().to_string());
+            }
+        }
+
+        // Games usually load just `level.glb#Scene0`, which lets Bevy drop the `Gltf` asset used
+        // above. Its meshes are still in memory though: group them by glTF mesh (`#MeshN`).
+        let mut gltf_groups: BTreeMap<String, BTreeMap<String, Vec<(String, AssetId<Mesh>)>>> = BTreeMap::new();
+        for (id, _) in self.meshes.iter() {
+            let Some(path) = server.get_path(id) else {
+                continue;
+            };
+            let path = path.to_string();
+            let Some((base, label)) = path.split_once('#') else {
+                continue;
+            };
+            if !is_gltf_path(base) || covered.contains(base) {
+                continue;
+            }
+            let Some(group) = label.split('/').next().filter(|g| g.starts_with("Mesh")) else {
+                continue;
+            };
+            gltf_groups
+                .entry(base.to_string())
+                .or_default()
+                .entry(group.to_string())
+                .or_default()
+                .push((path.clone(), id));
+        }
+        for (base, groups) in gltf_groups {
+            // A single-mesh file is already placeable whole under "Game files".
+            if groups.len() < 2 && files.contains(base.as_str()) {
+                continue;
+            }
+            for (group, mut primitives) in groups {
+                primitives.sort();
+                let name = primitives
+                    .iter()
+                    .find_map(|(_, id)| node_names.get(id).cloned())
+                    .unwrap_or_else(|| group.clone());
+                let parts = primitives
+                    .iter()
+                    .map(|(path, id)| MeshPart::new(path.clone(), materials.get(id).cloned(), Transform::IDENTITY))
+                    .collect();
+                out.push(entry(
+                    LibraryGroup::Loaded,
+                    format!("{} › {name}", path_stem(&base)),
+                    format!("Mesh \"{name}\" in {base}"),
+                    PropSource::Parts(parts),
+                ));
+                if out.len() >= MAX_LOADED {
+                    return out;
+                }
+            }
+        }
+
+        // Meshes from any other loader (custom formats of ported games), with the material the
+        // game draws them with.
+        for (id, _) in self.meshes.iter() {
+            let Some(path) = server.get_path(id) else {
+                continue;
+            };
+            let path = path.to_string();
+            if is_gltf_path(&path) {
+                continue;
+            }
+            let part = MeshPart::new(path.clone(), materials.get(&id).cloned(), Transform::IDENTITY);
+            let label = match path.split_once('#') {
+                Some((base, label)) => format!("{} › {label}", path_stem(base)),
+                None => path_stem(&path),
+            };
+            out.push(entry(LibraryGroup::Loaded, label, format!("Mesh: {path}"), PropSource::Parts(vec![part])));
+            if out.len() >= MAX_LOADED {
+                break;
+            }
+        }
+
+        out.sort_by(|a, b| a.label.cmp(&b.label));
+        out
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Eyedropper: turn an object in the game world into something placeable
+
+#[derive(SystemParam)]
+pub(crate) struct Eyedropper<'w, 's> {
+    asset_server: Res<'w, AssetServer>,
+    parents: Query<'w, 's, &'static ChildOf>,
+    children: Query<'w, 's, &'static Children>,
+    parts: Query<
+        'w,
+        's,
+        (&'static Mesh3d, Option<&'static MeshMaterial3d<StandardMaterial>>, &'static Transform),
+        Without<Prop>,
+    >,
+    names: Query<'w, 's, &'static Name>,
+    globals: Query<'w, 's, &'static GlobalTransform>,
+    scenes: Query<'w, 's, &'static SceneRoot>,
+}
+
+impl Eyedropper<'_, '_> {
+    pub fn pick(&self, entity: Entity) -> Result<LibraryEntry, String> {
+        let Ok((_, _, own_transform)) = self.parts.get(entity) else {
+            return Err("That object has no mesh to copy".into());
+        };
+        let parent = self.parents.get(entity).ok().map(|c| c.parent());
+
+        // glTF splits a mesh into one entity per material, all sharing the node's transform:
+        // take those siblings together so the copy looks the same.
+        let group: Vec<Entity> = parent
+            .and_then(|p| self.children.get(p).ok())
+            .map(|siblings| {
+                siblings
+                    .iter()
+                    .filter(|s| self.parts.get(*s).is_ok_and(|(_, _, t)| t == own_transform))
+                    .collect()
+            })
+            .unwrap_or_else(|| vec![entity]);
+
+        let parts: Option<Vec<MeshPart>> = group
+            .iter()
+            .map(|e| {
+                let (mesh, material, _) = self.parts.get(*e).ok()?;
+                let mesh_path = self.asset_server.get_path(mesh.0.id())?.to_string();
+                let material = material
+                    .and_then(|m| self.asset_server.get_path(m.0.id()))
+                    .map(|p| p.to_string());
+                Some(MeshPart::new(mesh_path, material, Transform::IDENTITY))
+            })
+            .collect();
+
+        let name_of = |e: Entity| self.names.get(e).ok().map(|n| n.as_str().to_string());
+        let (source, name) = match parts {
+            Some(parts) if !parts.is_empty() => {
+                let name = parent
+                    .and_then(name_of)
+                    .or_else(|| name_of(entity))
+                    .unwrap_or_else(|| path_stem(&parts[0].mesh));
+                (PropSource::Parts(parts), name)
+            }
+            _ => {
+                // The mesh has no file of its own; fall back to the scene it belongs to.
+                let scene = std::iter::once(entity)
+                    .chain(self.parents.iter_ancestors(entity))
+                    .find_map(|e| self.scenes.get(e).ok())
+                    .and_then(|root| self.asset_server.get_path(root.0.id()));
+                match scene {
+                    Some(path) => {
+                        let path = path.to_string();
+                        let name = path_stem(&path);
+                        (PropSource::Model(path), name)
+                    }
+                    None => {
+                        return Err("That object's mesh was generated in code, so there's no asset to point \
+                                    to. Register it with app.register_prefab(..) to make it placeable."
+                            .into());
+                    }
+                }
+            }
+        };
+
+        let hint = match &source {
+            PropSource::Parts(parts) => format!("Picked: {}", parts[0].mesh),
+            PropSource::Model(path) => format!("Picked scene: {path}"),
+            _ => String::new(),
+        };
+        let mut picked = entry(LibraryGroup::Picked, name, hint, source);
+        if let Ok(global) = self.globals.get(entity) {
+            picked.data.scale = global.compute_transform().scale.to_array();
+        }
+        Ok(picked)
+    }
+}
diff --git a/crates/skate-map-editor/src/props.rs b/crates/skate-map-editor/src/props.rs
new file mode 100644
index 0000000..644b85f
--- /dev/null
+++ b/crates/skate-map-editor/src/props.rs
@@ -0,0 +1,494 @@
+//! Placeable props: what they are, how they're saved, and how they're spawned with collision.
+
+use std::collections::HashMap;
+
+use bevy::asset::RenderAssetUsages;
+use bevy::ecs::system::SystemParam;
+use bevy::gltf::GltfAssetLabel;
+use bevy::mesh::PrimitiveTopology;
+use bevy::prelude::*;
+use bevy::scene::SceneRoot;
+use serde::{Deserialize, Serialize};
+
+/// Built-in shapes that need no asset files.
+#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Primitive {
+    Cube,
+    Sphere,
+    Cylinder,
+    Capsule,
+    Floor,
+    Wall,
+    Ramp,
+    Stairs,
+    /// A grind rail: a bar on two posts, 3 m long.
+    Rail,
+    /// A grind ledge: a 3 m concrete block.
+    Ledge,
+}
+
+impl Primitive {
+    pub const ALL: [Primitive; 10] = [
+        Primitive::Cube,
+        Primitive::Sphere,
+        Primitive::Cylinder,
+        Primitive::Capsule,
+        Primitive::Floor,
+        Primitive::Wall,
+        Primitive::Ramp,
+        Primitive::Stairs,
+        Primitive::Rail,
+        Primitive::Ledge,
+    ];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Primitive::Cube => "Cube",
+            Primitive::Sphere => "Sphere",
+            Primitive::Cylinder => "Cylinder",
+            Primitive::Capsule => "Capsule",
+            Primitive::Floor => "Floor tile",
+            Primitive::Wall => "Wall",
+            Primitive::Ramp => "Ramp",
+            Primitive::Stairs => "Stairs",
+            Primitive::Rail => "Rail",
+            Primitive::Ledge => "Ledge",
+        }
+    }
+
+    pub fn default_color(self) -> [f32; 4] {
+        match self {
+            Primitive::Floor => [0.55, 0.55, 0.58, 1.0],
+            Primitive::Wall => [0.78, 0.74, 0.68, 1.0],
+            Primitive::Ramp | Primitive::Stairs => [0.62, 0.66, 0.72, 1.0],
+            Primitive::Rail => [0.35, 0.37, 0.4, 1.0],
+            Primitive::Ledge => [0.66, 0.64, 0.6, 1.0],
+            _ => [0.85, 0.85, 0.85, 1.0],
+        }
+    }
+
+    /// The boxes a primitive is built from, (center, size), when it isn't a single shape.
+    /// The game turns these into collision and puts grind lines on them ([`Primitive::grind_lines`]).
+    pub fn boxes(self) -> Vec<(Vec3, Vec3)> {
+        match self {
+            Primitive::Stairs => Self::stair_steps().collect(),
+            // Bar top at y 0.25; posts down to the ground at y -0.25.
+            Primitive::Rail => vec![
+                (Vec3::new(0.0, 0.22, 0.0), Vec3::new(3.0, 0.06, 0.06)),
+                (Vec3::new(-1.2, -0.03, 0.0), Vec3::new(0.05, 0.44, 0.05)),
+                (Vec3::new(1.2, -0.03, 0.0), Vec3::new(0.05, 0.44, 0.05)),
+            ],
+            Primitive::Ledge => vec![(Vec3::ZERO, Vec3::new(3.0, 0.5, 0.6))],
+            _ => Vec::new(),
+        }
+    }
+
+    /// Where a skater can grind this primitive, as line segments in its own space.
+    pub fn grind_lines(self) -> Vec<(Vec3, Vec3)> {
+        match self {
+            // The spline runs along the top centre of the bar.
+            Primitive::Rail => vec![(Vec3::new(-1.5, 0.25, 0.0), Vec3::new(1.5, 0.25, 0.0))],
+            // Both long top edges.
+            Primitive::Ledge => vec![
+                (Vec3::new(-1.5, 0.25, 0.3), Vec3::new(1.5, 0.25, 0.3)),
+                (Vec3::new(1.5, 0.25, -0.3), Vec3::new(-1.5, 0.25, -0.3)),
+            ],
+            _ => Vec::new(),
+        }
+    }
+
+    fn stair_steps() -> impl Iterator<Item = (Vec3, Vec3)> {
+        // Four solid steps, 2m wide, rising 1m over 2m towards -Z. (center, size)
+        (0..4).map(|i| {
+            let h = 0.25 * (i as f32 + 1.0);
+            let center = Vec3::new(0.0, -0.5 + h / 2.0, 0.75 - 0.5 * i as f32);
+            (center, Vec3::new(2.0, h, 0.5))
+        })
+    }
+
+    fn ramp_points() -> [Vec3; 6] {
+        [
+            Vec3::new(-1.0, -0.5, 1.0),  // A
+            Vec3::new(1.0, -0.5, 1.0),   // B
+            Vec3::new(1.0, -0.5, -1.0),  // C
+            Vec3::new(-1.0, -0.5, -1.0), // D
+            Vec3::new(-1.0, 0.5, -1.0),  // E
+            Vec3::new(1.0, 0.5, -1.0),   // F
+        ]
+    }
+}
+
+/// Where a prop comes from.
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+pub enum PropSource {
+    Primitive(Primitive),
+    /// A scene asset path: a glTF/GLB file (`"props/crate.glb"`, first scene), a labelled scene
+    /// (`"levels/city.glb#Scene2"`), or any format your game has a scene loader for.
+    Model(String),
+    /// Meshes the game loaded, by asset path (any format the game can load).
+    Parts(Vec<MeshPart>),
+    /// An object your game registered with [`crate::MapEditorAppExt::register_prefab`].
+    Prefab(String),
+}
+
+/// One mesh of a [`PropSource::Parts`] prop.
+#[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
+pub struct MeshPart {
+    /// Mesh asset path, e.g. `"levels/city.glb#Mesh12/Primitive0"`.
+    pub mesh: String,
+    /// `StandardMaterial` asset path, e.g. `"levels/city.glb#Material3"`. `None` uses the prop color.
+    #[serde(default)]
+    pub material: Option<String>,
+    #[serde(default)]
+    pub translation: [f32; 3],
+    #[serde(default = "identity_rotation")]
+    pub rotation: [f32; 4],
+    #[serde(default = "one_scale")]
+    pub scale: [f32; 3],
+}
+
+fn identity_rotation() -> [f32; 4] {
+    [0.0, 0.0, 0.0, 1.0]
+}
+
+fn one_scale() -> [f32; 3] {
+    [1.0; 3]
+}
+
+impl MeshPart {
+    pub fn new(mesh: String, material: Option<String>, offset: Transform) -> Self {
+        Self {
+            mesh,
+            material,
+            translation: offset.translation.to_array(),
+            rotation: offset.rotation.to_array(),
+            scale: offset.scale.to_array(),
+        }
+    }
+
+    fn transform(&self) -> Transform {
+        Transform {
+            translation: Vec3::from_array(self.translation),
+            rotation: Quat::from_array(self.rotation).normalize(),
+            scale: Vec3::from_array(self.scale),
+        }
+    }
+}
+
+/// File name without folders, extension or `#label`.
+pub(crate) fn path_stem(path: &str) -> String {
+    let file = path.split('#').next().unwrap_or(path);
+    std::path::Path::new(file)
+        .file_stem()
+        .map(|s| s.to_string_lossy().into_owned())
+        .unwrap_or_else(|| path.to_string())
+}
+
+pub(crate) fn is_gltf_path(path: &str) -> bool {
+    let file = path.split('#').next().unwrap_or(path).to_ascii_lowercase();
+    file.ends_with(".glb") || file.ends_with(".gltf")
+}
+
+impl PropSource {
+    pub fn label(&self) -> String {
+        match self {
+            PropSource::Primitive(p) => p.label().to_string(),
+            PropSource::Model(path) => path_stem(path),
+            PropSource::Parts(parts) => parts.first().map(|p| path_stem(&p.mesh)).unwrap_or_default(),
+            PropSource::Prefab(name) => name.clone(),
+        }
+    }
+}
+
+/// How a prop collides.
+#[derive(Serialize, Deserialize, Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum CollisionKind {
+    /// No collision: decoration only.
+    None,
+    /// Exact shape. Primitives use their matching collider; models use a triangle mesh.
+    #[default]
+    Solid,
+    /// Convex hull around the model. Cheaper than `Solid`, but fills in holes and doorways.
+    ConvexHull,
+}
+
+impl CollisionKind {
+    pub fn label(self) -> &'static str {
+        match self {
+            CollisionKind::None => "None",
+            CollisionKind::Solid => "Solid (exact)",
+            CollisionKind::ConvexHull => "Convex hull",
+        }
+    }
+}
+
+/// Marks an entity placed by the map editor. Everything with this component is saved in the map.
+#[derive(Component, Clone, Debug)]
+pub struct Prop {
+    pub name: String,
+    pub source: PropSource,
+    pub color: [f32; 4],
+    pub collision: CollisionKind,
+}
+
+/// One prop as stored in a map file.
+#[derive(Serialize, Deserialize, Clone, Debug)]
+pub struct PropData {
+    pub name: String,
+    pub source: PropSource,
+    pub translation: [f32; 3],
+    pub rotation: [f32; 4],
+    pub scale: [f32; 3],
+    #[serde(default = "white")]
+    pub color: [f32; 4],
+    #[serde(default)]
+    pub collision: CollisionKind,
+}
+
+fn white() -> [f32; 4] {
+    [1.0; 4]
+}
+
+impl PropData {
+    pub fn new(source: PropSource) -> Self {
+        let color = match &source {
+            PropSource::Primitive(p) => p.default_color(),
+            _ => white(),
+        };
+        Self {
+            name: source.label(),
+            source,
+            translation: [0.0; 3],
+            rotation: [0.0, 0.0, 0.0, 1.0],
+            scale: [1.0; 3],
+            color,
+            collision: CollisionKind::Solid,
+        }
+    }
+
+    pub fn from_prop(prop: &Prop, transform: &Transform) -> Self {
+        Self {
+            name: prop.name.clone(),
+            source: prop.source.clone(),
+            translation: transform.translation.to_array(),
+            rotation: transform.rotation.to_array(),
+            scale: transform.scale.to_array(),
+            color: prop.color,
+            collision: prop.collision,
+        }
+    }
+
+    pub fn transform(&self) -> Transform {
+        Transform {
+            translation: Vec3::from_array(self.translation),
+            rotation: Quat::from_array(self.rotation).normalize(),
+            scale: Vec3::from_array(self.scale),
+        }
+    }
+
+    pub fn set_transform(&mut self, t: &Transform) {
+        self.translation = t.translation.to_array();
+        self.rotation = t.rotation.to_array();
+        self.scale = t.scale.to_array();
+    }
+
+    fn to_prop(&self) -> Prop {
+        Prop {
+            name: self.name.clone(),
+            source: self.source.clone(),
+            color: self.color,
+            collision: self.collision,
+        }
+    }
+}
+
+/// A saved map (`assets/maps/<name>.map.json`).
+#[derive(Serialize, Deserialize, Default, Clone, Debug)]
+pub struct MapFile {
+    pub version: u32,
+    pub props: Vec<PropData>,
+}
+
+/// Triggered on every prop the editor spawns (placed, duplicated, undone or loaded from a map).
+///
+/// The game observes this to give props colliders in its own physics:
+/// `app.add_observer(|ev: On<PropSpawned>, props: Query<&Prop>, mut commands: Commands| { ... })`
+#[derive(EntityEvent, Clone, Copy, Debug)]
+pub struct PropSpawned {
+    pub entity: Entity,
+}
+
+/// The preview that follows the cursor while placing. Not saved, no collision.
+#[derive(Component)]
+pub struct Ghost;
+
+/// The material of a primitive prop, so its color can be edited live.
+#[derive(Component)]
+pub(crate) struct PropMaterial(pub Handle<StandardMaterial>);
+
+#[derive(Resource)]
+pub(crate) struct PrimitiveMeshes {
+    shapes: HashMap<Primitive, Handle<Mesh>>,
+    /// Primitives made of several boxes (stairs, rail, ledge).
+    boxes: HashMap<Primitive, Vec<(Vec3, Handle<Mesh>)>>,
+}
+
+impl FromWorld for PrimitiveMeshes {
+    fn from_world(world: &mut World) -> Self {
+        let mut meshes = world.resource_mut::<Assets<Mesh>>();
+        let mut shapes = HashMap::new();
+        shapes.insert(Primitive::Cube, meshes.add(Cuboid::new(1.0, 1.0, 1.0)));
+        shapes.insert(Primitive::Sphere, meshes.add(Sphere::new(0.5).mesh().uv(32, 18)));
+        shapes.insert(Primitive::Cylinder, meshes.add(Cylinder::new(0.5, 1.0)));
+        shapes.insert(Primitive::Capsule, meshes.add(Capsule3d::new(0.5, 1.0)));
+        shapes.insert(Primitive::Floor, meshes.add(Cuboid::new(4.0, 0.1, 4.0)));
+        shapes.insert(Primitive::Wall, meshes.add(Cuboid::new(4.0, 3.0, 0.2)));
+        shapes.insert(Primitive::Ramp, meshes.add(ramp_mesh()));
+        let boxes = Primitive::ALL
+            .into_iter()
+            .filter(|p| !p.boxes().is_empty())
+            .map(|p| {
+                let parts = p.boxes().into_iter().map(|(center, size)| (center, meshes.add(Cuboid::from_size(size)))).collect();
+                (p, parts)
+            })
+            .collect();
+        Self { shapes, boxes }
+    }
+}
+
+fn ramp_mesh() -> Mesh {
+    let [a, b, c, d, e, f] = Primitive::ramp_points();
+    let tris = [
+        [a, d, c],
+        [a, c, b], // bottom
+        [d, e, f],
+        [d, f, c], // back
+        [a, b, f],
+        [a, f, e], // slope
+        [a, e, d], // left
+        [b, c, f], // right
+    ];
+    let mut positions = Vec::new();
+    let mut normals = Vec::new();
+    let mut uvs = Vec::new();
+    for [p0, p1, p2] in tris {
+        let n = (p1 - p0).cross(p2 - p0).normalize();
+        for p in [p0, p1, p2] {
+            positions.push(p.to_array());
+            normals.push(n.to_array());
+            uvs.push([p.x * 0.5 + 0.5, p.z * 0.5 + 0.5]);
+        }
+    }
+    Mesh::new(PrimitiveTopology::TriangleList, RenderAssetUsages::default())
+        .with_inserted_attribute(Mesh::ATTRIBUTE_POSITION, positions)
+        .with_inserted_attribute(Mesh::ATTRIBUTE_NORMAL, normals)
+        .with_inserted_attribute(Mesh::ATTRIBUTE_UV_0, uvs)
+}
+
+/// Spawns props from [`PropData`].
+#[derive(SystemParam)]
+pub(crate) struct PropSpawner<'w, 's> {
+    pub commands: Commands<'w, 's>,
+    pub materials: ResMut<'w, Assets<StandardMaterial>>,
+    asset_server: Res<'w, AssetServer>,
+    meshes: Res<'w, PrimitiveMeshes>,
+    prefabs: Res<'w, crate::library::PrefabRegistry>,
+}
+
+impl PropSpawner<'_, '_> {
+    pub fn spawn(&mut self, data: &PropData, ghost: bool) -> Entity {
+        let prop = data.to_prop();
+        let mut entity = self.commands.spawn((
+            Name::new(format!("Prop: {}", data.name)),
+            prop.clone(),
+            data.transform(),
+            Visibility::default(),
+        ));
+
+        match &data.source {
+            PropSource::Primitive(primitive) => {
+                let [r, g, b, a] = data.color;
+                let material = self.materials.add(StandardMaterial {
+                    base_color: Color::srgba(r, g, b, a),
+                    perceptual_roughness: 0.85,
+                    alpha_mode: if a < 1.0 { AlphaMode::Blend } else { AlphaMode::Opaque },
+                    ..default()
+                });
+                entity.insert(PropMaterial(material.clone()));
+                if let Some(parts) = self.meshes.boxes.get(primitive) {
+                    let parts = parts.clone();
+                    entity.with_children(|parent| {
+                        for (center, mesh) in parts {
+                            parent.spawn((
+                                Mesh3d(mesh),
+                                MeshMaterial3d(material.clone()),
+                                Transform::from_translation(center),
+                            ));
+                        }
+                    });
+                } else {
+                    entity.insert((
+                        Mesh3d(self.meshes.shapes[primitive].clone()),
+                        MeshMaterial3d(material),
+                    ));
+                }
+            }
+            PropSource::Model(path) => {
+                let scene = if is_gltf_path(path) && !path.contains('#') {
+                    self.asset_server.load(GltfAssetLabel::Scene(0).from_asset(path.clone()))
+                } else {
+                    self.asset_server.load(path.clone())
+                };
+                entity.insert(SceneRoot(scene));
+            }
+            PropSource::Parts(parts) => {
+                let [r, g, b, a] = data.color;
+                let fallback = self.materials.add(StandardMaterial {
+                    base_color: Color::srgba(r, g, b, a),
+                    perceptual_roughness: 0.85,
+                    ..default()
+                });
+                let parts: Vec<_> = parts
+                    .iter()
+                    .map(|part| {
+                        let material = match &part.material {
+                            Some(path) => self.asset_server.load(path.clone()),
+                            None => fallback.clone(),
+                        };
+                        (self.asset_server.load::<Mesh>(part.mesh.clone()), material, part.transform())
+                    })
+                    .collect();
+                if parts.iter().any(|(_, m, _)| *m == fallback) {
+                    entity.insert(PropMaterial(fallback));
+                }
+                entity.with_children(|parent| {
+                    for (mesh, material, transform) in parts {
+                        parent.spawn((Mesh3d(mesh), MeshMaterial3d(material), transform));
+                    }
+                });
+            }
+            PropSource::Prefab(name) => match self.prefabs.get(name) {
+                Some(spawn) => spawn(&mut entity, &self.asset_server),
+                None => warn!("map editor: no prefab named {name:?} is registered"),
+            },
+        }
+
+        if ghost {
+            entity.insert(Ghost);
+        }
+
+        let id = entity.id();
+        if !ghost {
+            self.commands.trigger(PropSpawned { entity: id });
+        }
+        id
+    }
+}
+
+pub(crate) struct PropsPlugin;
+
+impl Plugin for PropsPlugin {
+    fn build(&self, app: &mut App) {
+        app.init_resource::<PrimitiveMeshes>();
+    }
+}
diff --git a/crates/skate-map-editor/src/ui.rs b/crates/skate-map-editor/src/ui.rs
new file mode 100644
index 0000000..b6d49b9
--- /dev/null
+++ b/crates/skate-map-editor/src/ui.rs
@@ -0,0 +1,409 @@
+//! The editor overlay: toolbar, asset browser, inspector, scene list and status bar.
+
+use bevy::prelude::*;
+use bevy_egui::{EguiContext, egui};
+use egui::{LayerId, Ui, UiBuilder};
+
+use crate::camera::EditorUiCamera;
+use crate::editor::{EditorAction, EditorState};
+use crate::library::{Library, LibraryGroup};
+use crate::props::{CollisionKind, Ghost, Primitive, Prop, PropData, PropMaterial, PropSource};
+use crate::{EditorMode, MapEditorSettings, MapEditorUiPass, editor_open};
+
+pub(crate) struct EditorUiPlugin;
+
+impl Plugin for EditorUiPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_systems(MapEditorUiPass, editor_ui.run_if(editor_open));
+    }
+}
+
+#[derive(Default)]
+struct UiLocal {
+    search: String,
+    uniform_scale: bool,
+}
+
+const HINTS: &str = "Hold RMB: look + WASD fly, Q/E down/up, Shift fast, wheel = speed  •  Wheel: dolly  •  MMB: pan  •  \
+LMB: select / drag  •  G grab  •  R / Shift+R rotate  •  Arrows, PgUp/PgDn nudge  •  End drop to ground  •  \
+F focus  •  Del delete  •  Ctrl+D duplicate  •  Ctrl+Z / Ctrl+Y undo/redo  •  Ctrl+S save";
+
+#[allow(clippy::too_many_arguments)]
+fn editor_ui(
+    mut egui_ctx: Single<&mut EguiContext, With<EditorUiCamera>>,
+    mut state: ResMut<EditorState>,
+    mut settings: ResMut<MapEditorSettings>,
+    props: Query<(Entity, &Prop, &Transform, Has<PropMaterial>), Without<Ghost>>,
+    library: Res<Library>,
+    mut actions: MessageWriter<EditorAction>,
+    mut next_mode: ResMut<NextState<EditorMode>>,
+    mut local: Local<UiLocal>,
+) {
+    let ctx = egui_ctx.get_mut().clone();
+    let mut root = Ui::new(
+        ctx.clone(),
+        "map_editor_root".into(),
+        UiBuilder::new()
+            .layer_id(LayerId::background())
+            .max_rect(ctx.viewport_rect()),
+    );
+
+    // ---- Toolbar ---------------------------------------------------------------------------
+    let top = egui::TopBottomPanel::top("map_editor_toolbar").show_inside(&mut root, |ui| {
+        ui.horizontal_wrapped(|ui| {
+            ui.strong("🗺 MAP EDITOR");
+            if ui
+                .button(format!("▶ Back to game ({:?})", settings.toggle_key))
+                .clicked()
+            {
+                next_mode.set(EditorMode::Playing);
+            }
+            ui.separator();
+
+            ui.label("Map:");
+            ui.add(egui::TextEdit::singleline(&mut state.map_name).desired_width(120.0));
+            if ui.button("💾 Save").clicked() {
+                actions.write(EditorAction::Save(state.map_name.clone()));
+            }
+            egui::ComboBox::from_id_salt("map_editor_load")
+                .selected_text("📂 Load")
+                .show_ui(ui, |ui| {
+                    if library.maps.is_empty() {
+                        ui.label("No saved maps yet");
+                    }
+                    for map in library.maps.clone() {
+                        if ui.selectable_label(false, &map).clicked() {
+                            actions.write(EditorAction::Load(map));
+                        }
+                    }
+                });
+            if ui.button("🗋 New").clicked() {
+                actions.write(EditorAction::NewMap);
+            }
+            ui.separator();
+
+            if ui
+                .add_enabled(!state.undo.is_empty(), egui::Button::new("↶ Undo"))
+                .clicked()
+            {
+                actions.write(EditorAction::Undo);
+            }
+            if ui
+                .add_enabled(!state.redo.is_empty(), egui::Button::new("↷ Redo"))
+                .clicked()
+            {
+                actions.write(EditorAction::Redo);
+            }
+            ui.separator();
+
+            ui.checkbox(&mut settings.snap_enabled, "Snap");
+            ui.add(
+                egui::DragValue::new(&mut settings.grid_size)
+                    .speed(0.05)
+                    .range(0.05..=50.0)
+                    .prefix("grid "),
+            );
+            ui.add(
+                egui::DragValue::new(&mut settings.rotate_step_deg)
+                    .speed(1.0)
+                    .range(1.0..=180.0)
+                    .prefix("rot ")
+                    .suffix("°"),
+            );
+            ui.checkbox(&mut settings.show_grid, "Grid");
+            ui.add(
+                egui::DragValue::new(&mut settings.camera_speed)
+                    .speed(0.2)
+                    .range(0.5..=500.0)
+                    .prefix("cam speed "),
+            );
+            ui.checkbox(&mut settings.pause_game, "Pause game")
+                .on_hover_text("Freeze game time while the editor is open (applies next time you open it)");
+        });
+    });
+
+    // ---- Status bar ------------------------------------------------------------------------
+    let bottom = egui::TopBottomPanel::bottom("map_editor_status").show_inside(&mut root, |ui| {
+        ui.label(egui::RichText::new(&state.status).strong());
+        ui.label(egui::RichText::new(HINTS).small().weak());
+    });
+
+    // ---- Asset browser ---------------------------------------------------------------------
+    let left = egui::SidePanel::left("map_editor_assets")
+        .resizable(true)
+        .default_width(260.0)
+        .show_inside(&mut root, |ui| {
+            ui.horizontal(|ui| {
+                ui.heading("Assets");
+                if ui.small_button("⟳").on_hover_text("Rescan the game's assets").clicked() {
+                    actions.write(EditorAction::RefreshLibrary);
+                }
+            });
+            ui.label(
+                egui::RichText::new("Drag into the world, or click then click where it goes.")
+                    .small()
+                    .weak(),
+            );
+            let pick = ui
+                .add(egui::Button::new("🎯 Pick from game").selected(state.picking))
+                .on_hover_text("Click any object in the game world to place copies of it");
+            if pick.clicked() {
+                actions.write(if state.picking { EditorAction::CancelPlace } else { EditorAction::StartPicking });
+            }
+            ui.add(egui::TextEdit::singleline(&mut local.search).hint_text("🔍 Search"));
+            let search = local.search.to_lowercase();
+            let matches = |label: &str, hint: &str| {
+                search.is_empty() || label.to_lowercase().contains(&search) || hint.to_lowercase().contains(&search)
+            };
+            ui.separator();
+
+            egui::ScrollArea::vertical().show(ui, |ui| {
+                egui::CollapsingHeader::new("Primitives").default_open(true).show(ui, |ui| {
+                    ui.horizontal_wrapped(|ui| {
+                        for primitive in Primitive::ALL {
+                            if matches(primitive.label(), "") {
+                                let data = PropData::new(PropSource::Primitive(primitive));
+                                asset_tile(ui, primitive.label(), "Built-in shape with collision", data, &mut actions);
+                            }
+                        }
+                    });
+                });
+
+                for group in [LibraryGroup::Prefabs, LibraryGroup::Picked, LibraryGroup::Files, LibraryGroup::Loaded] {
+                    let entries: Vec<_> = library.group(group).filter(|e| matches(&e.label, &e.hint)).collect();
+                    let total = library.group(group).count();
+                    if total == 0 && group != LibraryGroup::Files {
+                        continue;
+                    }
+                    let open = group != LibraryGroup::Loaded || !search.is_empty();
+                    egui::CollapsingHeader::new(format!("{} ({total})", group.title()))
+                        .id_salt(group.title())
+                        .default_open(open)
+                        .show(ui, |ui| {
+                            if total == 0 {
+                                ui.label(
+                                    egui::RichText::new(
+                                        "No scene files in the game's assets folder. Drop .glb/.gltf files on the window to import.",
+                                    )
+                                    .small()
+                                    .weak(),
+                                );
+                            }
+                            const SHOWN: usize = 300;
+                            ui.horizontal_wrapped(|ui| {
+                                for entry in entries.iter().take(SHOWN) {
+                                    asset_tile(ui, &entry.label, &entry.hint, entry.data.clone(), &mut actions);
+                                }
+                            });
+                            if entries.len() > SHOWN {
+                                ui.label(
+                                    egui::RichText::new(format!("{} more: search to narrow down", entries.len() - SHOWN))
+                                        .small()
+                                        .weak(),
+                                );
+                            }
+                        });
+                }
+            });
+        });
+
+    // ---- Inspector + scene list ------------------------------------------------------------
+    let right = egui::SidePanel::right("map_editor_inspector")
+        .resizable(true)
+        .default_width(280.0)
+        .show_inside(&mut root, |ui| {
+            ui.heading("Inspector");
+            match state.selected.and_then(|e| props.get(e).ok()) {
+                Some((entity, prop, transform, has_color)) => {
+                    inspector(ui, entity, prop, transform, has_color, &mut local.uniform_scale, &mut actions)
+                }
+                None => {
+                    ui.label(egui::RichText::new("Nothing selected. Click a prop in the world.").weak());
+                }
+            }
+
+            ui.separator();
+            ui.heading(format!("Scene ({} props)", props.iter().len()));
+            egui::ScrollArea::vertical()
+                .id_salt("map_editor_scene_list")
+                .show(ui, |ui| {
+                    let mut list: Vec<_> = props.iter().collect();
+                    list.sort_by_key(|(e, ..)| *e);
+                    for (entity, prop, ..) in list {
+                        let selected = state.selected == Some(entity);
+                        if ui.selectable_label(selected, &prop.name).clicked() {
+                            actions.write(EditorAction::Select(Some(entity)));
+                        }
+                    }
+                });
+        });
+
+    // ---- Where is the mouse? ---------------------------------------------------------------
+    let rects = [top.response.rect, bottom.response.rect, left.response.rect, right.response.rect];
+    let pointer = ctx.input(|i| i.pointer.latest_pos());
+    state.pointer_over_ui = pointer.is_some_and(|p| {
+        rects.iter().any(|r| r.contains(p))
+            || ctx.layer_id_at(p).is_some_and(|layer| layer.order != egui::Order::Background)
+    });
+    state.wants_keyboard = ctx.wants_keyboard_input();
+
+    if state.placing.as_ref().is_some_and(|p| p.from_drag) {
+        ctx.set_cursor_icon(egui::CursorIcon::Grabbing);
+    }
+}
+
+fn asset_tile(
+    ui: &mut Ui,
+    label: &str,
+    hover: &str,
+    data: PropData,
+    actions: &mut MessageWriter<EditorAction>,
+) {
+    let response = ui
+        .add_sized([108.0, 30.0], egui::Button::new(label).truncate())
+        .interact(egui::Sense::click_and_drag())
+        .on_hover_text(hover);
+    if response.drag_started() {
+        actions.write(EditorAction::BeginPlace { data, from_drag: true });
+    } else if response.clicked() {
+        actions.write(EditorAction::BeginPlace { data, from_drag: false });
+    }
+}
+
+fn inspector(
+    ui: &mut Ui,
+    entity: Entity,
+    prop: &Prop,
+    transform: &Transform,
+    has_color: bool,
+    uniform_scale: &mut bool,
+    actions: &mut MessageWriter<EditorAction>,
+) {
+    let mut name = prop.name.clone();
+    ui.horizontal(|ui| {
+        ui.label("Name");
+        if ui.text_edit_singleline(&mut name).changed() {
+            actions.write(EditorAction::Rename(entity, name.clone()));
+        }
+    });
+    let source = match &prop.source {
+        PropSource::Primitive(p) => format!("Primitive: {}", p.label()),
+        PropSource::Model(path) => format!("Scene: {path}"),
+        PropSource::Parts(parts) => match parts.as_slice() {
+            [one] => format!("Mesh: {}", one.mesh),
+            many => format!("{} meshes: {}", many.len(), many[0].mesh),
+        },
+        PropSource::Prefab(name) => format!("Game prefab: {name}"),
+    };
+    ui.label(egui::RichText::new(source).small().weak());
+    ui.add_space(4.0);
+
+    let mut t = *transform;
+    let mut changed = false;
+    let mut begin = false;
+    let mut track = |r: egui::Response| {
+        if r.drag_started() || (r.changed() && !r.dragged()) {
+            begin = true;
+        }
+        changed |= r.changed();
+    };
+
+    egui::Grid::new("map_editor_transform").num_columns(4).show(ui, |ui| {
+        ui.label("Position");
+        for (i, axis) in ["x ", "y ", "z "].into_iter().enumerate() {
+            track(ui.add(egui::DragValue::new(&mut t.translation[i]).speed(0.05).prefix(axis).max_decimals(3)));
+        }
+        ui.end_row();
+
+        ui.label("Rotation");
+        let (yaw, pitch, roll) = t.rotation.to_euler(EulerRot::YXZ);
+        let mut deg = [pitch.to_degrees(), yaw.to_degrees(), roll.to_degrees()];
+        let mut rot_changed = false;
+        for (i, axis) in ["x ", "y ", "z "].into_iter().enumerate() {
+            let r = ui.add(egui::DragValue::new(&mut deg[i]).speed(1.0).prefix(axis).suffix("°").max_decimals(1));
+            rot_changed |= r.changed();
+            track(r);
+        }
+        if rot_changed {
+            t.rotation = Quat::from_euler(
+                EulerRot::YXZ,
+                deg[1].to_radians(),
+                deg[0].to_radians(),
+                deg[2].to_radians(),
+            );
+        }
+        ui.end_row();
+
+        ui.label("Scale");
+        if *uniform_scale {
+            let mut s = t.scale.x;
+            let r = ui.add(egui::DragValue::new(&mut s).speed(0.02).range(0.01..=1000.0).max_decimals(3));
+            if r.changed() {
+                t.scale = Vec3::splat(s);
+            }
+            track(r);
+        } else {
+            for (i, axis) in ["x ", "y ", "z "].into_iter().enumerate() {
+                track(ui.add(
+                    egui::DragValue::new(&mut t.scale[i]).speed(0.02).range(0.01..=1000.0).prefix(axis).max_decimals(3),
+                ));
+            }
+        }
+        ui.end_row();
+    });
+    ui.checkbox(uniform_scale, "Uniform scale");
+
+    if changed {
+        if begin {
+            actions.write(EditorAction::PushUndo);
+        }
+        actions.write(EditorAction::SetTransform(entity, t));
+    }
+
+    ui.add_space(4.0);
+    if has_color {
+        ui.horizontal(|ui| {
+            ui.label("Color");
+            let mut color = prop.color;
+            if ui.color_edit_button_rgba_unmultiplied(&mut color).changed() {
+                actions.write(EditorAction::SetColor(entity, color));
+            }
+        });
+    }
+
+    ui.horizontal(|ui| {
+        ui.label("Collision");
+        let kinds: &[CollisionKind] = match prop.source {
+            PropSource::Primitive(_) => &[CollisionKind::None, CollisionKind::Solid],
+            _ => &[CollisionKind::None, CollisionKind::Solid, CollisionKind::ConvexHull],
+        };
+        egui::ComboBox::from_id_salt("map_editor_collision")
+            .selected_text(prop.collision.label())
+            .show_ui(ui, |ui| {
+                for &kind in kinds {
+                    if ui.selectable_label(prop.collision == kind, kind.label()).clicked()
+                        && kind != prop.collision
+                    {
+                        actions.write(EditorAction::PushUndo);
+                        actions.write(EditorAction::SetCollision(entity, kind));
+                    }
+                }
+            });
+    });
+
+    ui.add_space(4.0);
+    ui.horizontal_wrapped(|ui| {
+        if ui.button("Focus (F)").clicked() {
+            actions.write(EditorAction::Focus);
+        }
+        if ui.button("Duplicate").clicked() {
+            actions.write(EditorAction::Duplicate);
+        }
+        if ui.button("Drop to ground").clicked() {
+            actions.write(EditorAction::DropToGround);
+        }
+        if ui.button("🗑 Delete").clicked() {
+            actions.write(EditorAction::Delete);
+        }
+    });
+}
