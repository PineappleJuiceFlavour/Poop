diff --git a/crates/skate-game/src/map_editor.rs b/crates/skate-game/src/map_editor.rs
new file mode 100644
index 0000000..a72a25c
--- /dev/null
+++ b/crates/skate-game/src/map_editor.rs
@@ -0,0 +1,119 @@
+//! In-game map editor (F1): fly around, drag props into the world, save.
+//!
+//! Each map has its own layout in `editor_maps/<map name>.map.json` beside the
+//! data folder. It loads when the map does, and Ctrl+S saves it. Placed props
+//! are solid for the skater (`modding::editor_solids`).
+use bevy::prelude::*;
+use skate_map_editor::{EditorAction, EditorCamera, EditorMode, MapEditorPlugin, editor_closed, maps_dir};
+
+pub(crate) struct MapEditorIntegration;
+
+impl Plugin for MapEditorIntegration {
+    fn build(&self, app: &mut App) {
+        let asset_root = app.world().resource::<crate::config::Config>().asset_root.clone();
+        // Resolved the way Bevy resolves `AssetPlugin::file_path`.
+        let asset_root = bevy::asset::io::file::FileAssetReader::get_base_path().join(asset_root);
+        let maps = asset_root.parent().unwrap_or(&asset_root).join("editor_maps");
+        app.add_plugins(MapEditorPlugin {
+            assets_dir: Some(asset_root),
+            maps_dir: Some(maps),
+            ..default()
+        });
+        // The editor's UI is the only egui in the game; keep egui off the game's own cameras.
+        app.world_mut().resource_mut::<bevy_egui::EguiGlobalSettings>().auto_create_primary_context = false;
+        app
+            // The pause menu owns Escape and unpauses game time every frame it is closed.
+            .configure_sets(PreUpdate, crate::graphics_menu::MenuInput.run_if(editor_closed))
+            .add_systems(PostStartup, render_like_gameplay_camera)
+            .add_systems(OnEnter(EditorMode::Editing), render_like_gameplay_camera)
+            .add_systems(Update, layout_per_map);
+    }
+}
+
+/// The game draws its 3D view into an offscreen image (the internal resolution)
+/// with its own tone mapping, and a 2D camera puts that image on screen. The
+/// editor's view goes through exactly the same path.
+#[allow(clippy::type_complexity)]
+fn render_like_gameplay_camera(
+    mut commands: Commands,
+    game: Query<
+        (
+            &Camera,
+            Option<&bevy::camera::RenderTarget>,
+            Option<&Msaa>,
+            Option<&bevy::core_pipeline::tonemapping::Tonemapping>,
+            Has<bevy::render::view::Hdr>,
+            Has<crate::retail_render::RetailTone>,
+        ),
+        (With<crate::camera::GameplayCamera>, Without<EditorCamera>),
+    >,
+    editor: Single<(Entity, &Camera), With<EditorCamera>>,
+) {
+    let Some((game_camera, target, msaa, tonemapping, hdr, tone)) = game.iter().next() else {
+        return;
+    };
+    let (entity, editor_camera) = *editor;
+    let mut editor = commands.entity(entity);
+    // Draw before the 2D camera that shows the image, like the gameplay camera does.
+    editor.insert(Camera { order: game_camera.order, is_active: editor_camera.is_active, ..default() });
+    if let Some(target) = target {
+        editor.insert(target.clone());
+    }
+    if let Some(msaa) = msaa {
+        editor.insert(*msaa);
+    }
+    if let Some(tonemapping) = tonemapping {
+        editor.insert(*tonemapping);
+    }
+    if hdr {
+        editor.insert(bevy::render::view::Hdr);
+    } else {
+        editor.remove::<bevy::render::view::Hdr>();
+    }
+    if tone {
+        editor.insert(crate::retail_render::RetailTone);
+    } else {
+        editor.remove::<crate::retail_render::RetailTone>();
+    }
+}
+
+/// Load the layout saved for each map as the map loads, and save under its name.
+fn layout_per_map(
+    map: Res<crate::map_transition::CurrentMap>,
+    mut seen: Local<Option<u64>>,
+    mut actions: MessageWriter<EditorAction>,
+) {
+    if *seen == Some(map.generation) {
+        return;
+    }
+    *seen = Some(map.generation);
+    let name = layout_name(&map.name);
+    if maps_dir().join(format!("{name}.map.json")).is_file() {
+        actions.write(EditorAction::Load(name));
+    } else {
+        actions.write(EditorAction::NewMap);
+        actions.write(EditorAction::SetMapName(name));
+    }
+}
+
+/// A file name for a map: letters, digits, `-` and `_`.
+fn layout_name(map: &str) -> String {
+    let name: String = map
+        .trim()
+        .chars()
+        .map(|c| if c.is_ascii_alphanumeric() || c == '-' || c == '_' { c.to_ascii_lowercase() } else { '_' })
+        .collect();
+    if name.trim_matches('_').is_empty() { "map".into() } else { name }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::layout_name;
+
+    #[test]
+    fn map_names_become_safe_file_names() {
+        assert_eq!(layout_name("University"), "university");
+        assert_eq!(layout_name("Port Carverton / Downtown"), "port_carverton___downtown");
+        assert_eq!(layout_name("../.."), "map");
+    }
+}
diff --git a/crates/skate-game/src/modding/editor_solids.rs b/crates/skate-game/src/modding/editor_solids.rs
new file mode 100644
index 0000000..416217d
--- /dev/null
+++ b/crates/skate-game/src/modding/editor_solids.rs
@@ -0,0 +1,382 @@
+//! Map editor props are solid for the skater. Each prop becomes one static body
+//! in the mod dynamics world, which `bridge::push_dynamics_into_boardworld`
+//! already feeds into the board's world queries (and Rapier mod objects).
+//!
+//! Primitives get one convex part per mesh (all their meshes are convex).
+//! Models get the same render-mesh decomposition as mod `Shape::Model`
+//! bodies, so doorways and arches stay open. Cooking runs off the main thread.
+use super::Mods;
+use bevy::prelude::*;
+use bevy::tasks::{AsyncComputeTaskPool, Task, futures::check_ready};
+use skate_dynamics::{BodyDesc, BodyType, ModelColliderOptions, Shape, model, rapier3d};
+use skate_map_editor::{CollisionKind, Ghost, Prop, PropSource};
+use std::collections::HashMap;
+
+/// A prop must keep the same shape this many frames before it is (re)cooked,
+/// so dragging a scale slider does not decompose the mesh every frame.
+const SETTLE_FRAMES: u32 = 10;
+
+pub(super) fn install(app: &mut App) {
+    app.init_resource::<Solids>().add_systems(Update, (forget_removed, sync_solids).chain());
+}
+
+#[derive(Resource, Default)]
+struct Solids {
+    generation: u64,
+    bodies: HashMap<Entity, u64>,
+}
+
+/// What a prop's collider was built from. A different key needs a new shape.
+#[derive(Clone, PartialEq, Debug)]
+struct ShapeKey {
+    collision: CollisionKind,
+    scale: [i32; 3],
+    meshes: Vec<AssetId<Mesh>>,
+}
+
+#[derive(Component)]
+struct EditorSolid {
+    key: ShapeKey,
+    shape: Option<Shape>,
+    pose: ([f32; 3], [f32; 4]),
+}
+
+#[derive(Component)]
+struct Pending {
+    key: ShapeKey,
+    frames: u32,
+    task: Option<Task<Shape>>,
+}
+
+fn forget_removed(mut removed: RemovedComponents<Prop>, mut solids: ResMut<Solids>, mut mods: ResMut<Mods>) {
+    for entity in removed.read() {
+        if let Some(id) = solids.bodies.remove(&entity) {
+            mods.world.remove(id);
+        }
+    }
+}
+
+#[allow(clippy::type_complexity)]
+fn sync_solids(
+    mut commands: Commands,
+    mut solids: ResMut<Solids>,
+    mut mods: ResMut<Mods>,
+    map: Res<crate::map_transition::CurrentMap>,
+    mut props: Query<(Entity, &Prop, &GlobalTransform, Option<&mut EditorSolid>, Option<&mut Pending>), Without<Ghost>>,
+    children: Query<&Children>,
+    parts: Query<(&Mesh3d, &GlobalTransform)>,
+    meshes: Res<Assets<Mesh>>,
+    asset_server: Res<AssetServer>,
+) {
+    // A new map clears the mod world; every prop needs its body again.
+    if solids.generation != map.generation {
+        solids.generation = map.generation;
+        solids.bodies.clear();
+    }
+
+    for (entity, prop, global, solid, pending) in &mut props {
+        let (scale, rotation, translation) = global.to_scale_rotation_translation();
+        let pose = (translation.to_array(), rotation.to_array());
+
+        let mesh_entities: Vec<Entity> = std::iter::once(entity)
+            .chain(children.iter_descendants(entity))
+            .filter(|e| parts.contains(*e))
+            .collect();
+        let key = ShapeKey {
+            collision: prop.collision,
+            scale: scale.to_array().map(|v| (v * 1000.).round() as i32),
+            meshes: mesh_entities.iter().map(|e| parts.get(*e).unwrap().0.0.id()).collect(),
+        };
+
+        // Up to date: only follow the prop when it moves (and come back after a reset).
+        if let Some(mut solid) = solid
+            && solid.key == key
+        {
+            if prop.collision == CollisionKind::None {
+                if let Some(id) = solids.bodies.remove(&entity) {
+                    mods.world.remove(id);
+                }
+                continue;
+            }
+            let live = solids.bodies.get(&entity).is_some_and(|id| mods.world.read(*id).is_some());
+            if !live {
+                if let Some(shape) = solid.shape.clone() {
+                    spawn_body(&mut mods, &mut solids, entity, shape, pose, &prop.name);
+                    solid.pose = pose;
+                }
+            } else if solid.pose != pose {
+                let id = solids.bodies[&entity];
+                mods.world.set_pose(id, pose.0, pose.1);
+                solid.pose = pose;
+            }
+            if pending.is_some() {
+                commands.entity(entity).remove::<Pending>();
+            }
+            continue;
+        }
+
+        if prop.collision == CollisionKind::None {
+            if let Some(id) = solids.bodies.remove(&entity) {
+                mods.world.remove(id);
+            }
+            commands.entity(entity).remove::<Pending>().insert(EditorSolid { key, shape: None, pose });
+            continue;
+        }
+
+        // Shape changed (or new): wait for it to settle and its meshes to load, then cook.
+        let Some(mut pending) = pending else {
+            commands.entity(entity).insert(Pending { key, frames: 0, task: None });
+            continue;
+        };
+        if pending.key != key {
+            *pending = Pending { key, frames: 0, task: None };
+            continue;
+        }
+        if let Some(task) = &mut pending.task {
+            if let Some(shape) = check_ready(task) {
+                spawn_body(&mut mods, &mut solids, entity, shape.clone(), pose, &prop.name);
+                commands.entity(entity).remove::<Pending>().insert(EditorSolid {
+                    key: pending.key.clone(),
+                    shape: Some(shape),
+                    pose,
+                });
+            }
+            continue;
+        }
+        pending.frames += 1;
+        if pending.frames < SETTLE_FRAMES || mesh_entities.is_empty() {
+            continue;
+        }
+        let loading = mesh_entities.iter().any(|e| {
+            let handle = &parts.get(*e).unwrap().0.0;
+            meshes.get(handle).is_none() && !asset_server.load_state(handle).is_failed()
+        });
+        if loading {
+            continue;
+        }
+
+        // Geometry in the body frame: the prop's rotation and position removed, its scale kept.
+        let to_body = Transform::from_translation(translation).with_rotation(rotation).to_matrix().inverse();
+        let mut pieces = Vec::new();
+        for e in &mesh_entities {
+            let (mesh, part_global) = parts.get(*e).unwrap();
+            let Some(mesh) = meshes.get(&mesh.0) else { continue };
+            let matrix = to_body * part_global.to_matrix();
+            if let Some(piece) = MeshPiece::from_mesh(mesh, matrix) {
+                pieces.push(piece);
+            }
+        }
+        if pieces.is_empty() {
+            warn!("map editor: {} has no mesh data to collide with", prop.name);
+            commands.entity(entity).remove::<Pending>().insert(EditorSolid { key: pending.key.clone(), shape: None, pose });
+            continue;
+        }
+        let primitive = matches!(prop.source, PropSource::Primitive(_));
+        let collision = prop.collision;
+        pending.task = Some(AsyncComputeTaskPool::get().spawn(async move { cook(pieces, primitive, collision) }));
+    }
+}
+
+fn spawn_body(mods: &mut Mods, solids: &mut Solids, entity: Entity, shape: Shape, pose: ([f32; 3], [f32; 4]), name: &str) {
+    if let Some(old) = solids.bodies.remove(&entity) {
+        mods.world.remove(old);
+    }
+    let desc = BodyDesc { shape, body_type: BodyType::Static, position: pose.0, ..Default::default() };
+    match mods.world.spawn(desc) {
+        Ok(id) => {
+            mods.world.set_pose(id, pose.0, pose.1);
+            solids.bodies.insert(entity, id);
+        }
+        Err(error) => warn!("map editor: no collision for {name}: {error}"),
+    }
+}
+
+/// One render mesh, already in the body frame.
+struct MeshPiece {
+    vertices: Vec<[f32; 3]>,
+    triangles: Vec<[u32; 3]>,
+}
+
+impl MeshPiece {
+    fn from_mesh(mesh: &Mesh, matrix: Mat4) -> Option<Self> {
+        let positions = mesh.attribute(Mesh::ATTRIBUTE_POSITION)?.as_float3()?;
+        let vertices: Vec<[f32; 3]> = positions.iter().map(|p| matrix.transform_point3(Vec3::from_array(*p)).to_array()).collect();
+        let indices: Vec<u32> = match mesh.indices() {
+            Some(indices) => indices.iter().map(|i| i as u32).collect(),
+            None => (0..vertices.len() as u32).collect(),
+        };
+        let triangles = indices
+            .chunks_exact(3)
+            .map(|t| [t[0], t[1], t[2]])
+            .filter(|t| t.iter().all(|&i| (i as usize) < vertices.len()))
+            .collect();
+        (!vertices.is_empty()).then_some(Self { vertices, triangles })
+    }
+}
+
+/// Builds the compound collider. Never fails: the last resort is a bounding box.
+fn cook(pieces: Vec<MeshPiece>, primitive: bool, collision: CollisionKind) -> Shape {
+    let all_points = || pieces.iter().flat_map(|p| p.vertices.iter().copied()).collect::<Vec<_>>();
+    let per_mesh = || pieces.iter().filter_map(|p| hull(&p.vertices)).collect::<Vec<_>>();
+
+    let hulls = match collision {
+        CollisionKind::ConvexHull => hull(&all_points()).into_iter().collect(),
+        _ if primitive => per_mesh(),
+        _ => {
+            // Merge every mesh into one decomposition so parts that touch share hulls.
+            let mut vertices = Vec::new();
+            let mut triangles = Vec::new();
+            for piece in &pieces {
+                let base = vertices.len() as u32;
+                vertices.extend_from_slice(&piece.vertices);
+                triangles.extend(piece.triangles.iter().map(|t| t.map(|i| i + base)));
+            }
+            let options = ModelColliderOptions { max_hulls: 64, ..Default::default() };
+            match model::decompose(&vertices, &triangles, &options) {
+                Ok(Shape::Compound { hulls }) => hulls,
+                _ => per_mesh(),
+            }
+        }
+    };
+    if !hulls.is_empty() && model::validate_hulls(&hulls).is_ok() {
+        return Shape::Compound { hulls };
+    }
+    if let Some(one) = hull(&all_points()) {
+        return Shape::Compound { hulls: vec![one] };
+    }
+    Shape::Compound { hulls: vec![bounding_box(&all_points())] }
+}
+
+/// Points of the convex hull around `points`. Flat or tiny input becomes a thin box.
+fn hull(points: &[[f32; 3]]) -> Option<Vec<[f32; 3]>> {
+    use rapier3d::prelude::{SharedShape, Vector};
+    if points.len() < 4 || points.iter().flatten().any(|v| !v.is_finite() || v.abs() > 1000.) {
+        return None;
+    }
+    let vectors: Vec<Vector> = points.iter().copied().map(Vector::from_array).collect();
+    let (min, max) = vectors.iter().fold((vectors[0], vectors[0]), |(a, b), &p| (a.min(p), b.max(p)));
+    if (max - min).min_element() < 0.01 {
+        return Some(bounding_box(points));
+    }
+    let shape = SharedShape::convex_hull(&vectors)?;
+    let (vertices, _) = shape.as_convex_polyhedron()?.to_trimesh();
+    let out: Vec<[f32; 3]> = vertices.into_iter().map(|v| v.to_array()).collect();
+    (4..=model::MAX_HULL_POINTS).contains(&out.len()).then_some(out)
+}
+
+/// The eight corners of the box around `points`, at least 2 cm thick on every axis.
+fn bounding_box(points: &[[f32; 3]]) -> Vec<[f32; 3]> {
+    let mut min = Vec3::splat(f32::MAX);
+    let mut max = Vec3::splat(f32::MIN);
+    for p in points.iter().map(|p| Vec3::from_array(*p)).filter(|p| p.is_finite()) {
+        min = min.min(p);
+        max = max.max(p);
+    }
+    if min.x > max.x {
+        (min, max) = (Vec3::splat(-0.5), Vec3::splat(0.5));
+    }
+    let center = (min + max) / 2.;
+    let half = ((max - min) / 2.).max(Vec3::splat(0.01));
+    let mut corners = Vec::with_capacity(8);
+    for x in [-1., 1.] {
+        for y in [-1., 1.] {
+            for z in [-1., 1.] {
+                corners.push((center + half * Vec3::new(x, y, z)).to_array());
+            }
+        }
+    }
+    corners
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::modding::bridge::MovingQueries;
+    use skate_core::math::Vector3;
+    use skate_core::physics::board_world::ExternalQueries;
+    use skate_dynamics::DynamicsWorld;
+
+    fn cube(center: Vec3, half: Vec3) -> MeshPiece {
+        let mesh: Mesh = Cuboid::from_size(half * 2.).into();
+        MeshPiece::from_mesh(&mesh, Mat4::from_translation(center)).unwrap()
+    }
+
+    /// The queries the board world runs against mod and editor bodies.
+    fn board_world(dynamics: &DynamicsWorld) -> MovingQueries {
+        MovingQueries(dynamics.solid_bodies())
+    }
+
+    /// Straight down from `from`: where does the skater's world query hit?
+    fn drop_onto(world: &MovingQueries, from: [f32; 3]) -> Option<f32> {
+        let hit = world.line(Vector3::new(from[0], from[1], from[2]), Vector3::new(from[0], from[1] - 50., from[2]), 0.)?;
+        Some(hit.hit.geometry.position.y)
+    }
+
+    #[test]
+    fn placed_primitive_is_solid_for_the_skater_and_follows_its_prop() {
+        let shape = cook(vec![cube(Vec3::ZERO, Vec3::splat(0.5))], true, CollisionKind::Solid);
+        let mut dynamics = DynamicsWorld::default();
+        let id = dynamics
+            .spawn(BodyDesc { shape, body_type: BodyType::Static, position: [0., 2., 0.], ..Default::default() })
+            .unwrap();
+        let world = board_world(&dynamics);
+        let top = drop_onto(&world, [0., 10., 0.]).expect("skater query hits the cube");
+        assert!((top - 2.5).abs() < 0.01, "top at {top}");
+        assert!(drop_onto(&world, [3., 10., 0.]).is_none());
+
+        // Rotate 45 degrees about Z and move: the collider moves with the prop.
+        let rotation = Quat::from_rotation_z(std::f32::consts::FRAC_PI_4);
+        assert!(dynamics.set_pose(id, [5., 2., 0.], rotation.to_array()));
+        let world = board_world(&dynamics);
+        assert!(drop_onto(&world, [0., 10., 0.]).is_none());
+        let top = drop_onto(&world, [5., 10., 0.]).unwrap();
+        assert!((top - (2. + 0.5f32.hypot(0.5))).abs() < 0.02, "rotated top at {top}");
+    }
+
+    #[test]
+    fn model_keeps_its_doorway_open() {
+        // An arch: two posts and a beam, as one mesh.
+        let pieces = vec![
+            cube(Vec3::new(-1.5, 1.5, 0.), Vec3::new(0.5, 1.5, 0.5)),
+            cube(Vec3::new(1.5, 1.5, 0.), Vec3::new(0.5, 1.5, 0.5)),
+            cube(Vec3::new(0., 3.5, 0.), Vec3::new(2., 0.5, 0.5)),
+        ];
+        let Shape::Compound { hulls } = cook(pieces, false, CollisionKind::Solid) else { panic!() };
+        assert!(hulls.len() >= 2, "decomposed into {} parts", hulls.len());
+        let mut dynamics = DynamicsWorld::default();
+        dynamics
+            .spawn(BodyDesc { shape: Shape::Compound { hulls }, body_type: BodyType::Static, ..Default::default() })
+            .unwrap();
+        let queries = board_world(&dynamics);
+        // Roll through the doorway at knee height: nothing in the way.
+        let through = queries.line(Vector3::new(0., 0.5, 5.), Vector3::new(0., 0.5, -5.), 0.2);
+        assert!(through.is_none(), "doorway blocked");
+        // Into a post: blocked.
+        assert!(queries.line(Vector3::new(-1.5, 0.5, 5.), Vector3::new(-1.5, 0.5, -5.), 0.2).is_some());
+        // Landing on the beam.
+        let top = drop_onto(&queries, [0., 10., 0.]).unwrap();
+        assert!((top - 4.).abs() < 0.15, "beam top at {top}");
+        let _ = &queries;
+    }
+
+    #[test]
+    fn convex_hull_fills_the_doorway() {
+        let pieces = vec![
+            cube(Vec3::new(-1.5, 1.5, 0.), Vec3::new(0.5, 1.5, 0.5)),
+            cube(Vec3::new(1.5, 1.5, 0.), Vec3::new(0.5, 1.5, 0.5)),
+        ];
+        let Shape::Compound { hulls } = cook(pieces, false, CollisionKind::ConvexHull) else { panic!() };
+        assert_eq!(hulls.len(), 1);
+    }
+
+    #[test]
+    fn flat_mesh_still_gets_a_collider() {
+        let mesh = Plane3d::default().mesh().size(4., 4.).build();
+        let piece = MeshPiece::from_mesh(&mesh, Mat4::IDENTITY).unwrap();
+        let shape = cook(vec![piece], false, CollisionKind::Solid);
+        let mut dynamics = DynamicsWorld::default();
+        dynamics.spawn(BodyDesc { shape, body_type: BodyType::Static, ..Default::default() }).unwrap();
+        let top = drop_onto(&board_world(&dynamics), [1., 5., 1.]).unwrap();
+        assert!(top.abs() < 0.02, "plane at {top}");
+    }
+}
