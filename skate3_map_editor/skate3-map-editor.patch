new file mode 100644
index 0000000..87354f8
--- /dev/null
+++ b/crates/skate-map-editor/src/disc.rs
@@ -0,0 +1,696 @@
+//! Pulls every usable 3D model out of a game disc image the player owns.
+//!
+//! Reads the disc's file system (Xbox / Xbox 360 XDVDFS, ISO 9660 for PS2, PSP
+//! and PC discs, or a GameCube disc), then looks at every file:
+//!
+//! - `.glb` / `.gltf` models are copied out (a `.gltf` with its buffers and textures),
+//! - `.obj` models are converted to `.glb`,
+//! - every other file is searched for embedded `.glb` models (uncompressed archives).
+//!
+//! Everything lands in `<assets>/imported/<disc name>/`, where the asset browser lists it, with a
+//! report of the file types the disc holds that the editor can't use (they are in the game's own
+//! formats and need a converter written for that game).
+
+use std::collections::{BTreeMap, HashSet};
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+
+const SECTOR: u64 = 2048;
+
+/// File extensions treated as disc images.
+pub fn is_disc_image(path: &Path) -> bool {
+    path.extension()
+        .map(|e| e.to_string_lossy().to_ascii_lowercase())
+        .is_some_and(|e| matches!(e.as_str(), "iso" | "xiso" | "gcm"))
+}
+
+/// One file on the disc.
+#[derive(Clone, Debug)]
+pub struct DiscFile {
+    /// Path inside the disc, `/` separated.
+    pub path: String,
+    /// Byte offset in the image.
+    pub offset: u64,
+    pub size: u64,
+}
+
+/// The disc's files and which file system it uses.
+pub struct Disc {
+    pub format: &'static str,
+    pub files: Vec<DiscFile>,
+}
+
+/// Lists every file on the disc image.
+pub fn read_disc(image: &mut (impl Read + Seek)) -> Result<Disc, String> {
+    let length = image.seek(SeekFrom::End(0)).map_err(|e| e.to_string())?;
+    // Xbox 360 game partitions sit at a fixed offset per disc type; plain .xiso images at 0.
+    for base in [0u64, 0x0FD9_0000, 0x0208_0000, 0x1830_0000] {
+        if base + 0x10000 + 0x800 <= length && read_at(image, base + 0x10000, 20)? == b"MICROSOFT*XBOX*MEDIA" {
+            return Ok(Disc { format: "Xbox (XDVDFS)", files: xdvdfs(image, base)? });
+        }
+    }
+    if length >= 0x8006 && &read_at(image, 0x8001, 5)? == b"CD001" {
+        return Ok(Disc { format: "ISO 9660", files: iso9660(image)? });
+    }
+    if length >= 0x440 && read_at(image, 0x1C, 4)? == [0xC2, 0x33, 0x9F, 0x3D] {
+        return Ok(Disc { format: "GameCube", files: gamecube(image)? });
+    }
+    Err("not a disc image the editor can read (Xbox, Xbox 360, PS2, PSP, PC or GameCube)".into())
+}
+
+fn read_at(image: &mut (impl Read + Seek), offset: u64, len: usize) -> Result<Vec<u8>, String> {
+    let mut buf = vec![0; len];
+    image.seek(SeekFrom::Start(offset)).map_err(|e| e.to_string())?;
+    image.read_exact(&mut buf).map_err(|e| format!("disc image is cut short: {e}"))?;
+    Ok(buf)
+}
+
+fn u16le(b: &[u8], at: usize) -> u16 {
+    u16::from_le_bytes([b[at], b[at + 1]])
+}
+fn u32le(b: &[u8], at: usize) -> u32 {
+    u32::from_le_bytes(b[at..at + 4].try_into().unwrap())
+}
+fn u32be(b: &[u8], at: usize) -> u32 {
+    u32::from_be_bytes(b[at..at + 4].try_into().unwrap())
+}
+
+/// Xbox file system: each directory is a binary tree of entries.
+fn xdvdfs(image: &mut (impl Read + Seek), base: u64) -> Result<Vec<DiscFile>, String> {
+    let volume = read_at(image, base + 0x10000, 0x800)?;
+    let (root_sector, root_size) = (u32le(&volume, 20) as u64, u32le(&volume, 24) as u64);
+    let mut files = Vec::new();
+    let mut seen = HashSet::new();
+    let mut directories = vec![(String::new(), root_sector, root_size)];
+    while let Some((prefix, sector, size)) = directories.pop() {
+        if size == 0 || size > 64 << 20 || !seen.insert(sector) {
+            continue;
+        }
+        let table = read_at(image, base + sector * SECTOR, size as usize)?;
+        let mut stack = vec![0usize];
+        let mut visited = HashSet::new();
+        while let Some(at) = stack.pop() {
+            if at + 14 > table.len() || !visited.insert(at) {
+                continue;
+            }
+            let (left, right) = (u16le(&table, at), u16le(&table, at + 2));
+            if left == 0xFFFF && right == 0xFFFF {
+                continue;
+            }
+            let (start, length, attributes, name_len) =
+                (u32le(&table, at + 4) as u64, u32le(&table, at + 8) as u64, table[at + 12], table[at + 13] as usize);
+            if at + 14 + name_len > table.len() {
+                continue;
+            }
+            let name = String::from_utf8_lossy(&table[at + 14..at + 14 + name_len]).into_owned();
+            let path = format!("{prefix}{name}");
+            if attributes & 0x10 != 0 {
+                directories.push((format!("{path}/"), start, length));
+            } else {
+                files.push(DiscFile { path, offset: base + start * SECTOR, size: length });
+            }
+            for child in [left, right] {
+                if child != 0 && child != 0xFFFF {
+                    stack.push(child as usize * 4);
+                }
+            }
+        }
+    }
+    Ok(files)
+}
+
+/// ISO 9660: directory records in extents, from the primary volume descriptor's root.
+fn iso9660(image: &mut (impl Read + Seek)) -> Result<Vec<DiscFile>, String> {
+    let descriptor = read_at(image, 0x8000, 0x800)?;
+    let root = &descriptor[156..190];
+    let mut files = Vec::new();
+    let mut seen = HashSet::new();
+    let mut directories = vec![(String::new(), u32le(root, 2) as u64, u32le(root, 10) as u64)];
+    while let Some((prefix, extent, size)) = directories.pop() {
+        if size == 0 || size > 64 << 20 || !seen.insert(extent) {
+            continue;
+        }
+        let table = read_at(image, extent * SECTOR, size as usize)?;
+        let mut at = 0;
+        while at < table.len() {
+            let len = table[at] as usize;
+            if len == 0 {
+                // Records never cross a sector boundary: the rest of this sector is padding.
+                at = (at / SECTOR as usize + 1) * SECTOR as usize;
+                continue;
+            }
+            if at + len > table.len() || len < 34 {
+                break;
+            }
+            let record = &table[at..at + len];
+            let name_len = record[32] as usize;
+            let name_bytes = &record[33..(33 + name_len).min(len)];
+            at += len;
+            if name_bytes == [0] || name_bytes == [1] {
+                continue;
+            }
+            let name = String::from_utf8_lossy(name_bytes);
+            let name = name.split(';').next().unwrap_or_default().trim_end_matches('.').to_string();
+            let (start, length) = (u32le(record, 2) as u64, u32le(record, 10) as u64);
+            if record[25] & 0x02 != 0 {
+                directories.push((format!("{prefix}{name}/"), start, length));
+            } else {
+                files.push(DiscFile { path: format!("{prefix}{name}"), offset: start * SECTOR, size: length });
+            }
+        }
+    }
+    Ok(files)
+}
+
+/// GameCube: a flat file system table of 12-byte entries plus a name table.
+fn gamecube(image: &mut (impl Read + Seek)) -> Result<Vec<DiscFile>, String> {
+    let header = read_at(image, 0x420, 0x10)?;
+    let (fst_offset, fst_size) = (u32be(&header, 4) as u64, u32be(&header, 8) as usize);
+    if fst_size < 12 || fst_size > 64 << 20 {
+        return Err("GameCube disc has no file table".into());
+    }
+    let fst = read_at(image, fst_offset, fst_size)?;
+    let count = u32be(&fst, 8) as usize;
+    if count == 0 || count * 12 > fst.len() {
+        return Err("GameCube file table is damaged".into());
+    }
+    let names = &fst[count * 12..];
+    let name_at = |offset: usize| -> String {
+        let end = names[offset.min(names.len())..].iter().position(|&b| b == 0).map_or(names.len(), |p| offset + p);
+        String::from_utf8_lossy(&names[offset.min(names.len())..end]).into_owned()
+    };
+    let mut files = Vec::new();
+    // (directory path, index where it ends)
+    let mut stack: Vec<(String, usize)> = vec![(String::new(), count)];
+    for i in 1..count {
+        while stack.len() > 1 && i >= stack.last().unwrap().1 {
+            stack.pop();
+        }
+        let entry = &fst[i * 12..i * 12 + 12];
+        let word = u32be(entry, 0);
+        let name = name_at((word & 0x00FF_FFFF) as usize);
+        let prefix = stack.last().unwrap().0.clone();
+        if word >> 24 != 0 {
+            stack.push((format!("{prefix}{name}/"), u32be(entry, 8) as usize));
+        } else {
+            files.push(DiscFile { path: format!("{prefix}{name}"), offset: u32be(entry, 4) as u64, size: u32be(entry, 8) as u64 });
+        }
+    }
+    Ok(files)
+}
