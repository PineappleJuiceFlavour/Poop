+        let mut skeleton = string("car_skel");
+        skeleton.extend([0u8; 8]);
+        let skeleton = chunk(0x4500, &skeleton, &[joint("root", 0, 0.0), joint("wheel", 0, 2.0)]);
+        let prop = |drawable: &str, joint: u32| {
+            let mut p = string(drawable);
+            p.extend(0u32.to_le_bytes());
+            p.extend(joint.to_le_bytes());
+            chunk(0x4516, &p, &[])
+        };
+        let mut composite = string("car");
+        composite.extend(string("car_skel"));
+        let composite = chunk(0x4512, &composite, &[chunk(0x4513, &[], &[prop("body", 0), prop("wheel", 1)])]);
+        let mut file = paint();
+        file.extend([mesh("body", "paint_m"), mesh("wheel", "paint_m"), mesh("body_damaged", "paint_m"), skeleton, composite]);
+        let (models, dir) = convert_file(P3dWriter::file(&file));
+        assert_eq!(models[0], "imported/g/thing.glb");
+        let json = glb_json(&std::fs::read(dir.join("assets").join(&models[0])).unwrap());
+        // Body (4 vertices) and wheel (4), not the damaged body.
+        assert_eq!(json["accessors"][0]["count"], 8);
+        assert_eq!(json["accessors"][0]["max"][0], 3.0, "the wheel sits on its joint");
+        assert_eq!(json["images"].as_array().unwrap().len(), 1, "one copy of the shared texture");
+        // The three meshes are also exported on their own.
+        assert_eq!(models.len(), 4);
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn instances_world_objects_through_scene_graphs() {
+        let transform = |x: f32, children: &[Vec<u8>]| {
+            let mut t = string("t");
+            t.extend(1u32.to_le_bytes());
+            t.extend(translation(x));
+            chunk(0x120103, &t, children)
+        };
+        let drawable = |name: &str| {
+            let mut d = string("label");
+            d.extend(string(name));
+            chunk(0x120107, &d, &[])
+        };
+        let scene = chunk(0x120100, &string("scene"), &[transform(0.0, &[drawable("tree")]), transform(10.0, &[drawable("tree")]), transform(20.0, &[drawable("tree")])]);
+        let mut file = paint();
+        file.extend([mesh("tree", "paint_m"), scene]);
+        let (models, dir) = convert_file(P3dWriter::file(&file));
+        let json = glb_json(&std::fs::read(dir.join("assets").join(&models[0])).unwrap());
+        assert_eq!(json["accessors"][0]["count"], 12, "three trees");
+        assert_eq!(json["accessors"][0]["max"][0], 21.0);
+        assert_eq!(json["images"].as_array().unwrap().len(), 1);
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn reads_a_real_hit_and_run_file() {
+        // From the Donut Team docs (MIT): a PC Hit & Run HUD file with two sprites.
+        let path = concat!(env!("CARGO_MANIFEST_DIR"), "/test-data/radical/AnalogueSpeedometer.p3d");
+        let p3d = P3d::open(std::fs::read(path).unwrap()).unwrap();
+        let root = p3d.root().unwrap();
+        let images: Vec<Rgba> = root.walk().into_iter().filter(|c| c.id == 0x19001).filter_map(|c| image_chunk(c, p3d.fields())).collect();
+        assert_eq!(images.len(), 2);
+        assert!(images.iter().all(|i| i.width > 0 && i.pixels.len() == (i.width * i.height * 4) as usize));
+
+        let dir = std::env::temp_dir().join(format!("p3d-real-{}", std::process::id()));
+        let mut out = Output::new(&dir.join("x"), &dir.join("assets"), "g", Box::new(|_| {}));
+        let (_, handled) = unpack(&[(path.into(), "hud/speedo.p3d".into())], &mut out);
+        assert!(handled.contains("hud/speedo.p3d"));
+        assert_eq!(out.report.textures, 2);
+        assert!(dir.join("x/hud/speedo.p3d_textures/Speedometer.png").exists());
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn decompresses_lzr() {
+        // Literal run "abc", then a match of length 6 at distance 3 => "abcabcabc".
+        let block = [3u8, b'a', b'b', b'c', 0x36, 0x00];
+        let mut z = b"P3DZ".to_vec();
+        z.extend(9u32.to_le_bytes());
+        z.extend((block.len() as u32).to_le_bytes());
+        z.extend(9u32.to_le_bytes());
+        z.extend(block);
+        assert_eq!(lzr_decompress(&z, false).unwrap(), b"abcabcabc");
+    }
+
+    #[test]
+    fn converts_rsd_sounds() {
+        let mut rsd = b"RSD4VAG ".to_vec();
+        rsd.extend(1u32.to_le_bytes());
+        rsd.extend(16u32.to_le_bytes());
+        rsd.extend(22050u32.to_le_bytes());
+        rsd.resize(0x800, 0);
+        rsd.extend([0x0C, 0x00]);
+        rsd.extend([0x11; 14]);
+        let wav = rsd_to_wav(&rsd).unwrap();
+        assert_eq!(&wav[..4], b"RIFF");
+        assert_eq!(u32::from_le_bytes(wav[40..44].try_into().unwrap()), 28 * 2);
+    }
+}
diff --git a/crates/skate-map-editor/src/texture.rs b/crates/skate-map-editor/src/texture.rs
new file mode 100644
index 0000000..3a3676a
--- /dev/null
+++ b/crates/skate-map-editor/src/texture.rs
@@ -0,0 +1,245 @@
+//! Decodes the texture formats game discs use (DDS, DXT1/3/5 blocks, packed 8/16/32-bit pixels)
+//! to RGBA, and writes PNG files.
+
+/// An 8-bit RGBA image.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Rgba {
+    pub width: u32,
+    pub height: u32,
+    pub pixels: Vec<u8>,
+}
+
+impl Rgba {
+    pub fn png(&self) -> Option<Vec<u8>> {
+        let mut out = Vec::new();
+        let mut encoder = png::Encoder::new(&mut out, self.width, self.height);
+        encoder.set_color(png::ColorType::Rgba);
+        encoder.set_depth(png::BitDepth::Eight);
+        let mut writer = encoder.write_header().ok()?;
+        writer.write_image_data(&self.pixels).ok()?;
+        writer.finish().ok()?;
+        Some(out)
+    }
+}
+
+/// Block-compressed formats.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Block {
+    Dxt1,
+    Dxt3,
+    Dxt5,
+}
+
+impl Block {
+    pub fn bytes(self) -> usize {
+        if self == Block::Dxt1 { 8 } else { 16 }
+    }
+
+    /// Bytes of the top mip level.
+    pub fn size(self, width: u32, height: u32) -> usize {
+        width.div_ceil(4) as usize * height.div_ceil(4) as usize * self.bytes()
+    }
+}
+
+/// Decodes the top mip level of a block-compressed texture.
+pub fn decode_blocks(data: &[u8], width: u32, height: u32, block: Block) -> Option<Rgba> {
+    if width == 0 || height == 0 || width > 16384 || height > 16384 || data.len() < block.size(width, height) {
+        return None;
+    }
+    let (w, h) = (width as usize, height as usize);
+    let mut pixels = vec![0u8; w * h * 4];
+    let mut at = 0;
+    for by in 0..h.div_ceil(4) {
+        for bx in 0..w.div_ceil(4) {
+            let b = &data[at..at + block.bytes()];
+            at += block.bytes();
+            let (alpha, color) = match block {
+                Block::Dxt1 => (None, b),
+                Block::Dxt3 => (Some(explicit_alpha(&b[..8])), &b[8..]),
+                Block::Dxt5 => (Some(interpolated_alpha(&b[..8])), &b[8..]),
+            };
+            let colors = color_block(color, block == Block::Dxt1);
+            for py in 0..4 {
+                for px in 0..4 {
+                    let (x, y) = (bx * 4 + px, by * 4 + py);
+                    if x >= w || y >= h {
+                        continue;
+                    }
+                    let i = py * 4 + px;
+                    let mut c = colors[i];
+                    if let Some(alpha) = alpha {
+                        c[3] = alpha[i];
+                    }
+                    pixels[(y * w + x) * 4..][..4].copy_from_slice(&c);
+                }
+            }
+        }
+    }
+    Some(Rgba { width, height, pixels })
+}
+
+fn rgb565(v: u16) -> [u8; 4] {
+    let (r, g, b) = ((v >> 11) & 31, (v >> 5) & 63, v & 31);
+    [(r * 255 / 31) as u8, (g * 255 / 63) as u8, (b * 255 / 31) as u8, 255]
+}
+
+fn color_block(b: &[u8], dxt1: bool) -> [[u8; 4]; 16] {
+    let (c0, c1) = (u16::from_le_bytes([b[0], b[1]]), u16::from_le_bytes([b[2], b[3]]));
+    let (a, z) = (rgb565(c0), rgb565(c1));
+    let mix = |wa: u16, wb: u16, d: u16| -> [u8; 4] {
+        let m = |i: usize| ((a[i] as u16 * wa + z[i] as u16 * wb) / d) as u8;
+        [m(0), m(1), m(2), 255]
+    };
+    let palette = if c0 > c1 || !dxt1 {
+        [a, z, mix(2, 1, 3), mix(1, 2, 3)]
+    } else {
+        [a, z, mix(1, 1, 2), [0, 0, 0, 0]]
+    };
+    let bits = u32::from_le_bytes([b[4], b[5], b[6], b[7]]);
+    std::array::from_fn(|i| palette[((bits >> (i * 2)) & 3) as usize])
+}
+
+fn explicit_alpha(b: &[u8]) -> [u8; 16] {
+    let bits = u64::from_le_bytes(b[..8].try_into().unwrap());
+    std::array::from_fn(|i| (((bits >> (i * 4)) & 15) as u8) * 17)
+}
+
+fn interpolated_alpha(b: &[u8]) -> [u8; 16] {
+    let (a0, a1) = (b[0] as u16, b[1] as u16);
+    let palette: [u8; 8] = if a0 > a1 {
+        std::array::from_fn(|i| match i {
+            0 => a0 as u8,
+            1 => a1 as u8,
+            i => ((a0 * (8 - i as u16) + a1 * (i as u16 - 1)) / 7) as u8,
+        })
+    } else {
+        std::array::from_fn(|i| match i {
+            0 => a0 as u8,
+            1 => a1 as u8,
+            6 => 0,
+            7 => 255,
+            i => ((a0 * (6 - i as u16) + a1 * (i as u16 - 1)) / 5) as u8,
+        })
+    };
+    let mut bits = 0u64;
+    for (k, &byte) in b[2..8].iter().enumerate() {
+        bits |= (byte as u64) << (k * 8);
+    }
+    std::array::from_fn(|i| palette[((bits >> (i * 3)) & 7) as usize])
+}
+
+/// Channel masks of an uncompressed pixel format. A zero alpha mask means opaque; a format with
+/// only a red mask (or the `luminance` flag) is greyscale.
+#[derive(Clone, Copy, Debug)]
+pub struct Masks {
+    pub bytes: usize,
+    pub r: u32,
+    pub g: u32,
+    pub b: u32,
+    pub a: u32,
+    pub luminance: bool,
+    pub big_endian: bool,
+}
+
+/// Decodes the top mip level of a packed-pixel texture.
+pub fn decode_masked(data: &[u8], width: u32, height: u32, m: Masks) -> Option<Rgba> {
+    let count = width as usize * height as usize;
+    if width == 0 || height == 0 || width > 16384 || height > 16384 || !(1..=4).contains(&m.bytes) || data.len() < count * m.bytes {
+        return None;
+    }
+    let channel = |v: u32, mask: u32| -> Option<u8> {
+        if mask == 0 {
+            return None;
+        }
+        let max = mask >> mask.trailing_zeros();
+        Some((((v & mask) >> mask.trailing_zeros()) as u64 * 255 / max as u64) as u8)
+    };
+    let mut pixels = Vec::with_capacity(count * 4);
+    for px in data[..count * m.bytes].chunks_exact(m.bytes) {
+        let mut v = 0u32;
+        for (k, &byte) in px.iter().enumerate() {
+            v |= (byte as u32) << if m.big_endian { (m.bytes - 1 - k) * 8 } else { k * 8 };
+        }
+        let r = channel(v, m.r).unwrap_or(0);
+        let (g, b) = if m.luminance || (m.g == 0 && m.b == 0) { (r, r) } else { (channel(v, m.g).unwrap_or(0), channel(v, m.b).unwrap_or(0)) };
+        pixels.extend([r, g, b, channel(v, m.a).unwrap_or(255)]);
+    }
+    Some(Rgba { width, height, pixels })
+}
+
+/// Decodes the top mip level of a `.dds` file.
+pub fn decode_dds(dds: &[u8]) -> Option<Rgba> {
+    if dds.len() < 128 || &dds[..4] != b"DDS " {
+        return None;
+    }
+    let u32_at = |at: usize| u32::from_le_bytes(dds[at..at + 4].try_into().unwrap());
+    let (height, width) = (u32_at(12), u32_at(16));
+    let (flags, fourcc, bits) = (u32_at(80), &dds[84..88], u32_at(88));
+    let data = &dds[128..];
+    if flags & 4 != 0 {
+        let block = match fourcc {
+            b"DXT1" => Block::Dxt1,
+            b"DXT2" | b"DXT3" => Block::Dxt3,
+            b"DXT4" | b"DXT5" => Block::Dxt5,
+            _ => return None,
+        };
+        return decode_blocks(data, width, height, block);
+    }
+    let alpha = flags & 1 != 0 || flags & 2 != 0;
+    let masks = Masks {
+        bytes: (bits as usize).div_ceil(8),
+        r: u32_at(92),
+        g: u32_at(96),
+        b: u32_at(100),
+        a: if alpha { u32_at(104) } else { 0 },
+        luminance: flags & 0x20000 != 0,
+        big_endian: false,
+    };
+    // Alpha-only textures keep their alpha visible as grey.
+    if masks.r == 0 && masks.g == 0 && masks.b == 0 && masks.a != 0 {
+        return decode_masked(data, width, height, Masks { r: masks.a, luminance: true, ..masks });
+    }
+    decode_masked(data, width, height, masks)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn decodes_dxt1_and_dxt5_blocks() {
+        // Red and blue endpoints, every texel index 0 (red) except the second (blue).
+        let mut dxt1 = vec![0x00, 0xF8, 0x1F, 0x00];
+        dxt1.extend(0b0100u32.to_le_bytes());
+        let image = decode_blocks(&dxt1, 4, 4, Block::Dxt1).unwrap();
+        assert_eq!(&image.pixels[0..4], &[255, 0, 0, 255]);
+        assert_eq!(&image.pixels[4..8], &[0, 0, 255, 255]);
+
+        // Alpha endpoints 255 and 0, texel 0 uses index 1 (alpha 0).
+        let mut dxt5 = vec![255, 0, 1, 0, 0, 0, 0, 0];
+        dxt5.extend(&dxt1);
+        let image = decode_blocks(&dxt5, 4, 4, Block::Dxt5).unwrap();
+        assert_eq!(&image.pixels[0..4], &[255, 0, 0, 0]);
+        assert_eq!(image.pixels[7], 255);
+    }
+
+    #[test]
+    fn decodes_uncompressed_dds_and_writes_png() {
+        let mut dds = vec![0u8; 128];
+        dds[..4].copy_from_slice(b"DDS ");
+        let mut put = |at: usize, v: u32| dds[at..at + 4].copy_from_slice(&v.to_le_bytes());
+        put(12, 1);
+        put(16, 2);
+        put(80, 0x41);
+        put(88, 32);
+        put(92, 0x00FF_0000);
+        put(96, 0x0000_FF00);
+        put(100, 0x0000_00FF);
+        put(104, 0xFF00_0000);
+        dds.extend([0x30, 0x20, 0x10, 0xFF, 0, 0, 0xFF, 0x80]); // BGRA, BGRA
+        let image = decode_dds(&dds).unwrap();
+        assert_eq!(image.pixels, vec![0x10, 0x20, 0x30, 0xFF, 0xFF, 0, 0, 0x80]);
+        let png = image.png().unwrap();
+        assert_eq!(&png[1..4], b"PNG");
+    }
+}
