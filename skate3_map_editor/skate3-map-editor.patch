+        let tex = texture(&dds);
+        let tex_sha1 = [7u8; 20];
+        // A normal map (DDS with the `BUMP` footer) in the material's first slot.
+        let mut bump_dds = dds[..128].to_vec();
+        bump_dds.extend([0x1F, 0x00, 0x1F, 0x00, 0, 0, 0, 0]); // blue, unlike the red texture
+        bump_dds.extend(b"BUMP");
+        let bump = texture(&bump_dds);
+        let bump_sha1 = [8u8; 20];
+
+        // Graphics material, revision 0x272: header fields, 3 shader offsets, no code, then the
+        // texture slots: normal map, colour texture, six empty.
+        let mut body = Vec::new();
+        body.extend(0u32.to_be_bytes()); // flags
+        body.extend(0f32.to_be_bytes()); // alpha test level
+        body.extend([0, 0]); // alpha layer, shadow cast mode
+        body.extend([0u8; 16]);
+        body.extend([0u8; 12]); // shader offsets
+        body.extend(0u32.to_be_bytes()); // shader code
+        for slot in [Some(bump_sha1), Some(tex_sha1), None, None, None, None, None, None] {
+            body.extend(0u32.to_be_bytes()); // reference flags
+            match slot {
+                Some(sha1) => {
+                    body.push(1);
+                    body.extend(sha1);
+                }
+                None => body.push(0),
+            }
+        }
+        // The dependency table lists the colour texture first: the slots must win.
+        let gmat = resource(b"GMTb", 0x272, &body, &[(None, Some(tex_sha1), 1), (None, Some(bump_sha1), 1)]);
+        assert_eq!(material_textures(&read_resource(&gmat).unwrap()), Some(vec![Ref::Sha1(bump_sha1), Ref::Sha1(tex_sha1)]));
+        let gmat_sha1 = [9u8; 20];
+        for version in [0x132u32, 0x272, 0x3F9] {
+            let mesh = resource(b"MSHb", version, &mesh_body(version), &[(Some(1234), None, 7)]);
+            let res = read_resource(&mesh).unwrap();
+            let parsed = read_mesh(&res).unwrap();
+            assert_eq!(parsed.positions[3], [1.0, 1.0, 0.0], "revision {version:#x}");
+            assert_eq!(parsed.parts[0].0.len(), 6);
+            assert_eq!(parsed.parts[0].1, Some(Ref::Guid(1234)));
+            assert!((parsed.normals[0][2] - 1.0).abs() < 1e-6);
+
+            let dir = std::env::temp_dir().join(format!("lbp-test-{version}-{}", std::process::id()));
+            std::fs::create_dir_all(&dir).unwrap();
+            let archive = dir.join("data.farc");
+            let mut farc = Vec::new();
+            let mut table = Vec::new();
+            for (sha1, data) in [(tex_sha1, &tex), (bump_sha1, &bump), (gmat_sha1, &gmat), ([1u8; 20], &mesh)] {
+                table.extend(sha1);
+                table.extend((farc.len() as u32).to_be_bytes());
+                table.extend((data.len() as u32).to_be_bytes());
+                farc.extend(data.iter());
+            }
+            farc.extend(table);
+            farc.extend(4u32.to_be_bytes());
+            farc.extend(b"FARC");
+            std::fs::write(&archive, farc).unwrap();
+            // Database: names the mesh and maps GUID 1234 to the material.
+            let mut map = vec![0, 0, 0x01, 0x32, 0, 0, 0, 2];
+            for (path, sha1, guid) in [("gamedata/props/crate.mol", [1u8; 20], 99u32), ("gamedata/props/crate.gmat", gmat_sha1, 1234)] {
+                map.extend((path.len() as u32).to_be_bytes());
+                map.extend(path.as_bytes());
+                map.extend([0u8; 8]);
+                map.extend(0u32.to_be_bytes());
+                map.extend(sha1);
+                map.extend(guid.to_be_bytes());
+            }
+            std::fs::write(dir.join("blurayguids.map"), map).unwrap();
+
+            let assets = dir.join("assets");
+            let mut out = Output::new(&dir.join("extracted"), &assets, "lbp", Box::new(|_| {}));
+            let files = vec![(archive.clone(), "data.farc".to_string()), (dir.join("blurayguids.map"), "blurayguids.map".to_string())];
+            let (_, handled) = unpack(&files, &mut out);
+            assert!(handled.contains("data.farc") && handled.contains("blurayguids.map"));
+            assert_eq!(out.report.models, vec!["imported/lbp/gamedata/props/crate.glb".to_string()]);
+            assert_eq!(out.report.textures, 2, "every texture becomes a PNG, normal maps too");
+            let glb = std::fs::read(assets.join("imported/lbp/gamedata/props/crate.glb")).unwrap();
+            let json_len = u32::from_le_bytes(glb[12..16].try_into().unwrap()) as usize;
+            let json: serde_json::Value = serde_json::from_slice(&glb[20..20 + json_len]).unwrap();
+            assert_eq!(json["images"].as_array().map(Vec::len), Some(1), "the material's texture is embedded");
+            // It's the colour texture, not the normal map in the first slot.
+            let view = &json["bufferViews"][json["images"][0]["bufferView"].as_u64().unwrap() as usize];
+            let bin = 20 + json_len + 8 + view["byteOffset"].as_u64().unwrap() as usize;
+            let embedded = &glb[bin..bin + view["byteLength"].as_u64().unwrap() as usize];
+            let colour_png = std::fs::read(dir.join("extracted/data.farc_files/unnamed").join(format!("{}.tex.png", hex(&tex_sha1)))).unwrap();
+            assert_eq!(embedded, colour_png.as_slice());
+            assert!(dir.join("extracted/data.farc_files/gamedata/props/crate.mol").exists());
+            std::fs::remove_dir_all(&dir).unwrap();
+        }
+    }
+
+    #[test]
+    fn unswizzles_ps3_textures() {
+        // 4x4 texels, 1 byte each: swizzled order interleaves x and y bits.
+        let linear: Vec<u8> = (0..16).collect();
+        let mut swizzled = vec![0u8; 16];
+        for y in 0..4u32 {
+            for x in 0..4u32 {
+                let mut m = 0;
+                for i in 0..2 {
+                    m |= ((x >> i) & 1) << (2 * i) | ((y >> i) & 1) << (2 * i + 1);
+                }
+                swizzled[m as usize] = linear[(y * 4 + x) as usize];
+            }
+        }
+        assert_eq!(unswizzle_gtf(&swizzled, 4, 4, 1).unwrap(), linear);
+    }
+}
