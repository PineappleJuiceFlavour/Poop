+// Archives and databases
+
+#[derive(Clone, Debug)]
+pub struct FarcEntry {
+    pub sha1: Sha1,
+    pub offset: u64,
+    pub size: u64,
+}
+
+/// Reads a `.farc` archive's table (at the end of the file: entries, count, `FARC`).
+pub fn read_farc(file: &mut (impl Read + Seek)) -> Result<Vec<FarcEntry>, String> {
+    let length = file.seek(SeekFrom::End(0)).map_err(|e| e.to_string())?;
+    if length < 8 {
+        return Err("too small for a FARC".into());
+    }
+    let mut tail = [0u8; 8];
+    file.seek(SeekFrom::Start(length - 8)).and_then(|_| file.read_exact(&mut tail)).map_err(|e| e.to_string())?;
+    if &tail[4..] != b"FARC" {
+        return Err("not a FARC archive".into());
+    }
+    let count = u32::from_be_bytes(tail[..4].try_into().unwrap()) as u64;
+    let table_size = count * 0x1C;
+    if table_size + 8 > length {
+        return Err("FARC table is larger than the file".into());
+    }
+    let mut table = vec![0u8; table_size as usize];
+    file.seek(SeekFrom::Start(length - 8 - table_size)).and_then(|_| file.read_exact(&mut table)).map_err(|e| e.to_string())?;
+    Ok(table
+        .chunks_exact(0x1C)
+        .map(|e| FarcEntry {
+            sha1: e[..20].try_into().unwrap(),
+            offset: u32::from_be_bytes(e[20..24].try_into().unwrap()) as u64,
+            size: u32::from_be_bytes(e[24..28].try_into().unwrap()) as u64,
+        })
+        .filter(|e| e.offset + e.size <= length)
+        .collect())
+}
+
+#[derive(Clone, Debug)]
+pub struct DbRow {
+    pub path: String,
+    pub sha1: Sha1,
+    pub guid: u32,
+}
+
+/// Reads a `.map` file database (path, timestamp, size, SHA-1 and GUID of every game file).
+pub fn read_map(bytes: &[u8]) -> Option<Vec<DbRow>> {
+    let mut r = Reader::new(bytes, 0);
+    let revision = r.u32_raw()?;
+    let lbp3 = (revision >> 16) >= 0x148;
+    let count = r.u32_raw()? as usize;
+    if count > bytes.len() / 30 {
+        return None;
+    }
+    let mut rows = Vec::with_capacity(count);
+    for _ in 0..count {
+        let len = if lbp3 { r.u16()? as usize } else { r.u32_raw()? as usize };
+        let path = String::from_utf8_lossy(r.bytes(len)?).trim_end_matches('\0').to_string();
+        r.bytes(if lbp3 { 4 } else { 8 })?; // timestamp
+        r.u32_raw()?; // size
+        let sha1: Sha1 = r.bytes(20)?.try_into().ok()?;
+        let guid = r.u32_raw()?;
+        // LittleBigPlanet Vita databases store only extensions; name those by hash.
+        let path = if !path.contains('/') && path.starts_with('.') { format!("data/{}{path}", hex(&sha1)) } else { path };
+        rows.push(DbRow { path, sha1, guid });
+    }
+    Some(rows)
+}
