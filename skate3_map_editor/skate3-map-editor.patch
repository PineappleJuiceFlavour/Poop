+/// Whether `bytes` starts like a LittleBigPlanet resource.
+pub fn is_resource(bytes: &[u8]) -> bool {
+    bytes.len() >= 8 && kind(&bytes[..3]).is_some() && matches!(bytes[3], b'b' | b't' | b'e' | b' ' | b's' | b'S')
+}
