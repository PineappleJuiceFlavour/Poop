+    /// Wraps a body as a binary resource of revision `head` (uncompressed body, no dependencies).
+    fn resource(magic: &[u8; 4], head: u32, body: &[u8], deps: &[(Option<u32>, Option<Sha1>, u32)]) -> Vec<u8> {
+        let mut out = magic.to_vec();
+        out.extend(head.to_be_bytes());
+        out.extend(0u32.to_be_bytes()); // dependency table offset, filled in below
+        if head >= 0x271 {
+            out.extend([0, 0, 0, 0]); // branch
+        }
+        if head >= 0x297 {
+            out.push(0); // compression flags
+        }
+        if head >= 0x189 {
+            out.push(1); // compressed
+        }
+        // Compressor header with one stored (not deflated) chunk.
+        out.extend(1u16.to_be_bytes());
+        out.extend(1u16.to_be_bytes());
+        out.extend((body.len() as u16).to_be_bytes());
+        out.extend((body.len() as u16).to_be_bytes());
+        out.extend(body);
+        let table_at = out.len();
+        out[8..12].copy_from_slice(&(table_at as u32).to_be_bytes());
+        out.extend((deps.len() as u32).to_be_bytes());
+        for (guid, sha1, kind) in deps {
+            out.push(guid.map_or(0, |_| 2) | sha1.map_or(0, |_| 1));
+            if let Some(g) = guid {
+                out.extend(g.to_be_bytes());
+            }
+            if let Some(s) = sha1 {
+                out.extend(s);
+            }
+            out.extend(kind.to_be_bytes());
+        }
+        out
+    }
