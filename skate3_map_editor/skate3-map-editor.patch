+// ---------------------------------------------------------------------------------------------
+// Unpacking a game
+
+fn head(path: &Path, n: usize) -> Vec<u8> {
+    let mut buf = vec![0u8; n];
+    let read = File::open(path).and_then(|mut f| f.read(&mut buf)).unwrap_or(0);
+    buf.truncate(read);
+    buf
+}
+
+/// Unpacks every `.rcf` archive among `files` into `<archive>_files/`, then converts every
+/// Pure3D file. Returns the unpacked files and the files it handled.
+pub fn unpack(files: &[(PathBuf, String)], out: &mut Output) -> (Vec<(PathBuf, String)>, HashSet<String>) {
+    let mut new_files = Vec::new();
+    let mut handled = HashSet::new();
+    for (path, rel) in files {
+        if !is_rcf(&head(path, 32)) {
+            continue;
+        }
+        let Ok(mut file) = File::open(path) else { continue };
+        let entries = match read_rcf(&mut file) {
+            Ok(entries) => entries,
+            Err(e) => {
+                out.add_note(format!("{rel}: {e}"));
+                continue;
+            }
+        };
+        out.report.archives += 1;
+        handled.insert(rel.clone());
+        for (i, entry) in entries.iter().enumerate() {
+            if i % 32 == 0 {
+                out.status(format!("Unpacking {rel}: {}/{} files", i, entries.len()));
+            }
+            let Some(bytes) = (entry.size <= 1 << 30).then(|| read_at(&mut file, entry.offset, entry.size as usize)).flatten() else { continue };
+            let inner = format!("{rel}_files/{}", safe_path(&entry.name).to_string_lossy().replace('\\', "/"));
+            if out.write_extracted(Path::new(&inner), &bytes) {
+                new_files.push((out.dir.join(&inner), inner));
+            }
+        }
+    }
+
+    // Pure3D: index shaders and textures across files first, they're shared.
+    let p3ds: Vec<&(PathBuf, String)> = files.iter().chain(new_files.iter()).filter(|(p, _)| p3d_kind(&head(p, 4)).is_some()).collect();
+    let mut library = Library::default();
+    for (n, (path, _)) in p3ds.iter().enumerate() {
+        if n % 16 == 0 {
+            out.status(format!("Indexing Pure3D textures and shaders: {n}/{}", p3ds.len()));
+        }
+        let Some(p3d) = std::fs::read(path).ok().and_then(P3d::open) else { continue };
+        let f = p3d.fields();
+        let Some(root) = p3d.root() else { continue };
+        for c in root.walk() {
+            match c.id {
+                0x11000 => {
+                    if let Some((name, s)) = shader(c, f) {
+                        library.shaders.entry(name).or_insert(s);
+                    }
+                }
+                0x19000 => {
+                    if let Some((name, _)) = f.string(c.data, 0) {
+                        library.textures.entry(name.to_ascii_lowercase()).or_insert_with(|| path.clone());
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+    for (n, (path, rel)) in p3ds.iter().enumerate() {
+        out.status(format!(
+            "Converting Pure3D ({}/{}): {rel}  [{} models, {} images]",
+            n + 1,
+            p3ds.len(),
+            out.report.models.len(),
+            out.report.textures
+        ));
+        if convert_p3d(path, rel, &mut library, out) {
+            out.report.converted += 1;
+        }
+        handled.insert(rel.clone());
+    }
+    for (kind, count) in &library.failed_images {
+        out.add_note(format!("Pure3D images not decoded ({count}): {kind}"));
+    }
+    for (kind, count) in &library.missing_shaders {
+        out.add_note(format!("Pure3D materials without a texture ({count}): {kind}"));
+    }
+    for (kind, count) in library.failed_groups.iter().take(20) {
+        out.add_note(format!("Pure3D mesh parts without readable geometry ({count}): {kind}"));
+    }
+    if !p3ds.is_empty() {
+        out.add_note(format!(
+            "Pure3D (.p3d): {} files. Each became one model of everything in it (placed as the game places it), plus one model per object in {{file}}_parts when it holds several; textures became PNGs in {{file}}_textures.",
+            p3ds.len()
+        ));
+    }
+    (new_files, handled)
+}
