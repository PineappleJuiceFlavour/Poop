+    /// A v1.2 RCF with two files, little-endian (PS2/PC/Xbox) or big-endian (GameCube).
+    fn rcf(big: bool, files: &[(&str, &[u8])]) -> Vec<u8> {
+        let u = |v: u32| if big { v.to_be_bytes() } else { v.to_le_bytes() };
+        let mut out = vec![0u8; 0x800];
+        out[..22].copy_from_slice(b"RADCORE CEMENT LIBRARY");
+        out[0x20..0x24].copy_from_slice(&[1, 2, big as u8, 1]);
+        out[0x24..0x28].copy_from_slice(&u(0x800));
+        out[0x2C..0x30].copy_from_slice(&u(0x800));
+        let dir_len = 16 + files.len() * 12;
+        let mut names = Vec::new();
+        names.extend(u(files.len() as u32));
+        names.extend(u(0));
+        for (name, _) in files {
+            names.extend(u(name.len() as u32 + 1));
+            names.extend(name.as_bytes());
+            names.push(0);
+            names.extend(u(0));
+        }
+        let names_at = 0x800 + dir_len;
+        let mut data_at = (names_at + names.len()).next_multiple_of(0x800);
+        let mut table: Vec<(u32, u32, u32)> = Vec::new();
+        let mut blobs = Vec::new();
+        for (name, data) in files {
+            table.push((rcf_hash(name), data_at as u32, data.len() as u32));
+            blobs.push((data_at, data.to_vec()));
+            data_at = (data_at + data.len()).next_multiple_of(0x800);
+        }
+        table.sort();
+        out.extend(u(files.len() as u32));
+        out.extend(u(names_at as u32));
+        out.extend(u(0));
+        out.extend(0u32.to_le_bytes());
+        for (h, o, s) in table {
+            out.extend(u(h));
+            out.extend(u(o));
+            out.extend(u(s));
+        }
+        out.extend(names);
+        for (at, data) in blobs {
+            out.resize(at, 0);
+            out.extend(data);
+        }
+        out.resize(out.len().next_multiple_of(0x800), 0);
+        out
+    }
