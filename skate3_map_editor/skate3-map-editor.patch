index 0000000..38dda2b
--- /dev/null
+++ b/crates/skate-map-editor/src/disc.rs
@@ -0,0 +1,658 @@
+//! Extracts everything from a game disc image the player owns, a dumped game folder, or a game
+//! archive, and converts what it can.
+//!
+//! Reads the disc's file system (Xbox / Xbox 360 XDVDFS, ISO 9660 for PS1, PS2, PS3, PSP and PC
+//! discs, raw `.bin`/`.cue` CD images, or a GameCube disc) and copies every file out. Then it
+//! unpacks the game's archives (Radical `.rcf`, LittleBigPlanet `.farc`) and converts each file it
+//! has a converter for: models to `.glb` (listed in the asset browser), images to `.png`, sounds
+//! to `.wav` (see [`crate::convert`], [`crate::radical`], [`crate::lbp`]).
+
+use std::collections::HashSet;
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+
+const SECTOR: u64 = 2048;
+
+/// File extensions treated as disc images.
+pub fn is_disc_image(path: &Path) -> bool {
+    path.extension()
+        .map(|e| e.to_string_lossy().to_ascii_lowercase())
+        .is_some_and(|e| matches!(e.as_str(), "iso" | "xiso" | "gcm" | "bin" | "img" | "cue"))
+}
+
+/// One file on the disc.
+#[derive(Clone, Debug)]
+pub struct DiscFile {
+    /// Path inside the disc, `/` separated.
+    pub path: String,
+    /// Byte offset in the image.
+    pub offset: u64,
+    pub size: u64,
+}
+
+/// The disc's files and which file system it uses.
+pub struct Disc {
+    pub format: &'static str,
+    pub files: Vec<DiscFile>,
+}
+
+/// Lists every file on the disc image.
+pub fn read_disc(image: &mut (impl Read + Seek)) -> Result<Disc, String> {
+    let length = image.seek(SeekFrom::End(0)).map_err(|e| e.to_string())?;
+    // Xbox 360 game partitions sit at a fixed offset per disc type; plain .xiso images at 0.
+    for base in [0u64, 0x0FD9_0000, 0x0208_0000, 0x1830_0000] {
+        if base + 0x10000 + 0x800 <= length && read_at(image, base + 0x10000, 20)? == b"MICROSOFT*XBOX*MEDIA" {
+            return Ok(Disc { format: "Xbox (XDVDFS)", files: xdvdfs(image, base)? });
+        }
+    }
+    if length >= 0x8006 && &read_at(image, 0x8001, 5)? == b"CD001" {
+        return Ok(Disc { format: "ISO 9660", files: iso9660(image)? });
+    }
+    if length >= 0x440 && read_at(image, 0x1C, 4)? == [0xC2, 0x33, 0x9F, 0x3D] {
+        return Ok(Disc { format: "GameCube", files: gamecube(image)? });
+    }
+    Err("not a disc image the editor can read (Xbox, Xbox 360, PS2, PSP, PC or GameCube)".into())
+}
+
+fn read_at(image: &mut (impl Read + Seek), offset: u64, len: usize) -> Result<Vec<u8>, String> {
+    let mut buf = vec![0; len];
+    image.seek(SeekFrom::Start(offset)).map_err(|e| e.to_string())?;
+    image.read_exact(&mut buf).map_err(|e| format!("disc image is cut short: {e}"))?;
+    Ok(buf)
+}
+
+fn u16le(b: &[u8], at: usize) -> u16 {
+    u16::from_le_bytes([b[at], b[at + 1]])
+}
+fn u32le(b: &[u8], at: usize) -> u32 {
+    u32::from_le_bytes(b[at..at + 4].try_into().unwrap())
+}
+fn u32be(b: &[u8], at: usize) -> u32 {
+    u32::from_be_bytes(b[at..at + 4].try_into().unwrap())
+}
+
+/// Xbox file system: each directory is a binary tree of entries.
+fn xdvdfs(image: &mut (impl Read + Seek), base: u64) -> Result<Vec<DiscFile>, String> {
+    let volume = read_at(image, base + 0x10000, 0x800)?;
+    let (root_sector, root_size) = (u32le(&volume, 20) as u64, u32le(&volume, 24) as u64);
+    let mut files = Vec::new();
+    let mut seen = HashSet::new();
+    let mut directories = vec![(String::new(), root_sector, root_size)];
+    while let Some((prefix, sector, size)) = directories.pop() {
+        if size == 0 || size > 64 << 20 || !seen.insert(sector) {
+            continue;
+        }
+        let table = read_at(image, base + sector * SECTOR, size as usize)?;
+        let mut stack = vec![0usize];
+        let mut visited = HashSet::new();
+        while let Some(at) = stack.pop() {
+            if at + 14 > table.len() || !visited.insert(at) {
+                continue;
+            }
+            let (left, right) = (u16le(&table, at), u16le(&table, at + 2));
+            if left == 0xFFFF && right == 0xFFFF {
+                continue;
+            }
+            let (start, length, attributes, name_len) =
+                (u32le(&table, at + 4) as u64, u32le(&table, at + 8) as u64, table[at + 12], table[at + 13] as usize);
+            if at + 14 + name_len > table.len() {
+                continue;
+            }
+            let name = String::from_utf8_lossy(&table[at + 14..at + 14 + name_len]).into_owned();
+            let path = format!("{prefix}{name}");
+            if attributes & 0x10 != 0 {
+                directories.push((format!("{path}/"), start, length));
+            } else {
+                files.push(DiscFile { path, offset: base + start * SECTOR, size: length });
+            }
+            for child in [left, right] {
+                if child != 0 && child != 0xFFFF {
+                    stack.push(child as usize * 4);
+                }
+            }
+        }
+    }
+    Ok(files)
+}
+
+/// ISO 9660: directory records in extents, from the primary volume descriptor's root.
+fn iso9660(image: &mut (impl Read + Seek)) -> Result<Vec<DiscFile>, String> {
+    let descriptor = read_at(image, 0x8000, 0x800)?;
+    let root = &descriptor[156..190];
+    let mut files = Vec::new();
+    let mut seen = HashSet::new();
+    let mut directories = vec![(String::new(), u32le(root, 2) as u64, u32le(root, 10) as u64)];
+    while let Some((prefix, extent, size)) = directories.pop() {
+        if size == 0 || size > 64 << 20 || !seen.insert(extent) {
+            continue;
+        }
+        let table = read_at(image, extent * SECTOR, size as usize)?;
+        let mut at = 0;
+        while at < table.len() {
+            let len = table[at] as usize;
+            if len == 0 {
+                // Records never cross a sector boundary: the rest of this sector is padding.
+                at = (at / SECTOR as usize + 1) * SECTOR as usize;
+                continue;
+            }
+            if at + len > table.len() || len < 34 {
+                break;
+            }
+            let record = &table[at..at + len];
+            let name_len = record[32] as usize;
+            let name_bytes = &record[33..(33 + name_len).min(len)];
+            at += len;
+            if name_bytes == [0] || name_bytes == [1] {
+                continue;
+            }
+            let name = String::from_utf8_lossy(name_bytes);
+            let name = name.split(';').next().unwrap_or_default().trim_end_matches('.').to_string();
+            let (start, length) = (u32le(record, 2) as u64, u32le(record, 10) as u64);
+            if record[25] & 0x02 != 0 {
+                directories.push((format!("{prefix}{name}/"), start, length));
+            } else {
+                files.push(DiscFile { path: format!("{prefix}{name}"), offset: start * SECTOR, size: length });
+            }
+        }
+    }
+    Ok(files)
+}
+
+/// GameCube: a flat file system table of 12-byte entries plus a name table.
+fn gamecube(image: &mut (impl Read + Seek)) -> Result<Vec<DiscFile>, String> {
+    let header = read_at(image, 0x420, 0x10)?;
+    let (fst_offset, fst_size) = (u32be(&header, 4) as u64, u32be(&header, 8) as usize);
+    if fst_size < 12 || fst_size > 64 << 20 {
+        return Err("GameCube disc has no file table".into());
+    }
+    let fst = read_at(image, fst_offset, fst_size)?;
+    let count = u32be(&fst, 8) as usize;
+    if count == 0 || count * 12 > fst.len() {
+        return Err("GameCube file table is damaged".into());
+    }
+    let names = &fst[count * 12..];
+    let name_at = |offset: usize| -> String {
+        let end = names[offset.min(names.len())..].iter().position(|&b| b == 0).map_or(names.len(), |p| offset + p);
+        String::from_utf8_lossy(&names[offset.min(names.len())..end]).into_owned()
+    };
+    let mut files = Vec::new();
+    // (directory path, index where it ends)
+    let mut stack: Vec<(String, usize)> = vec![(String::new(), count)];
+    for i in 1..count {
+        while stack.len() > 1 && i >= stack.last().unwrap().1 {
+            stack.pop();
+        }
+        let entry = &fst[i * 12..i * 12 + 12];
+        let word = u32be(entry, 0);
+        let name = name_at((word & 0x00FF_FFFF) as usize);
+        let prefix = stack.last().unwrap().0.clone();
+        if word >> 24 != 0 {
+            stack.push((format!("{prefix}{name}/"), u32be(entry, 8) as usize));
+        } else {
+            files.push(DiscFile { path: format!("{prefix}{name}"), offset: u32be(entry, 4) as u64, size: u32be(entry, 8) as u64 });
+        }
+    }
+    Ok(files)
+}
+
+// ---------------------------------------------------------------------------------------------
+// Raw CD images
+
+/// A raw CD image (`.bin`/`.img`: 2352-byte sectors with sync, header and error correction) read
+/// as plain 2048-byte sectors.
+struct RawSectors<R> {
+    inner: R,
+    /// Where the 2048 user-data bytes start in each 2352-byte sector.
+    data: u64,
+    pos: u64,
+    len: u64,
+}
+
+const RAW_SECTOR: u64 = 2352;
+
+impl<R: Read + Seek> RawSectors<R> {
+    /// Recognises a raw image by the sync pattern of its first sector.
+    fn open(mut inner: R) -> Option<Self> {
+        let length = inner.seek(SeekFrom::End(0)).ok()?;
+        let head = read_at(&mut inner, 0, 16).ok()?;
+        if head[..12] != [0, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 0] {
+            return None;
+        }
+        // Mode 1 data follows the 16-byte header; mode 2 (form 1) has an 8-byte subheader too.
+        let data = if head[15] == 2 { 24 } else { 16 };
+        Some(RawSectors { inner, data, pos: 0, len: length / RAW_SECTOR * SECTOR })
+    }
+}
+
+impl<R: Read + Seek> Read for RawSectors<R> {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        if self.pos >= self.len || buf.is_empty() {
+            return Ok(0);
+        }
+        let (sector, within) = (self.pos / SECTOR, self.pos % SECTOR);
+        let n = buf.len().min((SECTOR - within) as usize).min((self.len - self.pos) as usize);
+        self.inner.seek(SeekFrom::Start(sector * RAW_SECTOR + self.data + within))?;
+        let n = self.inner.read(&mut buf[..n])?;
+        self.pos += n as u64;
+        Ok(n)
+    }
+}
+
+impl<R: Read + Seek> Seek for RawSectors<R> {
+    fn seek(&mut self, to: SeekFrom) -> std::io::Result<u64> {
+        let pos = match to {
+            SeekFrom::Start(p) => p as i64,
+            SeekFrom::End(d) => self.len as i64 + d,
+            SeekFrom::Current(d) => self.pos as i64 + d,
+        };
+        if pos < 0 {
+            return Err(std::io::Error::new(std::io::ErrorKind::InvalidInput, "seek before start"));
+        }
+        self.pos = pos as u64;
+        Ok(self.pos)
+    }
+}
+
+trait ReadSeek: Read + Seek {}
+impl<T: Read + Seek> ReadSeek for T {}
+
+/// The data track a `.cue` sheet points to.
+fn cue_target(cue: &Path) -> Option<PathBuf> {
+    let text = std::fs::read_to_string(cue).ok()?;
+    let line = text.lines().find(|l| l.trim_start().to_ascii_uppercase().starts_with("FILE"))?;
+    let name = line.split('"').nth(1).map(str::to_string).or_else(|| line.split_whitespace().nth(1).map(str::to_string))?;
+    Some(cue.parent()?.join(name))
+}
+
+/// Opens a disc image of any supported kind: plain 2048-byte sectors or a raw CD image.
+fn open_disc(path: &Path) -> Result<(Box<dyn ReadSeek>, Disc), String> {
+    let path = if path.extension().is_some_and(|e| e.eq_ignore_ascii_case("cue")) {
+        cue_target(path).ok_or("the .cue sheet doesn't name its .bin file")?
+    } else {
+        path.to_path_buf()
+    };
+    let open = || File::open(&path).map_err(|e| format!("can't open {}: {e}", path.display()));
+    let mut plain = open()?;
+    let plain_error = match read_disc(&mut plain) {
+        Ok(disc) => return Ok((Box::new(plain), disc)),
+        Err(e) => e,
+    };
+    if let Some(mut raw) = RawSectors::open(open()?) {
+        let mut disc = read_disc(&mut raw)?;
+        disc.format = if disc.format == "ISO 9660" { "ISO 9660 (raw CD image)" } else { disc.format };
+        return Ok((Box::new(raw), disc));
+    }
+    Err(plain_error)
+}
+
+// ---------------------------------------------------------------------------------------------
+// Extraction
+
+pub use crate::convert::DiscReport;
+use crate::convert::{Output, extension, safe_name, safe_path};
+
+/// Shared between the import thread and the editor UI.
+#[derive(Default)]
+pub struct DiscProgress {
+    pub status: String,
+    pub finished: Option<Result<DiscReport, String>>,
+}
+
+/// Starts importing `source` on a background thread.
+pub fn spawn_import(source: PathBuf, assets_root: PathBuf) -> Arc<Mutex<DiscProgress>> {
+    let progress = Arc::new(Mutex::new(DiscProgress { status: "Reading disc...".into(), finished: None }));
+    let shared = progress.clone();
+    std::thread::spawn(move || {
+        let status = shared.clone();
+        let result = import(
+            &source,
+            &assets_root,
+            Box::new(move |text| {
+                if let Ok(mut p) = status.lock() {
+                    p.status = text;
+                }
+            }),
+        );
+        if let Ok(mut p) = shared.lock() {
+            p.finished = Some(result);
+        }
+    });
+    progress
+}
+
+/// Every file of a folder, as (path, path relative to the folder with `/`).
+fn walk(root: &Path) -> Vec<(PathBuf, String)> {
+    let mut out = Vec::new();
+    let mut dirs = vec![root.to_path_buf()];
+    while let Some(dir) = dirs.pop() {
+        let Ok(entries) = std::fs::read_dir(&dir) else { continue };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            if entry.file_type().is_ok_and(|t| t.is_dir()) {
+                dirs.push(path);
+            } else if let Ok(rel) = path.strip_prefix(root) {
+                out.push((path.clone(), rel.to_string_lossy().replace('\\', "/")));
+            }
+        }
+    }
+    out.sort_by(|a, b| a.1.cmp(&b.1));
+    out
+}
+
+/// Copies one file out of the disc image in pieces.
+fn copy_out(image: &mut dyn ReadSeek, file: &DiscFile, target: &Path) -> std::io::Result<()> {
+    if let Some(dir) = target.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    image.seek(SeekFrom::Start(file.offset))?;
+    let mut writer = std::io::BufWriter::new(File::create(target)?);
+    std::io::copy(&mut image.take(file.size), &mut writer)?;
+    Ok(())
+}
+
+/// Files larger than this are copied out but not converted (they'd be read whole).
+const MAX_CONVERT: u64 = 1 << 30;
+
+/// Copies every file out of a disc image (or takes a dropped folder or archive), unpacks the
+/// game's archives, and converts everything it can.
+///
+/// Everything lands in `<game>/extracted/<name>/`; models also go to
+/// `<assets>/imported/<name>/`, where the asset browser lists them.
+pub fn import(source: &Path, assets_root: &Path, status: Box<dyn Fn(String)>) -> Result<DiscReport, String> {
+    let stem = if source.is_dir() { source.file_name() } else { source.file_stem() };
+    let name = safe_name(&stem.unwrap_or_default().to_string_lossy());
+    let game_dir = assets_root.parent().unwrap_or(assets_root);
+    let dir = game_dir.join("extracted").join(&name);
+    let mut out = Output::new(&dir, assets_root, &name, status);
+    let mut files: Vec<(PathBuf, String)> = Vec::new();
+
+    if source.is_dir() {
+        out.report.format = "folder".into();
+        files = walk(source);
+    } else if let Some(opened) = is_disc_image(source).then(|| open_disc(source)).and_then(|r| match r {
+        // A `.bin`/`.img` that isn't a disc is just a game file.
+        Err(_) if !source.extension().is_some_and(|e| ["iso", "xiso", "gcm", "cue"].iter().any(|x| e.eq_ignore_ascii_case(x))) => None,
+        r => Some(r),
+    }) {
+        let (mut image, disc) = opened?;
+        out.report.format = disc.format.into();
+        let total = disc.files.iter().map(|f| f.size).sum::<u64>().max(1);
+        let mut done = 0u64;
+        for file in &disc.files {
+            done += file.size;
+            out.status(format!("Copying files off {name} ({:.0}%): {}", done as f64 * 100.0 / total as f64, file.path));
+            let rel = safe_path(&file.path);
+            let target = dir.join(&rel);
+            match copy_out(&mut *image, file, &target) {
+                Ok(()) => {
+                    out.report.extracted += 1;
+                    files.push((target, rel.to_string_lossy().replace('\\', "/")));
+                }
+                Err(e) => out.add_note(format!("Couldn't copy {}: {e}", file.path)),
+            }
+        }
+    } else {
+        out.report.format = "file".into();
+        let file_name = source.file_name().unwrap_or_default().to_string_lossy().into_owned();
+        files.push((source.to_path_buf(), file_name));
+    }
+    out.report.files = files.len();
+
+    // Archives: their contents join the files to convert.
+    let mut handled = std::collections::HashSet::new();
+    let (radical_files, radical_handled) = crate::radical::unpack(&files, &mut out);
+    handled.extend(radical_handled);
+    files.extend(radical_files);
+    let (lbp_files, lbp_handled) = crate::lbp::unpack(&files, &mut out);
+    handled.extend(lbp_handled);
+    files.extend(lbp_files);
+
+    let by_rel: std::collections::HashMap<String, PathBuf> = files.iter().map(|(p, r)| (r.to_ascii_lowercase(), p.clone())).collect();
+    let sibling = |rel: &str| by_rel.get(&rel.to_ascii_lowercase()).and_then(|p| std::fs::read(p).ok());
+    let total = files.len();
+    for (n, (path, rel)) in files.iter().enumerate() {
+        if handled.contains(rel) {
+            continue;
+        }
+        out.status(format!(
+            "Converting {name} ({}/{total}): {rel}  [{} models, {} images, {} sounds]",
+            n + 1,
+            out.report.models.len(),
+            out.report.textures,
+            out.report.sounds
+        ));
+        let size = std::fs::metadata(path).map(|m| m.len()).unwrap_or(0);
+        let converted = if extension(rel) == "pss" {
+            // Movies can be huge: copy instead of reading them whole.
+            let target = dir.join(crate::convert::with_suffix(rel, ".mpg"));
+            let ok = target.parent().is_some_and(|d| std::fs::create_dir_all(d).is_ok()) && std::fs::copy(path, &target).is_ok();
+            if ok {
+                out.report.converted += 1;
+                out.add_note("PS2 movies (.pss) were copied as .mpg; their video plays in VLC, the PS2 audio track may not.".into());
+            }
+            ok
+        } else if size > MAX_CONVERT || size == 0 {
+            false
+        } else {
+            match std::fs::read(path) {
+                Ok(bytes) => crate::convert::convert(rel, &bytes, &mut out, &sibling),
+                Err(_) => false,
+            }
+        };
+        if !converted {
+            let ext = extension(rel);
+            *out.report.other.entry(if ext.is_empty() { "(none)".into() } else { ext }).or_default() += 1;
+        }
+    }
+
+    let report = &out.report;
+    let mut text = format!(
+        "{} ({})\n\n{} files, {} written to this folder (disc files and archive contents), {} archives unpacked.\n{} models (in {}/imported/{}), {} images (.png), {} sounds (.wav), {} conversions in all.\n",
+        report.disc,
+        report.format,
+        report.files,
+        report.extracted,
+        report.archives,
+        report.models.len(),
+        assets_root.display(),
+        report.disc,
+        report.textures,
+        report.sounds,
+        report.converted
+    );
+    for note in &report.notes {
+        text.push_str(&format!("\n{note}\n"));
+    }
+    text.push_str("\nFiles copied out as they are (no converter for these types; code, game data or unknown formats):\n");
+    let mut other: Vec<_> = report.other.iter().collect();
+    other.sort_by(|a, b| b.1.cmp(a.1));
+    for (extension, count) in other {
+        text.push_str(&format!("  .{extension}: {count}\n"));
+    }
+    let _ = std::fs::write(dir.join("_disc_report.txt"), text);
+    Ok(out.report)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::convert::{is_glb, obj_to_glb};
+    use std::io::Cursor;
+
+    const OBJ: &str = "v 0 0 0\nv 1 0 0\nv 1 1 0\nv 0 1 0\nvt 0 0\nvt 1 0\nvt 1 1\nvt 0 1\nf 1/1 2/2 3/3 4/4\n";
+
+    fn glb() -> Vec<u8> {
+        obj_to_glb(OBJ).unwrap()
+    }
+
+    /// A tiny Xbox disc: root holds `models/` (with `crate.glb`) and an archive with a model inside.
+    fn xdvdfs_image(base: usize) -> Vec<u8> {
+        let model = glb();
+        let mut archive = b"HEADERJUNK".to_vec();
+        archive.extend(&model);
+        archive.extend(b"TRAILER");
+        let mut image = vec![0u8; base + 0x20000];
+        let sector = |s: usize| base + s * 2048;
+        image[sector(32)..sector(32) + 20].copy_from_slice(b"MICROSOFT*XBOX*MEDIA");
+        // Entry: left, right, sector, size, attributes, name length, name (padded to 4).
+        let entry = |left: u16, right: u16, start: u32, size: u32, attr: u8, name: &str| {
+            let mut e = Vec::new();
+            e.extend(left.to_le_bytes());
+            e.extend(right.to_le_bytes());
+            e.extend(start.to_le_bytes());
+            e.extend(size.to_le_bytes());
+            e.push(attr);
+            e.push(name.len() as u8);
+            e.extend(name.as_bytes());
+            while e.len() % 4 != 0 {
+                e.push(0xFF);
+            }
+            e
+        };
+        let place = |image: &mut Vec<u8>, s: usize, bytes: &[u8]| {
+            let at = sector(s);
+            if image.len() < at + bytes.len() {
+                image.resize(at + bytes.len(), 0);
+            }
+            image[at..at + bytes.len()].copy_from_slice(bytes);
+        };
+        // Root (sector 40): "models" dir with "pack.bin" as its right child.
+        let second = entry(0, 0, 50, archive.len() as u32, 0x20, "pack.bin");
+        let first = entry(0, 0, 0, 0, 0x10, "models");
+        let first = entry(0, (first.len() / 4) as u16, 41, 2048, 0x10, "models");
+        let mut root = first.clone();
+        root.extend(&second);
+        place(&mut image, 40, &root);
+        // models/ (sector 41): crate.glb at sector 42.
+        place(&mut image, 41, &entry(0, 0, 42, model.len() as u32, 0x20, "crate.glb"));
+        place(&mut image, 42, &model);
+        place(&mut image, 50, &archive);
+        let volume = sector(32);
+        image[volume + 20..volume + 24].copy_from_slice(&40u32.to_le_bytes());
+        image[volume + 24..volume + 28].copy_from_slice(&(root.len() as u32).to_le_bytes());
+        image
+    }
+
+    #[test]
+    fn obj_becomes_a_valid_glb() {
+        let glb = glb();
+        assert!(is_glb(&glb));
+        assert_eq!(u32le(&glb, 8) as usize, glb.len());
+        let json_len = u32le(&glb, 12) as usize;
+        let json: serde_json::Value = serde_json::from_slice(&glb[20..20 + json_len]).unwrap();
+        assert_eq!(json["accessors"][0]["count"], 4);
+        assert_eq!(json["accessors"][3]["count"], 6, "quad split into two triangles");
+    }
+
+    #[test]
+    fn reads_xbox_discs_at_every_partition_offset() {
+        for base in [0usize, 0x0208_0000] {
+            let mut image = Cursor::new(xdvdfs_image(base));
+            let disc = read_disc(&mut image).unwrap();
+            assert_eq!(disc.format, "Xbox (XDVDFS)");
+            let mut paths: Vec<_> = disc.files.iter().map(|f| f.path.as_str()).collect();
+            paths.sort();
+            assert_eq!(paths, ["models/crate.glb", "pack.bin"]);
+        }
+    }
+
+    #[test]
+    fn imports_models_and_models_hidden_in_archives() {
+        let dir = std::env::temp_dir().join(format!("disc-import-test-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let image = dir.join("My Game.iso");
+        std::fs::write(&image, xdvdfs_image(0)).unwrap();
+        let assets = dir.join("assets");
+        let report = import(&image, &assets, Box::new(|_| {})).unwrap();
+        let mut models = report.models.clone();
+        models.sort();
+        assert_eq!(models, ["imported/My_Game/models/crate.glb", "imported/My_Game/pack.bin.0.glb"]);
+        for model in &models {
+            assert!(is_glb(&std::fs::read(assets.join(model)).unwrap()));
+        }
+        // Every disc file is copied out as it is, next to the report.
+        let extracted = dir.join("extracted/My_Game");
+        assert!(extracted.join("_disc_report.txt").is_file());
+        assert!(extracted.join("models/crate.glb").is_file() && extracted.join("pack.bin").is_file());
+        assert_eq!(report.extracted, 2);
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn paths_from_the_disc_stay_inside_the_output_folder() {
+        assert_eq!(safe_path("../../evil/../x.glb"), PathBuf::from("evil").join("x.glb"));
+        assert_eq!(safe_path("a\\b:c.glb"), PathBuf::from("a").join("b_c.glb"));
+    }
+
+    /// Primary volume descriptor at sector 16; root directory at sector 20 holding
+    /// ".", ".." and MODELS/ (sector 21) with BENCH.OBJ;1 at sector 22.
+    fn iso_image() -> Vec<u8> {
+        let mut image = vec![0u8; 23 * 2048];
+        let record = |extent: u32, size: u32, dir: bool, name: &[u8]| {
+            let mut r = vec![0u8; 33];
+            r[2..6].copy_from_slice(&extent.to_le_bytes());
+            r[10..14].copy_from_slice(&size.to_le_bytes());
+            r[25] = if dir { 2 } else { 0 };
+            r[32] = name.len() as u8;
+            r.extend(name);
+            if r.len() % 2 == 1 {
+                r.push(0);
+            }
+            r[0] = r.len() as u8;
+            r
+        };
+        let put = |image: &mut Vec<u8>, at: usize, bytes: &[u8]| image[at..at + bytes.len()].copy_from_slice(bytes);
+        put(&mut image, 0x8000, &[1]);
+        put(&mut image, 0x8001, b"CD001");
+        put(&mut image, 0x8000 + 156, &record(20, 2048, true, &[0])[..34]);
+        let mut root = record(20, 2048, true, &[0]);
+        root.extend(record(20, 2048, true, &[1]));
+        root.extend(record(21, 2048, true, b"MODELS"));
+        put(&mut image, 20 * 2048, &root);
+        put(&mut image, 21 * 2048, &record(22, OBJ.len() as u32, false, b"BENCH.OBJ;1"));
+        put(&mut image, 22 * 2048, OBJ.as_bytes());
+        image
+    }
+
+    #[test]
+    fn reads_iso9660_discs() {
+        let disc = read_disc(&mut Cursor::new(iso_image())).unwrap();
+        assert_eq!(disc.format, "ISO 9660");
+        assert_eq!(disc.files.len(), 1);
+        assert_eq!(disc.files[0].path, "MODELS/BENCH.OBJ");
+        assert_eq!((disc.files[0].offset, disc.files[0].size), (22 * 2048, OBJ.len() as u64));
+    }
+
+    #[test]
+    fn reads_raw_cd_images() {
+        // Mode 2 form 1: 12 sync bytes, 4 header bytes (mode 2), 8 subheader bytes, 2048 data
+        // bytes, 280 error-correction bytes.
+        let mut raw = Vec::new();
+        for sector in iso_image().chunks(2048) {
+            raw.extend([0u8, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 0]);
+            raw.extend([0, 2, 0, 2]);
+            raw.extend([0u8; 8]);
+            raw.extend(sector);
+            raw.extend([0u8; 280]);
+        }
+        let dir = std::env::temp_dir().join(format!("raw-cd-test-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(dir.join("Game (Track 1).bin"), &raw).unwrap();
+        std::fs::write(dir.join("Game.cue"), "FILE \"Game (Track 1).bin\" BINARY\n  TRACK 01 MODE2/2352\n").unwrap();
+        let report = import(&dir.join("Game.cue"), &dir.join("assets"), Box::new(|_| {})).unwrap();
+        assert_eq!(report.format, "ISO 9660 (raw CD image)");
+        assert_eq!(std::fs::read(dir.join("extracted/Game/MODELS/BENCH.OBJ")).unwrap(), OBJ.as_bytes());
+        assert_eq!(report.models, ["imported/Game/MODELS/BENCH.glb"]);
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn rejects_files_that_are_not_discs() {
+        let mut junk = Cursor::new(vec![7u8; 0x20000]);
+        assert!(read_disc(&mut junk).is_err());
+    }
+}
