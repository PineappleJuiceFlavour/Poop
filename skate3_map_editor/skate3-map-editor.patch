+    /// A tiny Xbox disc: root holds `models/` (with `crate.glb`) and an archive with a model inside.
+    fn xdvdfs_image(base: usize) -> Vec<u8> {
+        let model = glb();
+        let mut archive = b"HEADERJUNK".to_vec();
+        archive.extend(&model);
+        archive.extend(b"TRAILER");
+        let mut image = vec![0u8; base + 0x20000];
+        let sector = |s: usize| base + s * 2048;
+        image[sector(32)..sector(32) + 20].copy_from_slice(b"MICROSOFT*XBOX*MEDIA");
+        // Entry: left, right, sector, size, attributes, name length, name (padded to 4).
+        let entry = |left: u16, right: u16, start: u32, size: u32, attr: u8, name: &str| {
+            let mut e = Vec::new();
+            e.extend(left.to_le_bytes());
+            e.extend(right.to_le_bytes());
+            e.extend(start.to_le_bytes());
+            e.extend(size.to_le_bytes());
+            e.push(attr);
+            e.push(name.len() as u8);
+            e.extend(name.as_bytes());
+            while e.len() % 4 != 0 {
+                e.push(0xFF);
+            }
+            e
+        };
+        let place = |image: &mut Vec<u8>, s: usize, bytes: &[u8]| {
+            let at = sector(s);
+            if image.len() < at + bytes.len() {
+                image.resize(at + bytes.len(), 0);
+            }
+            image[at..at + bytes.len()].copy_from_slice(bytes);
+        };
+        // Root (sector 40): "models" dir with "pack.bin" as its right child.
+        let second = entry(0, 0, 50, archive.len() as u32, 0x20, "pack.bin");
+        let first = entry(0, 0, 0, 0, 0x10, "models");
+        let first = entry(0, (first.len() / 4) as u16, 41, 2048, 0x10, "models");
+        let mut root = first.clone();
+        root.extend(&second);
+        place(&mut image, 40, &root);
+        // models/ (sector 41): crate.glb at sector 42.
+        place(&mut image, 41, &entry(0, 0, 42, model.len() as u32, 0x20, "crate.glb"));
+        place(&mut image, 42, &model);
+        place(&mut image, 50, &archive);
+        let volume = sector(32);
+        image[volume + 20..volume + 24].copy_from_slice(&40u32.to_le_bytes());
+        image[volume + 24..volume + 28].copy_from_slice(&(root.len() as u32).to_le_bytes());
+        image
+    }
+
+    #[test]
+    fn obj_becomes_a_valid_glb() {
+        let glb = glb();
+        assert!(is_glb(&glb));
+        assert_eq!(u32le(&glb, 8) as usize, glb.len());
+        let json_len = u32le(&glb, 12) as usize;
+        let json: serde_json::Value = serde_json::from_slice(&glb[20..20 + json_len]).unwrap();
+        assert_eq!(json["accessors"][0]["count"], 4);
+        assert_eq!(json["accessors"][3]["count"], 6, "quad split into two triangles");
+    }
+
+    #[test]
