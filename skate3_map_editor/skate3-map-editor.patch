+    /// A box's triangles, as a world mesh would hold them (its own vertices).
+    fn push_box(positions: &mut Vec<[f32; 3]>, indices: &mut Vec<u32>, center: Vec3, half: Vec3) {
+        let mesh: Mesh = Cuboid::from_size(half * 2.).into();
+        let base = positions.len() as u32;
+        let VertexAttributeValues::Float32x3(p) = mesh.attribute(Mesh::ATTRIBUTE_POSITION).unwrap() else { panic!() };
+        positions.extend(p.iter().map(|v| (Vec3::from_array(*v) + center).to_array()));
+        indices.extend(mesh.indices().unwrap().iter().map(|i| i as u32 + base));
+    }
