+/// A reference to another resource.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Ref {
+    Guid(u32),
+    Sha1(Sha1),
+}
+
+#[derive(Clone, Debug)]
+pub struct Dependency {
+    pub guid: Option<u32>,
+    pub sha1: Option<Sha1>,
+    pub kind: u32,
+}
+
+impl Dependency {
+    pub fn reference(&self) -> Option<Ref> {
+        self.sha1.map(Ref::Sha1).or(self.guid.map(Ref::Guid))
+    }
