+/// Everything the editor can do. The UI and hotkeys send these; your game can too
+/// (e.g. `EditorAction::Load("level2".into())` to switch levels at runtime).
+#[derive(Message, Clone, Debug)]
+pub enum EditorAction {
+    Select(Option<Entity>),
+    /// Spawn a prop directly (undoable, and it becomes the selection).
+    Spawn(PropData),
+    BeginPlace { data: PropData, from_drag: bool },
+    CancelPlace,
+    Delete,
+    Duplicate,
+    Focus,
+    DropToGround,
+    RotateSelected(f32),
+    Nudge(Vec3),
+    PushUndo,
+    Undo,
+    Redo,
+    SetTransform(Entity, Transform),
+    SetColor(Entity, [f32; 4]),
+    SetCollision(Entity, CollisionKind),
+    Rename(Entity, String),
+    Save(String),
+    Load(String),
+    NewMap,
+    /// The name the map is saved under (Ctrl+S).
+    SetMapName(String),
+    RefreshLibrary,
+    Import(PathBuf),
+    /// Eyedropper mode: the next click in the world copies a game object into the library.
+    StartPicking,
+    /// Copy this game-world entity (or the object it belongs to) into the library and start placing it.
+    PickFrom(Entity),
+    /// Add an entry to "Picked from the world" and start placing it (the game's answer to an
+    /// [`UnresolvedPick`]).
+    AddPicked(LibraryEntry),
+    /// Show a message in the status bar.
+    SetStatus(String),
+}
+
+/// The eyedropper hit something with no asset file behind it (a mesh the game built in code).
+/// Sent when [`crate::MapEditorPlugin::handles_unresolved_picks`] is on; answer with
+/// [`EditorAction::AddPicked`] or [`EditorAction::SetStatus`].
+#[derive(Message, Clone, Debug)]
+pub struct UnresolvedPick {
