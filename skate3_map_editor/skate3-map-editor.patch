+    fn mesh_body(version: u32) -> Vec<u8> {
+        let mut b = Vec::new();
+        let int = |b: &mut Vec<u8>, v: u32| b.extend(v.to_be_bytes());
+        // 4 vertices, a 4-index strip (2 triangles), 2 streams, 1 UV channel.
+        for v in [4, 4, 0, 2, 2, 1, 0] {
+            int(&mut b, v);
+        }
+        b.extend([0u8; 0x200]);
+        if version >= 0x239 {
+            int(&mut b, 0);
+            int(&mut b, 0);
+            b.extend(0f32.to_be_bytes());
+        }
+        for v in [0, 64, 128, 128] {
+            int(&mut b, v);
+        }
+        let corners = [[0.0f32, 0.0, 0.0], [100.0, 0.0, 0.0], [0.0, 100.0, 0.0], [100.0, 100.0, 0.0]];
+        for c in corners {
+            for v in c {
+                b.extend(v.to_be_bytes());
+            }
+            b.extend([0u8; 4]);
+        }
+        for _ in 0..4 {
+            // Normal +Z: x = 0, y = 0, z sign 0.
+            b.extend([0u8; 16]);
+        }
+        int(&mut b, 4 * 8);
+        for c in corners {
+            b.extend((c[0] / 100.0).to_be_bytes());
+            b.extend((c[1] / 100.0).to_be_bytes());
+        }
+        int(&mut b, 8);
+        for i in [0u16, 1, 2, 3] {
+            b.extend(i.to_be_bytes());
+        }
+        int(&mut b, 1); // primitives
+        if version > 0x22E {
+            int(&mut b, 0);
+        }
+        b.push(if version < 0x191 { 1 } else { 2 }); // GUID
+        int(&mut b, 1234);
+        // Empty references (the old second material, texture alternatives).
+        for present in [version < 0x149, version >= 0x179] {
+            if present {
+                if version > 0x22E {
+                    int(&mut b, 0);
+                }
+                b.push(0);
+            }
+        }
+        for v in [0, 3, 0, 4, 0] {
+            int(&mut b, v);
+        }
+        b
+    }
